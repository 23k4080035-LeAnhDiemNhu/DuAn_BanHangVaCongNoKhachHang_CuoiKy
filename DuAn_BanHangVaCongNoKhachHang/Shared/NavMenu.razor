@using BanHang.CoreBusiness

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Bán Hàng & Công Nợ</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Trang chủ
            </NavLink>
        </div>

        <AuthorizeView Roles="@VaiTroConstants.KeToanCongNo">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="khach-hang">
                    <span class="oi oi-people" aria-hidden="true"></span> Khách hàng
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="san-pham">
                    <span class="oi oi-box" aria-hidden="true"></span> Sản phẩm
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{VaiTroConstants.NhanVienBanHang},{VaiTroConstants.KeToanCongNo}")">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="hoa-don">
                    <span class="oi oi-document" aria-hidden="true"></span> Hóa đơn
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@VaiTroConstants.KeToanCongNo">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="thanh-toan">
                    <span class="oi oi-credit-card" aria-hidden="true"></span> Thanh toán
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="bao-cao-tuoi-no">
                    <span class="oi oi-clock" aria-hidden="true"></span> Báo cáo tuổi nợ
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
