@using BanHang.CoreBusiness

<div class="top-row px-3 navbar navbar-dark d-flex align-items-center justify-content-between">
    <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="">
        <div class="brand-badge-icon">
            <i class="bi bi-shield-check"></i>
        </div>
        <div class="d-flex flex-column">
            <span class="brand-text-main">BÁN HÀNG & CÔNG NỢ</span>
            <span class="brand-text-sub">HỆ THỐNG DOANH NGHIỆP</span>
        </div>
    </a>
    <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column nav-menu-list">
        <!-- Nhóm: Tổng quan -->
        <div class="nav-section-title px-4 pt-3 pb-1">TỔNG QUAN</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-text">Bảng điều khiển</span>
            </NavLink>
        </div>

        <!-- Nhóm: Bán hàng & Hóa đơn -->
        <div class="nav-section-title px-4 pt-3 pb-1">NGHIỆP VỤ BÁN HÀNG</div>
        <AuthorizeView Roles="@($"{VaiTroConstants.NhanVienBanHang},{VaiTroConstants.KeToanCongNo}")">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="hoa-don">
                    <i class="bi bi-file-earmark-text-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Quản lý hóa đơn</span>
                </NavLink>
            </div>
        </AuthorizeView>

        <!-- Nhóm: Kế toán & Công nợ -->
        <AuthorizeView Roles="@VaiTroConstants.KeToanCongNo">
            <div class="nav-section-title px-4 pt-3 pb-1">KẾ TOÁN CÔNG NỢ</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="thanh-toan">
                    <i class="bi bi-cash-stack nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Thu tiền (FIFO)</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="bao-cao-tuoi-no">
                    <i class="bi bi-pie-chart-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Báo cáo tuổi nợ</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="nhat-ky-email" id="nav-link-nhat-ky-email">
                    <i class="bi bi-clock-history nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Nhật ký email</span>
                </NavLink>
            </div>

            <!-- Nhóm: Danh mục quản trị -->
            <div class="nav-section-title px-4 pt-3 pb-1">QUẢN TRỊ DANH MỤC</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="khach-hang">
                    <i class="bi bi-people-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Khách hàng & Hạn mức</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="san-pham">
                    <i class="bi bi-box-seam-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Sản phẩm & Tồn kho</span>
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
