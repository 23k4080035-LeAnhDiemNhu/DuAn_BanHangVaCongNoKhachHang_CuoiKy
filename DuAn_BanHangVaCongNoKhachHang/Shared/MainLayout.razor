@inherits LayoutComponentBase
@using System.Security.Claims

<PageTitle>DuAn_BanHangVaCongNoKhachHang</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-primary">Hệ Thống Quản Lý Bán Hàng & Công Nợ</span>
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-secondary small">
                            Xin chào, <strong>@(context.User.FindFirst("HoTen")?.Value ?? context.User.Identity?.Name)</strong>
                            <span class="badge bg-primary ms-1">@(context.User.FindFirst(ClaimTypes.Role)?.Value)</span>
                        </span>
                        <a href="/logout" class="btn btn-sm btn-outline-danger">Đăng xuất</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div>
                        <a href="/login" class="btn btn-sm btn-primary">Đăng nhập</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
