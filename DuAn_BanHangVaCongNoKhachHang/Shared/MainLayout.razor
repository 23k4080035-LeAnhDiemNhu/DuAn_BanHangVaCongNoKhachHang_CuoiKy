@inherits LayoutComponentBase
@using System.Security.Claims

<PageTitle>DuAn_BanHangVaCongNoKhachHang</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row auth px-3 px-md-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold" style="color: #0F172A;">Hệ Thống Quản Lý Bán Hàng & Công Nợ</span>
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span class="small text-nowrap" style="color: #64748B;">
                            Xin chào, <strong style="color: #0F172A;">@(context.User.FindFirst("HoTen")?.Value ?? context.User.Identity?.Name)</strong>
                            <span class="badge rounded-pill ms-1 px-2 py-1" style="background-color: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE;">
                                @(context.User.FindFirst(ClaimTypes.Role)?.Value)
                            </span>
                        </span>
                        <a href="/logout" class="btn btn-sm btn-outline-danger rounded-pill px-3 text-nowrap">Đăng xuất</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div>
                        <a href="/login" class="btn btn-sm btn-primary rounded-pill px-3 text-nowrap">Đăng nhập</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-3 px-md-4">
            @Body
        </article>
    </main>
</div>
