@page "/khach-hang"
@attribute [Authorize(Roles = VaiTroConstants.KeToanCongNo)]
@using System.Globalization
@using BanHang.CoreBusiness
@using BanHang.UseCases.KhachHangScreen
@using Microsoft.Extensions.Logging
@inject IXemDanhSachKhachHangUseCase XemDanhSachKhachHangUseCase
@inject IThemKhachHangUseCase ThemKhachHangUseCase
@inject ICapNhatKhachHangUseCase CapNhatKhachHangUseCase
@inject IDoiTrangThaiKhachHangUseCase DoiTrangThaiKhachHangUseCase
@inject ILogger<KhachHangPage> Logger
@implements IDisposable

<PageTitle>Danh sách khách hàng</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 page-title">Quản lý Khách hàng & Công nợ</h3>
        <p class="text-muted small mb-0">Theo dõi thông tin khách hàng, hạn mức tín dụng và công nợ bán chịu.</p>
    </div>
    <button class="btn btn-primary rounded-pill px-3 py-2 text-nowrap fw-semibold d-inline-flex align-items-center shadow-sm" id="btn-them-khach-hang" @onclick="MoModalThemKhachHang">
        <span class="bi bi-person-plus me-1" aria-hidden="true"></span> + Thêm khách hàng
    </button>
</div>

@if (!string.IsNullOrEmpty(thongBaoThanhCong))
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <strong>Thành công!</strong> @thongBaoThanhCong
        <button type="button" class="btn-close" @onclick="() => thongBaoThanhCong = null" aria-label="Close"></button>
    </div>
}

<TrangThaiDuLieu DangTai="@isLoading"
                 ThongBaoDangTai="Đang tải dữ liệu khách hàng từ SQL Server..."
                 CoLoi="@hasError"
                 ThongBaoLoi="@errorMessage"
                 KhongCoDuLieu="@(danhSachKhachHang == null || !danhSachKhachHang.Any())"
                 ThongBaoTrong="Chưa có khách hàng nào trong hệ thống."
                 OnThuLai="TaiDanhSachKhachHangAsync">
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-page-table" style="min-width: 1050px;" id="table-khach-hang">
                <thead>
                    <tr>
                        <th scope="col" style="width: 110px;" class="text-nowrap">MÃ KH</th>
                        <th scope="col" style="min-width: 250px;">TÊN KHÁCH HÀNG</th>
                        <th scope="col" style="width: 130px;" class="text-nowrap">ĐIỆN THOẠI</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 160px;">HẠN MỨC</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 160px;">CÔNG NỢ HIỆN TẠI</th>
                        <th scope="col" class="text-center text-nowrap" style="width: 140px;">TRẠNG THÁI NỢ</th>
                        <th scope="col" class="text-center text-nowrap" style="width: 140px;">HOẠT ĐỘNG</th>
                        <th scope="col" class="text-center text-nowrap" style="width: 160px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kh in danhSachKhachHang!)
                    {
                        <tr>
                            <td class="fw-bold text-primary text-nowrap">@kh.MaKhachHang</td>
                            <td>
                                <div class="fw-semibold customer-name">@kh.TenKhachHang</div>
                                @if (!string.IsNullOrEmpty(kh.Email))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 280px;">
                                        <span class="bi bi-envelope"></span> @kh.Email
                                    </small>
                                }
                                @if (!string.IsNullOrEmpty(kh.DiaChi))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 280px;">
                                        <span class="bi bi-geo-alt"></span> @kh.DiaChi
                                    </small>
                                }
                            </td>
                            <td class="text-nowrap text-secondary">@(string.IsNullOrEmpty(kh.SoDienThoai) ? "-" : kh.SoDienThoai)</td>
                            <td class="text-end text-nowrap fw-semibold text-slate-800">@kh.HanMucCongNo.ToString("N0", viCulture) đ</td>
                            <td class="text-end text-nowrap fw-bold @(kh.SoDuCongNo > 0 ? "text-danger" : "text-success")">
                                @kh.SoDuCongNo.ToString("N0", viCulture) đ
                            </td>
                            <td class="text-center text-nowrap">
                                @if (kh.DaVuotHanMuc)
                                {
                                    <BadgeTrangThai Loai="over-limit" Text="Vượt hạn mức" />
                                }
                                else if (kh.SoDuCongNo > 0)
                                {
                                    <BadgeTrangThai Loai="has-debt" Text="Đang có nợ" />
                                }
                                else
                                {
                                    <BadgeTrangThai Loai="no-debt" Text="Không nợ" />
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                @if (kh.TrangThai)
                                {
                                    <BadgeTrangThai Loai="active" Text="Đang hoạt động" />
                                }
                                else
                                {
                                    <BadgeTrangThai Loai="locked" Text="Tạm khóa" />
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5" title="Sửa thông tin" @onclick="() => MoModalSuaKhachHang(kh)">
                                        Sửa
                                    </button>
                                    @if (kh.TrangThai)
                                    {
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-0.5" title="Tạm khóa bán hàng" @onclick="() => MoModalXacNhanDoiTrangThai(kh, false)">
                                            Khóa
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success rounded-pill px-2.5 py-0.5" title="Mở lại bán hàng" @onclick="() => MoModalXacNhanDoiTrangThai(kh, true)">
                                            Mở
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</TrangThaiDuLieu>

<!-- Modal Thêm / Sửa Khách Hàng -->
<!-- Modal Thêm / Sửa Khách Hàng -->
@if (hienThiModalForm && editContextKhachHang != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <EditForm EditContext="@editContextKhachHang" OnValidSubmit="LuuKhachHangAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header modal-header-enterprise text-white">
                        <h5 class="modal-title fw-bold fs-5">
                            @(isEditing ? "Cập Nhật Thông Tin Khách Hàng" : "Thêm Khách Hàng Mới")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="DongModalForm" disabled="@isSaving" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(formErrorMessage))
                        {
                            <div class="alert alert-danger py-2 mb-3 rounded-3" role="alert">
                                @formErrorMessage
                            </div>
                        }

                        @if (canXacNhanHaHanMuc)
                        {
                            <div class="alert alert-warning py-2 mb-3 rounded-3 border-warning" role="alert">
                                <h6 class="alert-heading fw-bold">Xác nhận giảm hạn mức công nợ:</h6>
                                <p class="mb-2 small">
                                    Hạn mức mới (<strong>@formModel.HanMucCongNo.ToString("N0", viCulture) đ</strong>) thấp hơn số dư công nợ hiện tại (<strong>@congNoHienTaiCanhBao.ToString("N0", viCulture) đ</strong>).
                                    Khách hàng sẽ bị đánh dấu <strong>Vượt hạn mức</strong> và không thể tiếp tục mua chịu cho đến khi thanh toán bớt nợ.
                                </p>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkXacNhanHaHanMuc" @bind="formModel.XacNhanHaHanMucDuoiNo" />
                                    <label class="form-check-label fw-bold text-danger" for="chkXacNhanHaHanMuc">
                                        Tôi xác nhận muốn áp dụng hạn mức thấp hơn dư nợ này.
                                    </label>
                                </div>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-slate-800 small mb-1">Mã khách hàng</label>
                                <input type="text" class="form-control rounded-3 bg-light @(CoLoi("MaKhachHang") ? "is-invalid" : "")"
                                       @bind="formModel.MaKhachHang" readonly disabled="@isEditing" maxlength="20" placeholder="Tự động tạo (VD: KH001)" />
                                <small class="text-muted d-block mt-1">Mã được cấp tự động bởi hệ thống</small>
                                <ValidationMessage For="@(() => formModel.MaKhachHang)" class="text-danger small mt-1 d-block" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-semibold text-slate-800 small mb-1">Tên khách hàng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control rounded-3 @(CoLoi("TenKhachHang") ? "is-invalid" : "")"
                                       @bind="formModel.TenKhachHang" @bind:after="() => OnKhachHangFieldChanged(nameof(formModel.TenKhachHang))" maxlength="150" placeholder="VD: Công ty TNHH Ánh Dương" />
                                <ValidationMessage For="@(() => formModel.TenKhachHang)" class="text-danger small mt-1 d-block" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-800 small mb-1">Số điện thoại</label>
                                <input type="text" class="form-control rounded-3 @(CoLoi("SoDienThoai") ? "is-invalid" : "")"
                                       @bind="formModel.SoDienThoai" @bind:after="() => OnKhachHangFieldChanged(nameof(formModel.SoDienThoai))" maxlength="20" placeholder="VD: 0901234567" />
                                <ValidationMessage For="@(() => formModel.SoDienThoai)" class="text-danger small mt-1 d-block" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-800 small mb-1">Email</label>
                                <input type="email" class="form-control rounded-3 @(CoLoi("Email") ? "is-invalid" : "")"
                                       @bind="formModel.Email" @bind:after="() => OnKhachHangFieldChanged(nameof(formModel.Email))" maxlength="100" placeholder="VD: contact@anhduong.vn" />
                                <ValidationMessage For="@(() => formModel.Email)" class="text-danger small mt-1 d-block" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-slate-800 small mb-1">Địa chỉ</label>
                                <textarea class="form-control rounded-3 @(CoLoi("DiaChi") ? "is-invalid" : "")"
                                          @bind="formModel.DiaChi" @bind:after="() => OnKhachHangFieldChanged(nameof(formModel.DiaChi))" rows="2" maxlength="250" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành"></textarea>
                                <ValidationMessage For="@(() => formModel.DiaChi)" class="text-danger small mt-1 d-block" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-800 small mb-1">Hạn mức công nợ (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" step="1000" min="0" class="form-control rounded-3 @(CoLoi("HanMucCongNo") ? "is-invalid" : "")"
                                       @bind="formModel.HanMucCongNo" @bind:after="() => OnKhachHangFieldChanged(nameof(formModel.HanMucCongNo))" />
                                <ValidationMessage For="@(() => formModel.HanMucCongNo)" class="text-danger small mt-1 d-block" />
                                <small class="text-muted d-block mt-1">Nhập 0 nếu không cho phép bán chịu.</small>
                            </div>
                            <div class="col-md-6 d-flex align-items-center mt-4">
                                <div class="form-check form-switch fs-6">
                                    <input class="form-check-input" type="checkbox" id="chkTrangThai" @bind="formModel.TrangThai" />
                                    <label class="form-check-label fw-semibold" for="chkTrangThai">
                                        @(formModel.TrangThai ? "Đang hoạt động (Cho phép bán chịu)" : "Tạm khóa (Chặn bán chịu)")
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light px-4 py-3 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 fw-semibold" @onclick="DongModalForm" disabled="@isSaving">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-1.5 fw-semibold shadow-sm" id="btn-luu-khach-hang" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>@(isEditing ? "Lưu thay đổi" : "Thêm mới")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal Xác Nhận Tạm Khóa / Mở Lại -->
<ModalXacNhan HienThi="@(hienThiModalXacNhanTrangThai && khachHangDoiTrangThai != null)"
              TieuDe="@(trangThaiMoiDuKien ? "Xác nhận mở lại khách hàng" : "Xác nhận tạm khóa khách hàng")"
              HeaderClass="@(trangThaiMoiDuKien ? "modal-header-success" : "modal-header-warning")"
              KieuNutXacNhan="@(trangThaiMoiDuKien ? "btn-success" : "btn-warning text-dark")"
              NutXacNhanId="btn-xac-nhan-doi-trang-thai"
              TextXacNhan="@(trangThaiMoiDuKien ? "Xác nhận mở lại" : "Xác nhận tạm khóa")"
              TextHuy="Đóng"
              DangXuLy="@isSaving"
              OnXacNhan="XacNhanDoiTrangThaiAsync"
              OnHuy="() => hienThiModalXacNhanTrangThai = false">
    @if (khachHangDoiTrangThai != null)
    {
        @if (trangThaiMoiDuKien)
        {
            <p class="mb-0 text-slate-800">
                Bạn có chắc chắn muốn mở lại khách hàng <strong>@khachHangDoiTrangThai.TenKhachHang</strong> (Mã: @khachHangDoiTrangThai.MaKhachHang)?
                Khách hàng sẽ được phép tạo hóa đơn bán chịu tiếp trong hạn mức.
            </p>
        }
        else
        {
            <p class="mb-0 text-slate-800">
                Bạn có chắc chắn muốn tạm khóa khách hàng <strong>@khachHangDoiTrangThai.TenKhachHang</strong> (Mã: @khachHangDoiTrangThai.MaKhachHang)?
                Hệ thống sẽ <strong>chặn tạo hóa đơn bán chịu mới</strong> cho khách hàng này (khách vẫn được nộp tiền trả nợ).
            </p>
        }
    }
</ModalXacNhan>

@code {
    private IEnumerable<KhachHang>? danhSachKhachHang;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private string? thongBaoThanhCong;
    private readonly CultureInfo viCulture = new CultureInfo("vi-VN");

    // State cho Modal Form Thêm / Sửa
    private bool hienThiModalForm = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private string? formErrorMessage;
    private Dictionary<string, string> loiTheoTruong = new();
    private bool canXacNhanHaHanMuc = false;
    private decimal congNoHienTaiCanhBao = 0;

    private FormKhachHangModel formModel = new();
    private EditContext? editContextKhachHang;
    private ValidationMessageStore? messageStoreKhachHang;

    // State cho Modal Đổi Trạng Thái
    private bool hienThiModalXacNhanTrangThai = false;
    private KhachHang? khachHangDoiTrangThai;
    private bool trangThaiMoiDuKien;

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSachKhachHangAsync();
    }

    private void KhoiTaoEditContextKhachHang()
    {
        if (editContextKhachHang != null)
        {
            editContextKhachHang.OnFieldChanged -= HandleKhachHangFieldChanged;
        }
        editContextKhachHang = new EditContext(formModel);
        messageStoreKhachHang = new ValidationMessageStore(editContextKhachHang);
        editContextKhachHang.OnFieldChanged += HandleKhachHangFieldChanged;
    }

    private void HandleKhachHangFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        messageStoreKhachHang?.Clear(args.FieldIdentifier);
        loiTheoTruong.Remove(args.FieldIdentifier.FieldName);
        if (args.FieldIdentifier.FieldName == nameof(FormKhachHangModel.TenKhachHang))
        {
            formErrorMessage = null;
        }
        editContextKhachHang?.NotifyValidationStateChanged();
    }

    private void OnKhachHangFieldChanged(string propertyName)
    {
        editContextKhachHang?.NotifyFieldChanged(new FieldIdentifier(formModel, propertyName));
    }

    public void Dispose()
    {
        if (editContextKhachHang != null)
        {
            editContextKhachHang.OnFieldChanged -= HandleKhachHangFieldChanged;
        }
    }

    private async Task TaiDanhSachKhachHangAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            danhSachKhachHang = await XemDanhSachKhachHangUseCase.ExecuteAsync();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "Không thể tải danh sách khách hàng. Vui lòng kiểm tra kết nối hệ thống hoặc thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra khi gọi XemDanhSachKhachHangUseCase.ExecuteAsync()");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task MoModalThemKhachHang()
    {
        isEditing = false;
        string maKhMoi = string.Empty;
        try
        {
            maKhMoi = await ThemKhachHangUseCase.LayMaKhachHangTiepTheoAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Không lấy được mã khách hàng tiếp theo");
        }

        formModel = new FormKhachHangModel
        {
            MaKhachHang = maKhMoi,
            TrangThai = true,
            HanMucCongNo = 0
        };
        KhoiTaoEditContextKhachHang();
        loiTheoTruong.Clear();
        formErrorMessage = null;
        canXacNhanHaHanMuc = false;
        hienThiModalForm = true;
    }

    private void MoModalSuaKhachHang(KhachHang kh)
    {
        isEditing = true;
        formModel = new FormKhachHangModel
        {
            KhachHangId = kh.KhachHangId,
            MaKhachHang = kh.MaKhachHang,
            TenKhachHang = kh.TenKhachHang,
            SoDienThoai = kh.SoDienThoai,
            Email = kh.Email,
            DiaChi = kh.DiaChi,
            HanMucCongNo = kh.HanMucCongNo,
            TrangThai = kh.TrangThai,
            XacNhanHaHanMucDuoiNo = false
        };
        KhoiTaoEditContextKhachHang();
        loiTheoTruong.Clear();
        formErrorMessage = null;
        canXacNhanHaHanMuc = false;
        congNoHienTaiCanhBao = kh.SoDuCongNo;
        hienThiModalForm = true;
    }

    private void DongModalForm()
    {
        hienThiModalForm = false;
        messageStoreKhachHang?.Clear();
        loiTheoTruong.Clear();
        formErrorMessage = null;
        canXacNhanHaHanMuc = false;
    }

    private async Task LuuKhachHangAsync()
    {
        isSaving = true;
        formErrorMessage = null;
        loiTheoTruong.Clear();
        messageStoreKhachHang?.Clear();

        try
        {
            if (!isEditing)
            {
                var req = new TaoKhachHangRequest
                {
                    MaKhachHang = formModel.MaKhachHang,
                    TenKhachHang = formModel.TenKhachHang,
                    SoDienThoai = formModel.SoDienThoai,
                    Email = formModel.Email,
                    DiaChi = formModel.DiaChi,
                    HanMucCongNo = formModel.HanMucCongNo,
                    TrangThai = formModel.TrangThai
                };

                var res = await ThemKhachHangUseCase.ExecuteAsync(req);
                if (res.ThanhCong)
                {
                    thongBaoThanhCong = res.ThongBao;
                    DongModalForm();
                    await TaiDanhSachKhachHangAsync();
                }
                else
                {
                    formErrorMessage = res.ThongBao;
                    loiTheoTruong = res.LoiTheoTruong;
                    if (res.LoiTheoTruong != null && res.LoiTheoTruong.Any())
                    {
                        foreach (var kvp in res.LoiTheoTruong)
                        {
                            messageStoreKhachHang?.Add(new FieldIdentifier(formModel, kvp.Key), kvp.Value);
                        }
                        editContextKhachHang?.NotifyValidationStateChanged();
                    }
                }
            }
            else
            {
                var req = new CapNhatKhachHangRequest
                {
                    KhachHangId = formModel.KhachHangId,
                    MaKhachHang = formModel.MaKhachHang,
                    TenKhachHang = formModel.TenKhachHang,
                    SoDienThoai = formModel.SoDienThoai,
                    Email = formModel.Email,
                    DiaChi = formModel.DiaChi,
                    HanMucCongNo = formModel.HanMucCongNo,
                    TrangThai = formModel.TrangThai,
                    XacNhanHaHanMucDuoiNo = formModel.XacNhanHaHanMucDuoiNo
                };

                var res = await CapNhatKhachHangUseCase.ExecuteAsync(req);
                if (res.ThanhCong)
                {
                    thongBaoThanhCong = res.ThongBao;
                    DongModalForm();
                    await TaiDanhSachKhachHangAsync();
                }
                else
                {
                    formErrorMessage = res.ThongBao;
                    loiTheoTruong = res.LoiTheoTruong;
                    if (res.LoiTheoTruong != null && res.LoiTheoTruong.Any())
                    {
                        foreach (var kvp in res.LoiTheoTruong)
                        {
                            messageStoreKhachHang?.Add(new FieldIdentifier(formModel, kvp.Key), kvp.Value);
                        }
                        editContextKhachHang?.NotifyValidationStateChanged();
                    }
                    if (res.CanXacNhanHaHanMuc)
                    {
                        canXacNhanHaHanMuc = true;
                        congNoHienTaiCanhBao = res.CongNoHienTai;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi xảy ra khi lưu khách hàng");
            formErrorMessage = "Đã xảy ra lỗi trong quá trình lưu dữ liệu. Vui lòng thử lại sau.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void MoModalXacNhanDoiTrangThai(KhachHang kh, bool trangThaiMoi)
    {
        khachHangDoiTrangThai = kh;
        trangThaiMoiDuKien = trangThaiMoi;
        hienThiModalXacNhanTrangThai = true;
    }

    private async Task XacNhanDoiTrangThaiAsync()
    {
        if (khachHangDoiTrangThai == null) return;

        isSaving = true;
        try
        {
            var res = await DoiTrangThaiKhachHangUseCase.ExecuteAsync(khachHangDoiTrangThai.KhachHangId, trangThaiMoiDuKien);
            if (res.ThanhCong)
            {
                thongBaoThanhCong = res.ThongBao;
                hienThiModalXacNhanTrangThai = false;
                await TaiDanhSachKhachHangAsync();
            }
            else
            {
                errorMessage = res.ThongBao;
                hasError = true;
                hienThiModalXacNhanTrangThai = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi đổi trạng thái khách hàng ID {KhachHangId}", khachHangDoiTrangThai.KhachHangId);
            errorMessage = "Đã xảy ra lỗi khi thay đổi trạng thái khách hàng.";
            hasError = true;
            hienThiModalXacNhanTrangThai = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool CoLoi(string field)
    {
        if (editContextKhachHang == null) return false;
        return editContextKhachHang.GetValidationMessages(new FieldIdentifier(formModel, field)).Any();
    }

    public class FormKhachHangModel
    {
        public int KhachHangId { get; set; }
        public string MaKhachHang { get; set; } = string.Empty;

        [Required(ErrorMessage = "Tên khách hàng là bắt buộc.")]
        [StringLength(150, ErrorMessage = "Tên khách hàng tối đa 150 ký tự.")]
        public string TenKhachHang { get; set; } = string.Empty;

        [StringLength(20, ErrorMessage = "Số điện thoại tối đa 20 ký tự.")]
        public string? SoDienThoai { get; set; }

        [EmailAddress(ErrorMessage = "Email không đúng định dạng.")]
        [StringLength(100, ErrorMessage = "Email tối đa 100 ký tự.")]
        public string? Email { get; set; }

        [StringLength(250, ErrorMessage = "Địa chỉ tối đa 250 ký tự.")]
        public string? DiaChi { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Hạn mức công nợ không được âm.")]
        public decimal HanMucCongNo { get; set; } = 0;

        public bool TrangThai { get; set; } = true;
        public bool XacNhanHaHanMucDuoiNo { get; set; } = false;
    }
