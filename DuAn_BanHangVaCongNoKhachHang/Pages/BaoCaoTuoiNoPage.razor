@page "/bao-cao-tuoi-no"
@attribute [Authorize(Roles = VaiTroConstants.KeToanCongNo)]
@using System.Globalization
@using BanHang.CoreBusiness
@using BanHang.UseCases.BaoCaoTuoiNoScreen
@using BanHang.UseCases.EmailNhacNoScreen
@using BanHang.UseCases.PluginInterfaces.AI
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Logging
@inject IConfiguration Configuration
@inject IXemBaoCaoTuoiNoUseCase XemBaoCaoTuoiNoUseCase
@inject IXuatBaoCaoTuoiNoExcelUseCase XuatBaoCaoTuoiNoExcelUseCase
@inject IXemDuLieuNhacNoKhachHangUseCase XemDuLieuNhacNoUseCase
@inject ISoanEmailNhacNoUseCase SoanEmailNhacNoUseCase
@inject IPheDuyetEmailNhacNoUseCase PheDuyetEmailNhacNoUseCase
@inject IGuiEmailNhacNoUseCase GuiEmailNhacNoUseCase
@inject IJSRuntime JSRuntime
@inject ILogger<BaoCaoTuoiNoPage> Logger

<PageTitle>Báo cáo tuổi nợ khách hàng</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1 text-primary fw-bold">Báo Cáo Phân Tích Tuổi Nợ Khách Hàng</h3>
        <p class="text-muted mb-0 small">Theo dõi công nợ theo 4 nhóm thời hạn: 0–30, 31–60, 61–90 và trên 90 ngày. Hỗ trợ AI soạn email nhắc nợ có kế toán duyệt.</p>
    </div>
</div>

<!-- Bộ lọc chọn ngày chốt báo cáo -->
<div class="card mb-3 shadow-sm border-0 bg-light">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <label for="input-ngay-bao-cao" class="col-form-label fw-semibold text-nowrap mb-0">Ngày chốt báo cáo:</label>
                <input type="date" id="input-ngay-bao-cao" class="form-control" style="width: auto;" @bind="ngayBaoCaoInput" />
                <button class="btn btn-primary text-nowrap rounded-pill px-3 shadow-sm" id="btn-xem-bao-cao" @onclick="TaiBaoCaoAsync" disabled="@(isLoading || isExporting)">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Đang tính toán...</span>
                    }
                    else
                    {
                        <span class="bi bi-search me-1"></span>
                        <span>Xem báo cáo</span>
                    }
                </button>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="badge bg-secondary p-2 fs-6 text-wrap rounded-pill px-3">
                    Số liệu áp dụng ngày: <strong id="lbl-ngay-ap-dung">@ngayBaoCaoApDung.ToString("dd/MM/yyyy")</strong>
                </span>
                <button class="btn btn-success text-nowrap fw-semibold shadow-sm rounded-pill px-3" id="btn-xuat-excel" @onclick="XuatExcelAsync" disabled="@(isExporting || isLoading)">
                    @if (isExporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Đang xuất Excel...</span>
                    }
                    else
                    {
                        <span class="bi bi-file-earmark-excel me-1"></span>
                        <span>Xuất Excel</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Chú thích quy ước nghiệp vụ đề 18 -->
<div class="alert alert-secondary py-2 px-3 small mb-3 shadow-sm border-0" role="alert">
    <ul class="mb-0 ps-3">
        <li><strong>Quy ước nhóm:</strong> Nhóm 0–30 bao gồm khoản chưa đến hạn và khoản quá hạn tối đa 30 ngày tính đến ngày chốt báo cáo.</li>
        <li><strong>Phạm vi thời gian:</strong> Báo cáo phản ánh các hóa đơn và phân bổ thanh toán đã ghi nhận đến hết ngày báo cáo (chưa tái dựng lại FIFO cho phiếu thu nhập lùi ngày).</li>
        <li><strong>Soạn email nhắc nợ:</strong> Kế toán công nợ bấm nút "Soạn email nhắc nợ" để AI tạo bản nháp cá nhân hóa; kế toán duyệt và chỉnh sửa trước khi gửi.</li>
    </ul>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border text-primary me-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span>Đang tính toán phân tích tuổi nợ từ SQL Server...</span>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading">Đã xảy ra lỗi!</h5>
        <p class="mb-0">@errorMessage</p>
    </div>
}
else if (baoCaoResult == null || !baoCaoResult.DanhSach.Any())
{
    <div class="alert alert-info" role="alert">
        Không có dữ liệu khách hàng nào tại ngày báo cáo đã chọn.
    </div>
}
else
{
    @if (baoCaoResult.TienThuChuaPhanBo > 0)
    {
        <div class="alert alert-warning py-2 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2 shadow-sm border-0" role="alert">
            <div>
                <strong>Tiền thu chưa phân bổ:</strong>
                Tổng số tiền phiếu thu còn dư chưa cấn trừ tính đến ngày @ngayBaoCaoApDung.ToString("dd/MM/yyyy") là:
                <strong class="text-danger text-nowrap">@baoCaoResult.TienThuChuaPhanBo.ToString("N0", cultureVi) đ</strong>
            </div>
            <span class="badge bg-light text-dark border text-nowrap rounded-pill px-3">Lưu riêng trên phiếu thu, không tự trừ vào dư nợ hóa đơn</span>
        </div>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-hover align-middle mb-0" id="table-tuoi-no" style="min-width: 1250px;">
            <thead class="table-dark text-center">
                <tr>
                    <th scope="col" style="width: 45px;" class="text-nowrap">STT</th>
                    <th scope="col" style="width: 90px;" class="text-nowrap">Mã KH</th>
                    <th scope="col" style="min-width: 220px;" class="text-start">Tên khách hàng</th>
                    <th scope="col" class="text-end text-nowrap" style="width: 120px;">Hạn mức</th>
                    <th scope="col" class="text-end text-info text-nowrap" style="width: 120px;">0–30 ngày</th>
                    <th scope="col" class="text-end text-warning text-nowrap" style="width: 120px;">31–60 ngày</th>
                    <th scope="col" class="text-end text-danger text-nowrap" style="width: 120px;">61–90 ngày</th>
                    <th scope="col" class="text-end text-danger text-nowrap" style="width: 120px;">Trên 90 ngày</th>
                    <th scope="col" class="text-end text-nowrap" style="width: 130px;">Tổng công nợ</th>
                    <th scope="col" class="text-center text-nowrap" style="width: 160px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                }
                @foreach (var item in baoCaoResult.DanhSach)
                {
                    <tr>
                        <td class="text-center text-nowrap">@(stt++)</td>
                        <td class="fw-semibold text-nowrap">@item.MaKhachHang</td>
                        <td>
                            <div class="fw-semibold">@item.TenKhachHang</div>
                            @if (!string.IsNullOrEmpty(item.SoDienThoai))
                            {
                                <small class="text-muted text-nowrap">SĐT: @item.SoDienThoai</small>
                            }
                        </td>
                        <td class="text-end text-muted text-nowrap">@item.HanMucCongNo.ToString("N0", cultureVi) đ</td>
                        <td class="text-end text-nowrap @(item.TuoiNo_0_30 > 0 ? "fw-semibold text-info" : "text-muted")">
                            @item.TuoiNo_0_30.ToString("N0", cultureVi) đ
                        </td>
                        <td class="text-end text-nowrap @(item.TuoiNo_31_60 > 0 ? "fw-semibold text-warning" : "text-muted")">
                            @item.TuoiNo_31_60.ToString("N0", cultureVi) đ
                        </td>
                        <td class="text-end text-nowrap @(item.TuoiNo_61_90 > 0 ? "fw-semibold text-danger" : "text-muted")">
                            @item.TuoiNo_61_90.ToString("N0", cultureVi) đ
                        </td>
                        <td class="text-end text-nowrap @(item.TuoiNo_Tren_90 > 0 ? "fw-bold text-danger" : "text-muted")">
                            @item.TuoiNo_Tren_90.ToString("N0", cultureVi) đ
                        </td>
                        <td class="text-end fw-bold text-nowrap @(item.TongCongNo > 0 ? "text-dark" : "text-muted")">
                            @item.TongCongNo.ToString("N0", cultureVi) đ
                        </td>
                        <td class="text-center text-nowrap">
                            @if (item.TongCongNo > 0)
                            {
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm"
                                        id="@($"btn-soan-email-{item.KhachHangId}")"
                                        @onclick="() => MoModalSoanEmailAsync(item.KhachHangId)"
                                        title="Soạn email nhắc nợ hỗ trợ bởi AI và duyệt trước khi gửi">
                                    <i class="bi bi-envelope-fill me-1"></i>Soạn email
                                </button>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border rounded-pill px-2">Hết nợ</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light border-top border-2 fw-bold text-end text-nowrap">
                <tr>
                    <td colspan="4" class="text-center text-uppercase text-nowrap">Tổng cộng</td>
                    <td class="text-info text-nowrap">@baoCaoResult.Tong_TuoiNo_0_30.ToString("N0", cultureVi) đ</td>
                    <td class="text-warning text-nowrap">@baoCaoResult.Tong_TuoiNo_31_60.ToString("N0", cultureVi) đ</td>
                    <td class="text-danger text-nowrap">@baoCaoResult.Tong_TuoiNo_61_90.ToString("N0", cultureVi) đ</td>
                    <td class="text-danger text-nowrap">@baoCaoResult.Tong_TuoiNo_Tren_90.ToString("N0", cultureVi) đ</td>
                    <td class="fs-6 text-primary text-nowrap">@baoCaoResult.Tong_CongNo.ToString("N0", cultureVi) đ</td>
                    <td class="text-center text-muted text-nowrap">-</td>
                </tr>
            </tfoot>
        </table>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL DUYỆT VÀ SOẠN EMAIL NHẮC NỢ (RESPONSIVE CHO DESKTOP & MOBILE 390x844px) -->
<!-- ========================================================================= -->
@if (hienThiModalSoanEmail)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered" style="max-height: 92vh;">
            <div class="modal-content shadow border-0 rounded-4">
                <div class="modal-header bg-primary text-white py-3 px-4 rounded-top-4">
                    <h5 class="modal-title fw-bold d-flex align-items-center flex-wrap gap-2">
                        <span><i class="bi bi-envelope-check me-2"></i>Duyệt và Soạn Email Nhắc Nợ</span>
                        @if (LaCheDoGuiThat)
                        {
                            <span class="badge bg-danger text-white border border-light fs-6 rounded-pill px-3 py-1 shadow-sm">
                                <i class="bi bi-send-check me-1"></i>Chế độ: Gửi thật (SMTP)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark border fs-6 rounded-pill px-3 py-1">
                                <i class="bi bi-cpu me-1"></i>Chế độ: Mô phỏng (Sandbox Dev)
                            </span>
                        }
                        <span class="badge bg-info-subtle text-dark border fs-6 rounded-pill px-3 py-1">
                            <i class="bi bi-pencil-square me-1"></i>Nguồn: @nguonSoanHienTai
                        </span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="DongModalSoanEmail" disabled="@(dangGuiEmail || dangGoiAiSoan)"></button>
                </div>
                <div class="modal-body p-3 p-md-4" style="overflow-y: auto; max-height: calc(90vh - 140px);">
                    @if (LaCheDoGuiThat && !string.IsNullOrWhiteSpace(EmailRedirect))
                    {
                        <div class="alert alert-warning py-2 mb-3 rounded-3 small shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i>
                            <strong>Lưu ý cấu hình thử nghiệm:</strong> Thư gửi thật sẽ được chuyển hướng an toàn tới địa chỉ test: <strong>@EmailRedirect</strong>. Địa chỉ khách hàng (@emailNguoiNhanInput) sẽ được lưu trong nhật ký audit.
                        </div>
                    }
                    @if (dangTaiDuLieuSoan)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 text-muted">Đang tải dữ liệu công nợ xác thực từ máy chủ...</p>
                        </div>
                    }
                    else if (duLieuSoanHienTai != null)
                    {
                        @if (!string.IsNullOrEmpty(thongBaoLoiModal))
                        {
                            <div class="alert alert-danger py-2 mb-3 rounded-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> @thongBaoLoiModal
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(thongBaoThanhCongModal))
                        {
                            <div class="alert alert-success py-2 mb-3 rounded-3" role="alert">
                                <i class="bi bi-check-circle-fill me-1"></i> @thongBaoThanhCongModal
                            </div>
                        }

                        <!-- 1. THÔNG TIN KHÁCH HÀNG & EMAIL NHẬN -->
                        <div class="card bg-light border-0 rounded-3 mb-3 p-3">
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-md-6">
                                    <label class="form-label text-muted small mb-0">Khách hàng:</label>
                                    <div class="fw-bold fs-6 text-dark">
                                        @duLieuSoanHienTai.TenKhachHang
                                        <span class="badge bg-secondary ms-1">@duLieuSoanHienTai.MaKhachHang</span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label text-muted small mb-0">Ngày chốt báo cáo áp dụng:</label>
                                    <div class="fw-bold text-primary">
                                        <i class="bi bi-calendar3 me-1"></i>@ngayBaoCaoApDung.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label for="input-email-nguoi-nhan" class="form-label fw-semibold mb-1">
                                        Địa chỉ email nhận thư: <span class="text-danger">*</span>
                                    </label>
                                    <input type="email"
                                           id="input-email-nguoi-nhan"
                                           class="form-control @(duLieuSoanHienTai.EmailHopLe ? "is-valid" : "is-invalid") rounded-3"
                                           @bind="emailNguoiNhanInput"
                                           @bind:after="CapNhatEmailNguoiNhan"
                                           placeholder="nhap.email@khachhang.com"
                                           disabled="@(dangGuiEmail || dangGoiAiSoan)" />
                                    @if (!duLieuSoanHienTai.EmailHopLe)
                                    {
                                        <div class="invalid-feedback d-block mt-1">
                                            <i class="bi bi-exclamation-circle me-1"></i>
                                            Địa chỉ email đang trống hoặc không đúng định dạng. Kế toán vẫn có thể soạn nháp nhưng không thể gửi cho đến khi nhập email hợp lệ.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 2. THỐNG KÊ CÔNG NỢ & TIỀN CHƯA PHÂN BỔ -->
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-3">
                                <div class="p-2 border rounded-3 bg-white text-center">
                                    <div class="text-muted small">0–30 ngày</div>
                                    <div class="fw-bold text-info">@duLieuSoanHienTai.TuoiNo_0_30.ToString("N0", cultureVi) đ</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 border rounded-3 bg-white text-center">
                                    <div class="text-muted small">31–60 ngày</div>
                                    <div class="fw-bold text-warning">@duLieuSoanHienTai.TuoiNo_31_60.ToString("N0", cultureVi) đ</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 border rounded-3 bg-white text-center">
                                    <div class="text-muted small">61–90 ngày</div>
                                    <div class="fw-bold text-danger">@duLieuSoanHienTai.TuoiNo_61_90.ToString("N0", cultureVi) đ</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2 border rounded-3 bg-white text-center">
                                    <div class="text-muted small">Trên 90 ngày</div>
                                    <div class="fw-bold text-danger">@duLieuSoanHienTai.TuoiNo_Tren_90.ToString("N0", cultureVi) đ</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="p-2 border rounded-3 bg-light d-flex justify-content-between align-items-center flex-wrap">
                                    <span class="fw-semibold">Tổng công nợ tính đến ngày chốt:</span>
                                    <span class="fs-5 fw-bold text-danger">@duLieuSoanHienTai.TongCongNo.ToString("N0", cultureVi) đ</span>
                                </div>
                            </div>
                        </div>

                        @if (duLieuSoanHienTai.TienThuChuaPhanBo > 0)
                        {
                            <div class="alert alert-warning py-2 mb-3 rounded-3" role="alert">
                                <strong><i class="bi bi-shield-exclamation me-1"></i>Cảnh báo đối soát:</strong>
                                Khách hàng có khoản tiền thu chưa phân bổ là <strong>@duLieuSoanHienTai.TienThuChuaPhanBo.ToString("N0", cultureVi) đ</strong>.
                                Khoản này <em>không</em> tự động khấu trừ vào dư nợ trên. Kế toán cần rà soát kỹ lưỡng trước khi gửi nhắc nợ.
                            </div>
                        }

                        <!-- 3. DANH SÁCH HÓA ĐƠN LIÊN QUAN -->
                        @if (duLieuSoanHienTai.DanhSachHoaDon.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-muted mb-1">
                                    Hóa đơn có dư nợ tính đến ngày @ngayBaoCaoApDung.ToString("dd/MM/yyyy"):
                                </label>
                                <div class="table-responsive border rounded-3" style="max-height: 150px; overflow-y: auto;">
                                    <table class="table table-sm table-striped align-middle mb-0 small">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Số HĐ</th>
                                                <th>Ngày lập</th>
                                                <th>Hạn TT</th>
                                                <th class="text-end">Dư nợ</th>
                                                <th class="text-center">Tình trạng</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var hd in duLieuSoanHienTai.DanhSachHoaDon)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">@hd.MaHoaDon</td>
                                                    <td>@hd.NgayLap.ToString("dd/MM/yyyy")</td>
                                                    <td>@hd.HanThanhToan.ToString("dd/MM/yyyy")</td>
                                                    <td class="text-end fw-bold">@hd.DuNoTaiNgayChot.ToString("N0", cultureVi) đ</td>
                                                    <td class="text-center">
                                                        @if (hd.SoNgayQuaHan > 0)
                                                        {
                                                            <span class="badge bg-danger">Quá hạn @hd.SoNgayQuaHan ngày</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success">Chưa đến hạn</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        <!-- 4. CHỌN GIỌNG VĂN, YÊU CẦU CHỈNH CÁCH VIẾT & NÚT TẠO BẢN NHÁP / DÙNG MẪU -->
                        <div class="card border rounded-3 p-3 mb-3 bg-white">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <label class="form-label fw-bold mb-0">
                                    <i class="bi bi-robot text-primary me-1"></i>Trợ lý AI - Soạn thảo email:
                                </label>
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm"
                                            id="btn-dung-mau-co-san"
                                            type="button"
                                            @onclick="DungMauCoSanAsync"
                                            disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        <i class="bi bi-file-earmark-text me-1"></i>Dùng mẫu có sẵn
                                    </button>
                                    <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm"
                                            id="btn-tao-nhap-ai"
                                            type="button"
                                            @onclick="TaoBanNhapAiAsync"
                                            disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        @if (dangGoiAiSoan)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            <span>AI đang soạn...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-magic me-1"></i>
                                            <span>@(string.IsNullOrWhiteSpace(noiDungEmail) ? "AI tạo bản nháp" : "AI soạn lại")</span>
                                        }
                                    </button>
                                </div>
                            </div>

                            <div class="d-flex align-items-center flex-wrap gap-3 mb-2">
                                <span class="small text-muted fw-semibold">Giọng văn:</span>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="giongVanRadio" id="gvNheNhang"
                                           value="@GiongVanEmail.NheNhang"
                                           checked="@(giongVanChon == GiongVanEmail.NheNhang)"
                                           @onchange="() => DoiGiongVan(GiongVanEmail.NheNhang)"
                                           disabled="@(dangGoiAiSoan || dangGuiEmail)" />
                                    <label class="form-check-label small" for="gvNheNhang">Nhẹ nhàng</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="giongVanRadio" id="gvTieuChuan"
                                           value="@GiongVanEmail.TieuChuan"
                                           checked="@(giongVanChon == GiongVanEmail.TieuChuan)"
                                           @onchange="() => DoiGiongVan(GiongVanEmail.TieuChuan)"
                                           disabled="@(dangGoiAiSoan || dangGuiEmail)" />
                                    <label class="form-check-label small" for="gvTieuChuan">Tiêu chuẩn</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="giongVanRadio" id="gvKhanTruong"
                                           value="@GiongVanEmail.KhanTruong"
                                           checked="@(giongVanChon == GiongVanEmail.KhanTruong)"
                                           @onchange="() => DoiGiongVan(GiongVanEmail.KhanTruong)"
                                           disabled="@(dangGoiAiSoan || dangGuiEmail)" />
                                    <label class="form-check-label small" for="gvKhanTruong">Khẩn trương</label>
                                </div>
                            </div>

                            <!-- Ô Yêu cầu chỉnh cách viết -->
                            <div class="mb-2">
                                <label for="input-yeu-cau-chinh-cach-viet" class="form-label small fw-semibold text-muted mb-1">
                                    Yêu cầu chỉnh cách viết (tùy chọn):
                                </label>
                                <input type="text"
                                       id="input-yeu-cau-chinh-cach-viet"
                                       class="form-control form-control-sm rounded-3"
                                       placeholder="Ví dụ: ngắn hơn, lịch sự hơn, nhấn mạnh khoản quá hạn..."
                                       @bind="yeuCauChinhCachViet"
                                       disabled="@(dangGoiAiSoan || dangGuiEmail)" />
                                <div class="d-flex gap-1 mt-1 flex-wrap">
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.75rem;"
                                            @onclick='() => yeuCauChinhCachViet = "ngắn hơn"' disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        + Ngắn hơn
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.75rem;"
                                            @onclick='() => yeuCauChinhCachViet = "lịch sự hơn"' disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        + Lịch sự hơn
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.75rem;"
                                            @onclick='() => yeuCauChinhCachViet = "nhấn mạnh khoản quá hạn"' disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        + Nhấn mạnh khoản quá hạn
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(thongBaoAi))
                            {
                                <div class="small text-primary mt-1">
                                    <i class="bi bi-info-circle me-1"></i>@thongBaoAi
                                </div>
                            }
                        </div>

                        <!-- 5. Ô TIÊU ĐỀ VÀ NỘI DUNG CHO KẾ TOÁN CHỈNH SỬA VÀ DUYỆT -->
                        <div class="mb-3">
                            <label for="input-tieu-de-email" class="form-label fw-semibold mb-1">
                                Tiêu đề email: <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="input-tieu-de-email"
                                   class="form-control rounded-3"
                                   @bind="tieuDeEmail"
                                   @bind:after="XoaBanDuyetCu"
                                   placeholder="Tiêu đề email nhắc nợ..."
                                   disabled="@(dangGuiEmail || dangGoiAiSoan)" />
                        </div>

                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="textarea-noi-dung-email" class="form-label fw-semibold mb-0">
                                    Nội dung email (Kế toán kiểm tra, chỉnh sửa và duyệt): <span class="text-danger">*</span>
                                </label>
                                <span class="badge bg-light text-muted border">Kế toán có toàn quyền sửa</span>
                            </div>
                            <textarea id="textarea-noi-dung-email"
                                      class="form-control font-monospace rounded-3"
                                      rows="9"
                                      style="font-size: 0.9rem;"
                                      @bind="noiDungEmail"
                                      @bind:after="XoaBanDuyetCu"
                                      placeholder="Nội dung email sẽ hiển thị ở đây..."
                                      disabled="@(dangGuiEmail || dangGoiAiSoan)"></textarea>
                            <small class="text-muted d-block mt-1">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                Nội dung gửi đi sẽ là chính xác những gì bạn nhìn thấy và chỉnh sửa tại đây.
                            </small>
                        </div>
                    }
                </div>

                <div class="modal-footer py-2 px-3 bg-light rounded-bottom-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <button type="button"
                            class="btn btn-secondary rounded-pill px-4"
                            id="btn-huy-modal"
                            @onclick="DongModalSoanEmail"
                            disabled="@(dangGuiEmail || dangGoiAiSoan)">
                        Hủy bỏ
                    </button>

                    <button type="button"
                            class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold"
                            id="btn-xac-nhan-gui"
                            @onclick="MoModalXacNhanCuoiAsync"
                            disabled="@(!CoTheGuiEmail() || dangPheDuyet)">
                        @if (dangPheDuyet)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Đang duyệt...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-check me-1"></i>
                            <span>Phê duyệt & Gửi</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

