                                    <div class="mt-2 small text-muted">
                                        Trạng thái: <span class="badge bg-success">@ketQuaGuiHienTai.TrangThai</span>
                                        @if (ketQuaGuiHienTai.NhatKyId.HasValue)
                                        {
                                            <span class="ms-2">Mã nhật ký audit: <strong>#@ketQuaGuiHienTai.NhatKyId.Value</strong></span>
                                        }
                                        @if (LaCheDoGuiThat)
                                        {
                                            <div class="mt-1 fst-italic text-secondary">
                                                <i class="bi bi-info-circle me-1"></i>Lưu ý: Thư đã được máy chủ SMTP tiếp nhận thành công. Trạng thái này không đồng nghĩa với việc người nhận đã mở hoặc đọc thư.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
