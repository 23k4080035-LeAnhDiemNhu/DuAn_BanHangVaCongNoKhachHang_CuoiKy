@page "/bao-cao-tuoi-no"
@attribute [Authorize(Roles = VaiTroConstants.KeToanCongNo)]
@using System.Globalization
@using BanHang.CoreBusiness
@using BanHang.UseCases.BaoCaoTuoiNoScreen
@using BanHang.UseCases.EmailNhacNoScreen
@using BanHang.UseCases.PluginInterfaces.AI
@using BanHang.UseCases.PluginInterfaces.Email
@using DuAn_BanHangVaCongNoKhachHang.Services
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Logging
@inject IConfiguration Configuration
@inject IXemBaoCaoTuoiNoUseCase XemBaoCaoTuoiNoUseCase
@inject IXuatBaoCaoTuoiNoExcelUseCase XuatBaoCaoTuoiNoExcelUseCase
@inject IXemDuLieuNhacNoKhachHangUseCase XemDuLieuNhacNoUseCase
@inject ISoanEmailNhacNoUseCase SoanEmailNhacNoUseCase
@inject IPheDuyetEmailNhacNoUseCase PheDuyetEmailNhacNoUseCase
@inject IGuiEmailNhacNoUseCase GuiEmailNhacNoUseCase
@inject IJSRuntime JSRuntime
@inject ILogger<BaoCaoTuoiNoPage> Logger

<PageTitle>Báo cáo tuổi nợ khách hàng</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 page-title d-flex align-items-center gap-2">
            <span>Báo Cáo Tuổi Nợ Khách Hàng</span>
            <span class="badge bg-indigo-subtle text-primary border border-primary-subtle rounded-pill py-1 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; font-weight: 600;">
                <i class="bi bi-stars"></i> Trợ lý AI
            </span>
        </h3>
        <p class="text-muted small mb-0">Theo dõi công nợ theo 4 nhóm thời hạn: 0–30, 31–60, 61–90 và trên 90 ngày. Hỗ trợ AI soạn email nhắc nợ có kế toán phê duyệt.</p>
    </div>
</div>

<!-- Bộ lọc chọn ngày chốt báo cáo -->
<div class="card border-0 shadow-sm rounded-3 bg-white mb-3">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <label for="input-ngay-bao-cao" class="col-form-label fw-semibold text-slate-800 text-nowrap mb-0 small">Ngày chốt báo cáo:</label>
                <input type="date" id="input-ngay-bao-cao" class="form-control form-control-sm rounded-3" style="width: auto;" @bind="ngayBaoCaoInput" />
                <button class="btn btn-primary text-nowrap rounded-pill px-3 shadow-sm" id="btn-xem-bao-cao" @onclick="TaiBaoCaoAsync" disabled="@(isLoading || isExporting)">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Đang tính toán...</span>
                    }
                    else
                    {
                        <i class="bi bi-search me-1"></i>
                        <span>Xem báo cáo</span>
                    }
                </button>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="badge bg-light text-slate-800 border p-2 fs-6 text-wrap rounded-pill px-3">
                    Số liệu áp dụng ngày: <strong id="lbl-ngay-ap-dung">@ngayBaoCaoApDung.ToString("dd/MM/yyyy")</strong>
                </span>
                <button class="btn btn-success text-nowrap fw-semibold shadow-sm rounded-pill px-3" id="btn-xuat-excel" @onclick="XuatExcelAsync" disabled="@(isExporting || isLoading)">
                    @if (isExporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Đang xuất Excel...</span>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-excel me-1"></i>
                        <span>Xuất Excel</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Chú thích quy ước nghiệp vụ -->
<details class="small text-muted mb-3 card border-0 shadow-sm rounded-3 bg-white p-2 px-3">
    <summary class="cursor-pointer text-secondary fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 0.85rem;">
        <i class="bi bi-info-circle text-primary"></i>
        <span>Quy ước phân loại 4 nhóm tuổi nợ & dữ liệu báo cáo</span>
    </summary>
    <ul class="mb-0 mt-2 ps-3 text-muted">
        <li><strong>Quy ước nhóm:</strong> Nhóm 0–30 bao gồm khoản chưa đến hạn và khoản quá hạn tối đa 30 ngày tính đến ngày chốt báo cáo.</li>
        <li><strong>Phạm vi thời gian:</strong> Báo cáo phản ánh các hóa đơn và phân bổ thanh toán đã ghi nhận đến hết ngày báo cáo (chưa tái dựng lại FIFO cho phiếu thu nhập lùi ngày).</li>
        <li><strong>Soạn email nhắc nợ:</strong> Kế toán công nợ bấm nút "Soạn email" để AI tạo bản nháp cá nhân hóa; kế toán duyệt và chỉnh sửa trước khi gửi.</li>
    </ul>
</details>

@if (isLoading)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border text-primary me-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span>Đang tính toán phân tích tuổi nợ từ SQL Server...</span>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger rounded-3" role="alert">
        <h5 class="alert-heading fw-bold">Đã xảy ra lỗi!</h5>
        <p class="mb-0">@errorMessage</p>
    </div>
}
else if (baoCaoResult == null || !baoCaoResult.DanhSach.Any())
{
    <div class="alert alert-info rounded-3" role="alert">
        Không có dữ liệu khách hàng nào tại ngày báo cáo đã chọn.
    </div>
}
else
{
    @if (baoCaoResult.TienThuChuaPhanBo > 0)
    {
        <div class="alert alert-warning py-2 px-3 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2 shadow-sm border-0 rounded-3 small" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-wallet2 text-warning-emphasis"></i>
                <span>Tiền thu chưa phân bổ: <strong class="text-danger font-mono fs-6">@baoCaoResult.TienThuChuaPhanBo.ToString("N0", cultureVi) đ</strong></span>
            </div>
            <span class="badge bg-white text-muted border rounded-pill px-2 py-1">Lưu riêng trên phiếu thu (chưa cấn trừ)</span>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-page-table" id="table-tuoi-no" style="min-width: 1250px;">
                <thead>
                    <tr>
                        <th scope="col" style="width: 50px;" class="text-center text-nowrap">STT</th>
                        <th scope="col" style="width: 100px;" class="text-nowrap">MÃ KH</th>
                        <th scope="col" style="min-width: 220px;" class="text-start">TÊN KHÁCH HÀNG</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 130px;">HẠN MỨC</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 130px;">0–30 NGÀY</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 130px;">31–60 NGÀY</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 130px;">61–90 NGÀY</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 130px;">TRÊN 90 NGÀY</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 140px;">TỔNG CÔNG NỢ</th>
                        <th scope="col" class="text-center text-nowrap" style="width: 160px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                    }
                    @foreach (var item in baoCaoResult.DanhSach)
                    {
                        <tr>
                            <td class="text-center text-muted text-nowrap">@(stt++)</td>
                            <td class="fw-semibold text-nowrap font-mono">@item.MaKhachHang</td>
                            <td>
                                <div class="fw-semibold text-slate-800">@item.TenKhachHang</div>
                                @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                {
                                    <small class="text-muted text-nowrap">SĐT: @item.SoDienThoai</small>
                                }
                            </td>
                            <td class="text-end text-muted text-nowrap font-mono">@item.HanMucCongNo.ToString("N0", cultureVi) đ</td>
                            <td class="text-end text-nowrap font-mono @(item.TuoiNo_0_30 > 0 ? "fw-semibold text-primary" : "text-muted")">
                                @item.TuoiNo_0_30.ToString("N0", cultureVi) đ
                            </td>
                            <td class="text-end text-nowrap font-mono @(item.TuoiNo_31_60 > 0 ? "fw-semibold text-amber" : "text-muted")">
                                @item.TuoiNo_31_60.ToString("N0", cultureVi) đ
                            </td>
                            <td class="text-end text-nowrap font-mono @(item.TuoiNo_61_90 > 0 ? "fw-semibold text-orange" : "text-muted")">
                                @item.TuoiNo_61_90.ToString("N0", cultureVi) đ
                            </td>
                            <td class="text-end text-nowrap font-mono @(item.TuoiNo_Tren_90 > 0 ? "fw-bold text-danger" : "text-muted")">
                                @item.TuoiNo_Tren_90.ToString("N0", cultureVi) đ
                            </td>
                            <td class="text-end fw-bold text-nowrap font-mono @(item.TongCongNo > 0 ? "text-dark" : "text-muted")">
                                @item.TongCongNo.ToString("N0", cultureVi) đ
                            </td>
                            <td class="text-center text-nowrap">
                                @if (item.TongCongNo > 0)
                                {
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1"
                                            id="@($"btn-soan-email-{item.KhachHangId}")"
                                            @onclick="() => MoModalSoanEmailAsync(item.KhachHangId)"
                                            title="Soạn email nhắc nợ hỗ trợ bởi AI và duyệt trước khi gửi">
                                        <i class="bi bi-stars text-primary"></i>
                                        <span>Soạn email</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border rounded-pill px-2">Hết nợ</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="border-top border-2 fw-bold text-end text-nowrap">
                    <tr>
                        <td colspan="4" class="text-center text-uppercase text-nowrap">Tổng cộng</td>
                        <td class="text-primary text-nowrap font-mono">@baoCaoResult.Tong_TuoiNo_0_30.ToString("N0", cultureVi) đ</td>
                        <td class="text-amber text-nowrap font-mono">@baoCaoResult.Tong_TuoiNo_31_60.ToString("N0", cultureVi) đ</td>
                        <td class="text-orange text-nowrap font-mono">@baoCaoResult.Tong_TuoiNo_61_90.ToString("N0", cultureVi) đ</td>
                        <td class="text-danger text-nowrap font-mono">@baoCaoResult.Tong_TuoiNo_Tren_90.ToString("N0", cultureVi) đ</td>
                        <td class="fs-6 text-primary text-nowrap font-mono">@baoCaoResult.Tong_CongNo.ToString("N0", cultureVi) đ</td>
                        <td class="text-center text-muted text-nowrap">-</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL DUYỆT VÀ SOẠN EMAIL NHẮC NỢ (RESPONSIVE CHO DESKTOP & MOBILE 390x844px) -->
<!-- ========================================================================= -->
@if (hienThiModalSoanEmail)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(2px); z-index: 1050;" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered" style="max-height: 92vh;">
            <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="modal-header py-2 px-3 px-md-4 bg-white border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <i class="bi bi-envelope-paper-fill fs-5 text-primary me-1"></i>
                        <h5 class="modal-title fw-bold fs-6 mb-0 text-slate-900">Soạn email nhắc nợ</h5>
                        <span class="badge badge-subtle-ai small ms-1 d-inline-flex align-items-center gap-1">
                            <svg class="ai-sparkle-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2C12 7.523 7.523 12 2 12C7.523 12 12 16.477 12 22C12 16.477 16.477 12 22 12C16.477 12 12 7.523 12 2Z" fill="url(#gemini-badge-grad)" />
                                <path d="M19 2C19 4.2 17.2 6 15 6C17.2 6 19 7.8 19 10C19 7.8 20.8 6 23 6C20.8 6 19 4.2 19 2Z" fill="url(#gemini-badge-grad)" />
                                <defs>
                                    <linearGradient id="gemini-badge-grad" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#4F46E5" />
                                        <stop offset="0.5" stop-color="#3B82F6" />
                                        <stop offset="1" stop-color="#9333EA" />
                                    </linearGradient>
                                </defs>
                            </svg>
                            <span>@nguonSoanHienTai</span>
                        </span>
                        <span class="badge @(LaCheDoGuiThat ? "badge-subtle-danger" : "badge-subtle-sandbox") small">
                            @(LaCheDoGuiThat ? "Gửi thật (SMTP)" : "Mô phỏng")
                        </span>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="DongModalSoanEmail" disabled="@(dangGuiEmail || dangGoiAiSoan)"></button>
                </div>
                <div class="modal-body p-3 p-md-4" style="overflow-y: auto; max-height: calc(88vh - 130px);">
                    @if (dangTaiDuLieuSoan)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 text-muted small">Đang tải dữ liệu công nợ...</p>
                        </div>
                    }
                    else if (duLieuSoanHienTai != null)
                    {
                        @if (!string.IsNullOrEmpty(thongBaoLoiModal))
                        {
                            <div class="alert alert-danger py-2 px-3 mb-3 small rounded-3 border-0 d-flex align-items-center gap-2" role="alert">
                                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                                <div>@thongBaoLoiModal</div>
                            </div>
                        }

                        <!-- 1. THÔNG TIN KHÁCH HÀNG, NGƯỜI NHẬN & TỔNG NỢ -->
                        <div class="card border rounded-3 p-2 px-3 mb-2 bg-slate-subtle shadow-none">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="text-muted small">Khách hàng:</span>
                                    <strong class="text-slate-900 fs-6">@duLieuSoanHienTai.TenKhachHang</strong>
                                    <span class="badge bg-light text-slate-800 border font-mono">@duLieuSoanHienTai.MaKhachHang</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted small">Tổng nợ:</span>
                                    <span class="fs-6 fw-bold text-danger font-mono">@duLieuSoanHienTai.TongCongNo.ToString("N0", cultureVi) đ</span>
                                    @if (duLieuSoanHienTai.TienThuChuaPhanBo > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis font-mono" title="Tiền thu chưa phân bổ">
                                            Chưa cấn trừ: @duLieuSoanHienTai.TienThuChuaPhanBo.ToString("N0", cultureVi) đ
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2">
                                <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width: 250px;">
                                    <label for="input-email-nguoi-nhan" class="form-label fw-semibold mb-0 small text-nowrap text-slate-800">
                                        <i class="bi bi-envelope me-1 text-muted"></i>Email nhận:
                                    </label>
                                    <input type="email"
                                           id="input-email-nguoi-nhan"
                                           class="form-control form-control-sm rounded-3 @(duLieuSoanHienTai.EmailHopLe ? "" : "is-invalid")"
                                           @bind="emailNguoiNhanInput"
                                           @bind:after="CapNhatEmailNguoiNhan"
                                           placeholder="nhap.email@khachhang.com"
                                           disabled="@(dangGuiEmail || dangGoiAiSoan)" />
                                </div>
                                @if (duLieuSoanHienTai.DanhSachHoaDon.Any())
                                {
                                    <button class="btn btn-link btn-sm p-0 text-decoration-none text-muted d-flex align-items-center gap-1 text-nowrap"
                                            type="button"
                                            @onclick="() => hienThiChiTietHoaDon = !hienThiChiTietHoaDon">
                                        <i class="bi @(hienThiChiTietHoaDon ? "bi-chevron-down" : "bi-chevron-right") small"></i>
                                        <span class="small">Xem @duLieuSoanHienTai.DanhSachHoaDon.Count hóa đơn</span>
                                    </button>
                                }
                            </div>
                            @if (!duLieuSoanHienTai.EmailHopLe)
                            {
                                <div class="invalid-feedback d-block mt-1 small">
                                    Email nhận trống hoặc không đúng định dạng.
                                </div>
                            }

                            <!-- BẢNG HÓA ĐƠN CÓ THỂ THU GỌN -->
                            @if (duLieuSoanHienTai.DanhSachHoaDon.Any() && hienThiChiTietHoaDon)
                            {
                                <div class="table-responsive border rounded-3 mt-2 overflow-hidden" style="max-height: 140px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0 custom-invoice-table" style="font-size: 0.8rem;">
                                        <thead class="sticky-top">
                                            <tr>
                                                <th>Số HĐ</th>
                                                <th>Ngày lập</th>
                                                <th>Hạn TT</th>
                                                <th class="text-end">Dư nợ</th>
                                                <th class="text-center">Tình trạng</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var hd in duLieuSoanHienTai.DanhSachHoaDon)
                                            {
                                                <tr>
                                                    <td class="fw-semibold font-mono">@hd.MaHoaDon</td>
                                                    <td>@hd.NgayLap.ToString("dd/MM/yyyy")</td>
                                                    <td>@hd.HanThanhToan.ToString("dd/MM/yyyy")</td>
                                                    <td class="text-end fw-bold font-mono">@hd.DuNoTaiNgayChot.ToString("N0", cultureVi) đ</td>
                                                    <td class="text-center">
                                                        @if (hd.SoNgayQuaHan > 0)
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Quá hạn @hd.SoNgayQuaHan ngày</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Chưa đến hạn</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <!-- 2. KHU VỰC AI (CHỌN GIỌNG VĂN, Ô YÊU CẦU CHỈNH SỬA, NÚT TẠO LẠI VÀ DÙNG MẪU) -->
                        <div class="card border rounded-3 p-2 px-3 mb-2 bg-white shadow-none">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge bg-indigo-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small d-inline-flex align-items-center gap-1">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M12 2C12 7.523 7.523 12 2 12C7.523 12 12 16.477 12 22C12 16.477 16.477 12 22 12C16.477 12 12 7.523 12 2Z" fill="url(#gemini-ctrl-grad)" />
                                            <path d="M19 2C19 4.2 17.2 6 15 6C17.2 6 19 7.8 19 10C19 7.8 20.8 6 23 6C20.8 6 19 4.2 19 2Z" fill="url(#gemini-ctrl-grad)" />
                                            <defs>
                                                <linearGradient id="gemini-ctrl-grad" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                                                    <stop stop-color="#4F46E5" />
                                                    <stop offset="0.5" stop-color="#3B82F6" />
                                                    <stop offset="1" stop-color="#9333EA" />
                                                </linearGradient>
                                            </defs>
                                        </svg>
                                        <span>Trợ lý AI</span>
                                    </span>

                                    <span class="small fw-semibold text-slate-800 me-1">Giọng văn:</span>
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Chọn giọng văn">
                                        <input type="radio" class="btn-check" name="giongVanRadio" id="gvNheNhang" autocomplete="off"
                                               checked="@(giongVanChon == GiongVanEmail.NheNhang)"
                                               @onchange="() => DoiGiongVan(GiongVanEmail.NheNhang)"
                                               disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        <label class="btn @(giongVanChon == GiongVanEmail.NheNhang ? "btn-primary text-white" : "btn-outline-secondary") rounded-start-pill px-2 py-0" for="gvNheNhang" style="font-size: 0.8rem; line-height: 1.8;">Nhẹ nhàng</label>

                                        <input type="radio" class="btn-check" name="giongVanRadio" id="gvTieuChuan" autocomplete="off"
                                               checked="@(giongVanChon == GiongVanEmail.TieuChuan)"
                                               @onchange="() => DoiGiongVan(GiongVanEmail.TieuChuan)"
                                               disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        <label class="btn @(giongVanChon == GiongVanEmail.TieuChuan ? "btn-primary text-white" : "btn-outline-secondary") px-2 py-0" for="gvTieuChuan" style="font-size: 0.8rem; line-height: 1.8;">Tiêu chuẩn</label>

                                        <input type="radio" class="btn-check" name="giongVanRadio" id="gvKhanTruong" autocomplete="off"
                                               checked="@(giongVanChon == GiongVanEmail.KhanTruong)"
                                               @onchange="() => DoiGiongVan(GiongVanEmail.KhanTruong)"
                                               disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        <label class="btn @(giongVanChon == GiongVanEmail.KhanTruong ? "btn-primary text-white" : "btn-outline-secondary") rounded-end-pill px-2 py-0" for="gvKhanTruong" style="font-size: 0.8rem; line-height: 1.8;">Khẩn trương</label>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                            id="btn-dung-mau-co-san"
                                            type="button"
                                            @onclick="DungMauCoSanAsync"
                                            disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        <i class="bi bi-file-text me-1"></i>Dùng mẫu
                                    </button>
                                    <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm"
                                            id="btn-tao-nhap-ai"
                                            type="button"
                                            @onclick="TaoBanNhapAiAsync"
                                            disabled="@(dangGoiAiSoan || dangGuiEmail)">
                                        @if (dangGoiAiSoan)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            <span>Đang tạo...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-stars me-1"></i>
                                            <span>Tạo lại</span>
                                        }
                                    </button>
                                </div>
                            </div>

                            <div>
                                <input type="text"
                                       id="input-yeu-cau-chinh-cach-viet"
                                       class="form-control form-control-sm rounded-3"
                                       placeholder="Yêu cầu chỉnh sửa thêm (tùy chọn: ngắn hơn, lịch sự hơn, nhấn mạnh quá hạn...)"
                                       @bind="yeuCauChinhCachViet"
                                       disabled="@(dangGoiAiSoan || dangGuiEmail)" />
                            </div>
                        </div>

                        <!-- 3. TIÊU ĐỀ VÀ NỘI DUNG EMAIL (ƯU TIÊN DIỆN TÍCH) -->
                        <div class="mb-2">
                            <label for="input-tieu-de-email" class="form-label fw-semibold small text-slate-800 mb-1">
                                Tiêu đề email: <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="input-tieu-de-email"
                                   class="form-control form-control-sm rounded-3"
                                   @bind="tieuDeEmail"
                                   @bind:after="XoaBanDuyetCu"
                                   placeholder="Tiêu đề email..."
                                   disabled="@(dangGuiEmail || dangGoiAiSoan)" />
                        </div>

                        <div class="mb-1">
                            <label for="textarea-noi-dung-email" class="form-label fw-semibold small text-slate-800 mb-1">
                                Nội dung email: <span class="text-danger">*</span>
                            </label>
                            <textarea id="textarea-noi-dung-email"
                                      class="form-control font-mono rounded-3"
                                      rows="8"
                                      style="font-size: 0.88rem; line-height: 1.6;"
                                      @bind="noiDungEmail"
                                      @bind:after="XoaBanDuyetCu"
                                      placeholder="Nội dung email..."
                                      disabled="@(dangGuiEmail || dangGoiAiSoan)"></textarea>
                        </div>
                    }
                </div>

                <div class="modal-footer py-3 px-4 bg-light border-top d-flex justify-content-between align-items-center">
                    <button type="button"
                            class="btn btn-outline-secondary rounded-pill px-4"
                            id="btn-huy-modal"
                            @onclick="DongModalSoanEmail"
                            disabled="@(dangGuiEmail || dangGoiAiSoan)">
                        Hủy
                    </button>

                    <button type="button"
                            class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm"
                            id="btn-xac-nhan-gui"
                            @onclick="MoModalXacNhanCuoiAsync"
                            disabled="@(!CoTheGuiEmail() || dangPheDuyet)">
                        @if (dangPheDuyet)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Đang duyệt...</span>
                        }
                        else
                        {
                            <span>Duyệt & tiếp tục</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

