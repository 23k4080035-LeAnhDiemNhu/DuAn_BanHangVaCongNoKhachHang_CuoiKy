                        <button type="button"
                                class="btn @(LaCheDoGuiThat ? "btn-danger" : "btn-success") rounded-pill px-4 fw-semibold shadow-sm"
                                id="btn-gui-ngay"
                                @onclick="ThucHienGuiEmailAsync"
                                disabled="@(dangGuiEmail || string.IsNullOrWhiteSpace(maPheDuyetHienTai))">
                            @if (dangGuiEmail)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>@(LaCheDoGuiThat ? "Đang gửi email thật..." : "Đang gửi thử nghiệm...")</span>
                            }
                            else
                            {
                                <i class="bi @(LaCheDoGuiThat ? "bi-send-exclamation" : "bi-send-fill") me-1"></i>
                                <span>@(LaCheDoGuiThat ? "Xác nhận gửi thật" : "Gửi thử nghiệm")</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime ngayBaoCaoInput = DateTime.Today;
    private DateTime ngayBaoCaoApDung = DateTime.Today;
    private BaoCaoTuoiNoResult? baoCaoResult;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;

    private readonly CultureInfo cultureVi = CultureInfo.GetCultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        await TaiBaoCaoAsync();
    }

    private async Task TaiBaoCaoAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;
            errorMessage = string.Empty;

            Logger.LogInformation("Đang tải Báo cáo tuổi nợ cho ngày {NgayBaoCao}", ngayBaoCaoInput.ToString("yyyy-MM-dd"));

            baoCaoResult = await XemBaoCaoTuoiNoUseCase.ExecuteAsync(ngayBaoCaoInput);
            ngayBaoCaoApDung = ngayBaoCaoInput; // Cập nhật ngày áp dụng sau khi tải thành công
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi tải Báo cáo tuổi nợ cho ngày {NgayBaoCao}", ngayBaoCaoInput.ToString("yyyy-MM-dd"));
            hasError = true;
            errorMessage = $"Không thể tải báo cáo tuổi nợ: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool isExporting = false;

    private async Task XuatExcelAsync()
    {
        if (isExporting || isLoading) return;

        try
        {
            isExporting = true;
            hasError = false;
            errorMessage = string.Empty;

            Logger.LogInformation("Bắt đầu xuất Báo cáo tuổi nợ ra Excel theo ngày áp dụng {NgayApDung}", ngayBaoCaoApDung.ToString("yyyy-MM-dd"));

            // Luôn xuất theo NGÀY ĐÃ ÁP DỤNG của báo cáo đang hiển thị, không lấy ngày mới nhập nhưng chưa bấm 'Xem báo cáo'
            var result = await XuatBaoCaoTuoiNoExcelUseCase.ExecuteAsync(ngayBaoCaoApDung, baoCaoResult);

            if (!result.ThanhCong)
            {
                hasError = true;
                errorMessage = result.ThongBaoLoi ?? "Xuất file Excel thất bại.";
                return;
            }

            if (result.FileBytes != null && result.FileBytes.Length > 0)
            {
                using var stream = new MemoryStream(result.FileBytes);
                using var streamRef = new DotNetStreamReference(stream);
                await JSRuntime.InvokeVoidAsync("downloadFileFromStream", result.TenFile, streamRef);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi xuất Báo cáo tuổi nợ ra Excel cho ngày {NgayApDung}", ngayBaoCaoApDung.ToString("yyyy-MM-dd"));
            hasError = true;
            errorMessage = $"Không thể xuất file Excel: {ex.Message}";
        }
        finally
        {
            isExporting = false;
        }
    }

    // =========================================================================
    // TRẠNG THÁI & HÀNH ĐỘNG SOẠN VÀ DUYỆT EMAIL NHẮC NỢ
    // =========================================================================
    private bool hienThiModalSoanEmail = false;
    private bool hienThiModalXacNhanGui = false;
    private bool dangTaiDuLieuSoan = false;
    private bool dangGoiAiSoan = false;
    private bool dangGuiEmail = false;

    private DuLieuKhachHangNhacNoDto? duLieuSoanHienTai;
    private string emailNguoiNhanInput = string.Empty;
    private GiongVanEmail giongVanChon = GiongVanEmail.TieuChuan;
    private string tieuDeEmail = string.Empty;
    private string noiDungEmail = string.Empty;
    private string yeuCauChinhCachViet = string.Empty;
    private string nguonSoanHienTai = "Mô phỏng";
    private string thongBaoAi = string.Empty;
    private string thongBaoLoiModal = string.Empty;
    private string thongBaoThanhCongModal = string.Empty;
    private string maPheDuyetHienTai = string.Empty;
    private bool dangPheDuyet = false;
    private KetQuaGuiEmailDto? ketQuaGuiHienTai;
    private string thongBaoLoiGuiModal = string.Empty;

    private bool LaCheDoGuiThat => 
        string.Equals(Configuration["EmailSettings:Mode"], "Smtp", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Configuration["EmailSettings:SendMode"], "Smtp", StringComparison.OrdinalIgnoreCase);
    private bool LaAiThat => 
        string.Equals(Configuration["AiSettings:Provider"], "OpenAI", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Configuration["AiSettings:Provider"], "Gemini", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Configuration["AiSettings:Provider"], "Real", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Configuration["EmailSettings:AiProvider"], "OpenAI", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Configuration["EmailSettings:AiProvider"], "Gemini", StringComparison.OrdinalIgnoreCase);

    private string TenAiHienThi =>
        string.Equals(Configuration["AiSettings:Provider"], "Gemini", StringComparison.OrdinalIgnoreCase) ? "Gemini" :
        string.Equals(Configuration["AiSettings:Provider"], "OpenAI", StringComparison.OrdinalIgnoreCase) ? "OpenAI" : "AI";
    private string? EmailRedirect => Configuration["EmailSettings:TestRecipientRedirect"];

    private void XoaBanDuyetCu()
    {
        maPheDuyetHienTai = string.Empty;
        ketQuaGuiHienTai = null;
        thongBaoLoiGuiModal = string.Empty;
    }

    private async Task MoModalSoanEmailAsync(int khachHangId)
    {
        try
        {
            thongBaoLoiModal = string.Empty;
            thongBaoThanhCongModal = string.Empty;
            thongBaoAi = string.Empty;
            tieuDeEmail = string.Empty;
            noiDungEmail = string.Empty;
            yeuCauChinhCachViet = string.Empty;
            maPheDuyetHienTai = string.Empty;
            giongVanChon = GiongVanEmail.TieuChuan;
            nguonSoanHienTai = LaAiThat ? $"AI thật ({TenAiHienThi})" : "Mô phỏng";

            hienThiModalSoanEmail = true;
            dangTaiDuLieuSoan = true;

            // Luôn lấy dữ liệu xác thực từ máy chủ theo đúng ngày chốt báo cáo đang áp dụng
            duLieuSoanHienTai = await XemDuLieuNhacNoUseCase.ExecuteAsync(khachHangId, ngayBaoCaoApDung);
            emailNguoiNhanInput = duLieuSoanHienTai.Email ?? string.Empty;

            dangTaiDuLieuSoan = false;

            // Tự động tạo bản nháp ban đầu để kế toán xem và chỉnh sửa
            await TaoBanNhapAiAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi mở modal soạn email nhắc nợ cho khách hàng {KhachHangId}", khachHangId);
            dangTaiDuLieuSoan = false;
            thongBaoLoiModal = $"Không thể tải dữ liệu công nợ: {ex.Message}";
        }
    }

    private void CapNhatEmailNguoiNhan()
    {
        if (duLieuSoanHienTai != null)
        {
            string email = emailNguoiNhanInput?.Trim() ?? string.Empty;
            duLieuSoanHienTai.Email = email;
            XoaBanDuyetCu();
        }
    }

    private void DoiGiongVan(GiongVanEmail gv)
    {
        giongVanChon = gv;
        XoaBanDuyetCu();
    }

    private async Task DungMauCoSanAsync()
    {
        if (duLieuSoanHienTai == null || dangGoiAiSoan || dangGuiEmail) return;

        try
        {
            dangGoiAiSoan = true;
            thongBaoAi = string.Empty;
            thongBaoLoiModal = string.Empty;
            XoaBanDuyetCu();

            var yeuCau = new YeuCauSoanEmailDto
            {
                KhachHangId = duLieuSoanHienTai.KhachHangId,
                NgayChotBaoCao = ngayBaoCaoApDung,
                GiongVan = giongVanChon,
                EmailTuyChinh = emailNguoiNhanInput,
                ChiDungMauCoSan = true
            };

            var banNhap = await SoanEmailNhacNoUseCase.ExecuteAsync(yeuCau);
            tieuDeEmail = banNhap.TieuDe;
            noiDungEmail = banNhap.NoiDung;
            nguonSoanHienTai = "Mẫu có sẵn";
            thongBaoAi = "Đã nạp nội dung từ 'Mẫu có sẵn'. Bạn có thể kiểm tra và chỉnh sửa tự do.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi nạp mẫu có sẵn cho khách hàng {KhachHangId}", duLieuSoanHienTai.KhachHangId);
            thongBaoLoiModal = $"Lỗi khi nạp mẫu có sẵn: {ex.Message}";
        }
        finally
        {
            dangGoiAiSoan = false;
        }
    }

    private async Task TaoBanNhapAiAsync()
    {
        if (duLieuSoanHienTai == null || dangGoiAiSoan || dangGuiEmail) return;

        try
        {
            dangGoiAiSoan = true;
            thongBaoAi = string.Empty;
            thongBaoLoiModal = string.Empty;
            XoaBanDuyetCu();

            var yeuCau = new YeuCauSoanEmailDto
            {
                KhachHangId = duLieuSoanHienTai.KhachHangId,
                NgayChotBaoCao = ngayBaoCaoApDung,
                GiongVan = giongVanChon,
                EmailTuyChinh = emailNguoiNhanInput,
                YeuCauChinhCachViet = yeuCauChinhCachViet
            };

            var banNhap = await SoanEmailNhacNoUseCase.ExecuteAsync(yeuCau);

            if (!string.IsNullOrWhiteSpace(banNhap.ThongBaoLoiAi))
            {
                thongBaoLoiModal = banNhap.ThongBaoLoiAi;
                // Giữ nguyên nội dung kế toán đang chỉnh, không ghi đè nếu đã có
                if (string.IsNullOrWhiteSpace(noiDungEmail))
                {
                    thongBaoAi = "Chưa tạo được bản nháp bằng AI. Vui lòng bấm 'Dùng mẫu có sẵn' hoặc tự soạn nội dung.";
                }
                else
                {
                    thongBaoAi = "Chưa tạo được bằng AI. Nội dung kế toán đang chỉnh sửa được giữ nguyên.";
                }
            }
            else
            {
                tieuDeEmail = banNhap.TieuDe;
                noiDungEmail = banNhap.NoiDung;
                nguonSoanHienTai = banNhap.NguonSoan;
                thongBaoAi = $"Bản nháp đã được tạo thành công bởi [{banNhap.NguonSoan}] theo giọng văn '{giongVanChon}'. Bạn có thể chỉnh sửa tự do.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi gọi tạo bản nháp email cho khách hàng {KhachHangId}", duLieuSoanHienTai.KhachHangId);
            thongBaoLoiModal = $"Lỗi khi soạn nháp: {ex.Message}. Nội dung hiện tại đã được giữ nguyên.";
        }
        finally
        {
            dangGoiAiSoan = false;
        }
    }

    private bool CoTheGuiEmail()
    {
        return !dangGuiEmail &&
               !dangGoiAiSoan &&
               !dangTaiDuLieuSoan &&
               !dangPheDuyet &&
               duLieuSoanHienTai != null &&
               duLieuSoanHienTai.EmailHopLe &&
               !string.IsNullOrWhiteSpace(tieuDeEmail) &&
               !string.IsNullOrWhiteSpace(noiDungEmail);
    }

    private async Task MoModalXacNhanCuoiAsync()
    {
        if (!CoTheGuiEmail() || dangPheDuyet || duLieuSoanHienTai == null) return;

        try
        {
            dangPheDuyet = true;
            thongBaoLoiModal = string.Empty;
            thongBaoLoiGuiModal = string.Empty;
            ketQuaGuiHienTai = null;

            // Thực hiện phê duyệt tại máy chủ trước khi mở modal xác nhận gửi
            var yeuCauDuyet = new YeuCauDuyetEmailDto
            {
                KhachHangId = duLieuSoanHienTai.KhachHangId,
                NgayChotBaoCao = ngayBaoCaoApDung,
                EmailNguoiNhan = emailNguoiNhanInput.Trim(),
                TieuDe = tieuDeEmail.Trim(),
                NoiDung = noiDungEmail.Trim(),
                GiongVan = giongVanChon
            };

            var ketQuaDuyet = await PheDuyetEmailNhacNoUseCase.ExecuteAsync(yeuCauDuyet);
            if (!ketQuaDuyet.ThanhCong)
            {
                thongBaoLoiModal = ketQuaDuyet.ThongBaoLoi ?? "Phê duyệt bản nháp thất bại.";
                return;
            }

            maPheDuyetHienTai = ketQuaDuyet.MaPheDuyet;
            hienThiModalXacNhanGui = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi phê duyệt bản nháp email cho khách hàng {KhachHangId}", duLieuSoanHienTai.KhachHangId);
            thongBaoLoiModal = $"Lỗi khi phê duyệt bản nháp: {ex.Message}";
        }
        finally
        {
            dangPheDuyet = false;
        }
    }

    private async Task ThucHienGuiEmailAsync()
    {
        if (dangGuiEmail || duLieuSoanHienTai == null || string.IsNullOrWhiteSpace(maPheDuyetHienTai)) return;

        try
        {
            dangGuiEmail = true;
            thongBaoLoiGuiModal = string.Empty;

            var yeuCauGui = new YeuCauGuiEmailDto
            {
                KhachHangId = duLieuSoanHienTai.KhachHangId,
                NgayChotBaoCao = ngayBaoCaoApDung,
                EmailNguoiNhan = emailNguoiNhanInput.Trim(),
                TieuDe = tieuDeEmail.Trim(),
                NoiDung = noiDungEmail.Trim(),
                GiongVan = giongVanChon,
                HashDuLieuCongNo = duLieuSoanHienTai.HashDuLieuCongNo,
                MaPheDuyet = maPheDuyetHienTai,
                IdempotencyKey = $"SEND-{maPheDuyetHienTai}",
                DaDuyet = true,
                CheDoGui = LaCheDoGuiThat ? "Smtp" : "Sandbox",
                NguonSoan = nguonSoanHienTai
            };

            var ketQua = await GuiEmailNhacNoUseCase.ExecuteAsync(yeuCauGui);
            ketQuaGuiHienTai = ketQua;

            if (ketQua.ThanhCong)
            {
                // Giữ modal xác nhận mở để kế toán thấy kết quả ngay trong modal đang tương tác
                thongBaoThanhCongModal = ketQua.ThongBao;
                maPheDuyetHienTai = string.Empty; // Tiêu hủy bản duyệt cũ sau khi đã gửi thành công
            }
            else
            {
                thongBaoLoiGuiModal = ketQua.ThongBao ?? "Gửi email không thành công.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi thực hiện gửi email nhắc nợ cho khách hàng {KhachHangId}", duLieuSoanHienTai?.KhachHangId);
            thongBaoLoiGuiModal = $"Lỗi khi gửi email: {ex.Message}";
        }
        finally
        {
            dangGuiEmail = false;
        }
    }

    private void DongModalXacNhan()
    {
        if (dangGuiEmail) return;
        hienThiModalXacNhanGui = false;
        thongBaoLoiGuiModal = string.Empty;

        if (ketQuaGuiHienTai != null && ketQuaGuiHienTai.ThanhCong)
        {
            DongTatCaModal();
        }
    }

    private void DongTatCaModal()
    {
        hienThiModalXacNhanGui = false;
        hienThiModalSoanEmail = false;
        duLieuSoanHienTai = null;
        maPheDuyetHienTai = string.Empty;
        ketQuaGuiHienTai = null;
        thongBaoLoiGuiModal = string.Empty;
    }

    private void DongModalSoanEmail()
    {
        if (dangGuiEmail || dangGoiAiSoan) return;
        DongTatCaModal();
    }
}
