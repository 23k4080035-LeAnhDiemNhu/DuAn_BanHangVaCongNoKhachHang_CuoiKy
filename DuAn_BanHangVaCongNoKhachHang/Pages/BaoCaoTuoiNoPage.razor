                    }

                    <div class="mb-2">
                        <label class="text-muted small d-block">Tiêu đề email:</label>
                        <strong class="text-dark">@tieuDeEmail</strong>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small d-block fw-semibold mb-1">
                            <i class="bi bi-envelope-paper me-1"></i>Nội dung email đầy đủ sẽ gửi:
