            <div class="modal-content shadow border-0 rounded-4">
                <div class="modal-header @(ketQuaGuiHienTai?.ThanhCong == true ? "bg-primary" : (LaCheDoGuiThat ? "bg-danger" : "bg-success")) text-white py-3 px-4 rounded-top-4">
