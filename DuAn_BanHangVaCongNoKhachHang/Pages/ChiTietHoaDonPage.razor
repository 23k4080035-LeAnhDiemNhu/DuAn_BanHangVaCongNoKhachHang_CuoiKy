@page "/hoa-don/{HoaDonId:int}"
@attribute [Authorize(Roles = $"{VaiTroConstants.NhanVienBanHang},{VaiTroConstants.KeToanCongNo}")]
@using System.Globalization
@using BanHang.CoreBusiness
@using BanHang.UseCases.HoaDonScreen
@using Microsoft.Extensions.Logging
@inject IXemChiTietHoaDonUseCase XemChiTietHoaDonUseCase
@inject ILogger<ChiTietHoaDonPage> Logger

<PageTitle>Chi tiết hóa đơn @(hoaDon?.MaHoaDon ?? "")</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center flex-wrap gap-2">
        <a href="/hoa-don" class="btn btn-outline-secondary btn-sm text-nowrap" id="btn-back-hoa-don">
            &larr; Quay lại danh sách
        </a>
        <h3 class="mb-0 text-primary fw-bold">
            Chi tiết hóa đơn: <span>@(hoaDon?.MaHoaDon ?? $"#{HoaDonId}")</span>
        </h3>
    </div>
    @if (hoaDon != null)
    {
        <div>
            @switch (hoaDon.TrangThai)
            {
                case TrangThaiHoaDon.DaThanhToan:
                    <span class="badge bg-success fs-6 px-3 py-2 text-nowrap">Đã thanh toán</span>
                    break;
                case TrangThaiHoaDon.ThanhToanMotPhan:
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2 text-nowrap">Thanh toán 1 phần</span>
                    break;
                case TrangThaiHoaDon.ChuaThanhToan:
                default:
                    <span class="badge bg-secondary fs-6 px-3 py-2 text-nowrap">Chưa thanh toán</span>
                    break;
            }
        </div>
    }
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border text-primary me-3" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <span>Đang tải thông tin chi tiết hóa đơn...</span>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger d-flex align-items-center my-3" role="alert">
        <div>
            <h5 class="alert-heading mb-1">Đã xảy ra lỗi!</h5>
            <p class="mb-0">@errorMessage</p>
        </div>
    </div>
}
else if (hoaDon == null)
{
    <div class="card shadow-sm border-warning my-4">
        <div class="card-body p-4 text-center">
            <h4 class="text-warning mb-3">Không tìm thấy hóa đơn</h4>
            <p class="text-muted mb-4">Hóa đơn mã số #@HoaDonId không tồn tại hoặc đã bị xóa khỏi hệ thống.</p>
            <a href="/hoa-don" class="btn btn-primary px-4">Quay về danh sách hóa đơn</a>
        </div>
    </div>
}
else
{
    <!-- THÔNG TIN CHUNG HÓA ĐƠN & KHÁCH HÀNG -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-primary">
                <div class="card-header bg-white fw-bold text-primary">
                    Thông tin hóa đơn
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th style="width: 140px;" class="text-muted text-nowrap">Mã hóa đơn:</th>
                                <td class="fw-bold text-primary text-nowrap">@hoaDon.MaHoaDon</td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Ngày lập:</th>
                                <td class="text-nowrap">@hoaDon.NgayLap.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Hạn thanh toán:</th>
                                <td class="text-nowrap">
                                    <span>@hoaDon.HanThanhToan.ToString("dd/MM/yyyy")</span>
                                    @if (hoaDon.ConLai > 0 && DateTime.Today > hoaDon.HanThanhToan)
                                    {
                                        var soNgayQuaHan = (DateTime.Today - hoaDon.HanThanhToan).Days;
                                        <span class="badge bg-danger ms-2 text-nowrap">Quá hạn @soNgayQuaHan ngày</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Ghi chú:</th>
                                <td>@(string.IsNullOrWhiteSpace(hoaDon.GhiChu) ? "—" : hoaDon.GhiChu)</td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Thời điểm tạo:</th>
                                <td class="small text-muted text-nowrap">@hoaDon.NgayTao.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-success">
                <div class="card-header bg-white fw-bold text-success">
                    Thông tin khách hàng & Thanh toán
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th style="width: 140px;" class="text-muted text-nowrap">Khách hàng:</th>
                                <td class="fw-bold">@hoaDon.TenKhachHang</td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Mã KH:</th>
                                <td><span class="badge bg-light text-dark border text-nowrap">@hoaDon.MaKhachHang</span></td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Số điện thoại:</th>
                                <td class="text-nowrap">@(string.IsNullOrWhiteSpace(hoaDon.SoDienThoai) ? "—" : hoaDon.SoDienThoai)</td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Địa chỉ:</th>
                                <td>@(string.IsNullOrWhiteSpace(hoaDon.DiaChi) ? "—" : hoaDon.DiaChi)</td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Tổng tiền HĐ:</th>
                                <td class="fw-bold fs-6 text-nowrap">@hoaDon.TongTien.ToString("N0", viCulture) đ</td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Đã thanh toán:</th>
                                <td class="text-muted fw-semibold text-nowrap">@hoaDon.DaThanhToan.ToString("N0", viCulture) đ</td>
                            </tr>
                            <tr>
                                <th class="text-muted text-nowrap">Còn lại:</th>
                                <td class="fw-bold fs-6 text-nowrap @(hoaDon.ConLai > 0 ? "text-danger" : "text-success")">
                                    @hoaDon.ConLai.ToString("N0", viCulture) đ
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH SẢN PHẨM (DÒNG HÀNG SNAPSHOT) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold">Danh sách sản phẩm xuất bán (Snapshot thời điểm lập)</span>
            <span class="badge bg-secondary text-nowrap">@hoaDon.DanhSachDongHang.Count dòng hàng</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-striped table-hover align-middle mb-0" style="min-width: 780px;">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" style="width: 50px;" class="text-center text-nowrap">#</th>
                            <th scope="col" style="min-width: 240px;">Tên sản phẩm</th>
                            <th scope="col" style="width: 100px;" class="text-center text-nowrap">ĐVT</th>
                            <th scope="col" style="width: 120px;" class="text-end text-nowrap">Số lượng</th>
                            <th scope="col" style="width: 150px;" class="text-end text-nowrap">Đơn giá bán</th>
                            <th scope="col" style="width: 160px;" class="text-end text-nowrap">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!hoaDon.DanhSachDongHang.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">Không có dòng hàng nào trong hóa đơn này.</td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            @foreach (var dong in hoaDon.DanhSachDongHang)
                            {
                                <tr>
                                    <td class="text-center text-muted text-nowrap">@(stt++)</td>
                                    <td>
                                        <div class="fw-semibold">@dong.TenSanPham</div>
                                    </td>
                                    <td class="text-center text-nowrap">@dong.DonViTinh</td>
                                    <td class="text-end text-nowrap">@dong.SoLuong.ToString("N0", viCulture)</td>
                                    <td class="text-end text-nowrap">@dong.DonGia.ToString("N0", viCulture) đ</td>
                                    <td class="text-end fw-bold text-nowrap">@dong.ThanhTien.ToString("N0", viCulture) đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold text-nowrap">
                        <tr>
                            <td colspan="5" class="text-end text-nowrap">TỔNG TIỀN DÒNG HÀNG:</td>
                            <td class="text-end text-primary fs-6 text-nowrap">
                                @hoaDon.TongTienDongHang.ToString("N0", viCulture) đ
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- LỊCH SỬ PHÂN BỔ THANH TOÁN (FIFO) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold">Lịch sử thanh toán cấn trừ nợ vào hóa đơn (Thuật toán FIFO)</span>
            <span class="badge bg-secondary text-nowrap">@hoaDon.DanhSachPhanBo.Count lượt phân bổ</span>
        </div>
        <div class="card-body p-0">
            @if (!hoaDon.DanhSachPhanBo.Any())
            {
                <div class="p-3 text-center text-muted">
                    Hóa đơn này chưa có khoản thanh toán nào được phân bổ.
                </div>
            }
            else
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-striped table-hover align-middle mb-0" style="min-width: 820px;">
                        <thead class="table-secondary">
                            <tr>
                                <th scope="col" style="width: 50px;" class="text-center text-nowrap">#</th>
                                <th scope="col" style="width: 140px;" class="text-nowrap">Mã phiếu thu</th>
                                <th scope="col" style="width: 140px;" class="text-center text-nowrap">Ngày thanh toán</th>
                                <th scope="col" style="width: 180px;" class="text-center text-nowrap">Thời điểm phân bổ</th>
                                <th scope="col" style="width: 140px;" class="text-center text-nowrap">Phương thức</th>
                                <th scope="col" class="text-end text-nowrap" style="width: 170px;">Số tiền phân bổ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int sttPb = 1; }
                            @foreach (var pb in hoaDon.DanhSachPhanBo)
                            {
                                <tr>
                                    <td class="text-center text-muted text-nowrap">@(sttPb++)</td>
                                    <td class="fw-bold text-success text-nowrap">@pb.MaPhieuThu</td>
                                    <td class="text-center text-nowrap">@pb.NgayThanhToan.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center small text-muted text-nowrap">@pb.NgayPhanBo.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td class="text-center text-nowrap">
                                        @if (pb.PhuongThuc == "TienMat" || pb.PhuongThuc == "Tiền mặt")
                                        {
                                            <span class="badge bg-secondary text-nowrap">Tiền mặt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark text-nowrap">Chuyển khoản</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-success text-nowrap">
                                        @pb.SoTienPhanBo.ToString("N0", viCulture) đ
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold text-nowrap">
                            <tr>
                                <td colspan="5" class="text-end text-nowrap">TỔNG ĐÃ PHÂN BỔ VÀO HÓA ĐƠN:</td>
                                <td class="text-end text-success fs-6 text-nowrap">
                                    @hoaDon.TongTienPhanBo.ToString("N0", viCulture) đ
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- BẢNG ĐỐI CHIẾU TỔNG HỢP (RECONCILIATION) -->
    <div class="card shadow-sm border-0 border-start border-4 border-info mb-4">
        <div class="card-body">
            <h5 class="card-title fw-bold text-secondary mb-3">Đối chiếu tính nhất quán số liệu</h5>
            <div class="row g-3">
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center h-100">
                        <small class="text-muted d-block mb-1 text-nowrap">Tổng tiền dòng hàng</small>
                        <span class="fw-bold fs-6 text-nowrap">@hoaDon.TongTienDongHang.ToString("N0", viCulture) đ</span>
                        <div class="mt-1">
                            @if (hoaDon.TongTienDongHang == hoaDon.TongTien)
                            {
                                <span class="badge bg-success small text-nowrap">Khớp tổng HĐ</span>
                            }
                            else
                            {
                                <span class="badge bg-danger small text-nowrap">Lệch tổng HĐ</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center h-100">
                        <small class="text-muted d-block mb-1 text-nowrap">Tổng tiền hóa đơn</small>
                        <span class="fw-bold fs-6 text-primary text-nowrap">@hoaDon.TongTien.ToString("N0", viCulture) đ</span>
                        <div class="mt-1">
                            <span class="badge bg-primary small text-nowrap">Giá trị hóa đơn</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center h-100">
                        <small class="text-muted d-block mb-1 text-nowrap">Tổng tiền đã phân bổ</small>
                        <span class="fw-bold fs-6 text-success text-nowrap">@hoaDon.TongTienPhanBo.ToString("N0", viCulture) đ</span>
                        <div class="mt-1">
                            @if (hoaDon.TongTienPhanBo == hoaDon.DaThanhToan)
                            {
                                <span class="badge bg-success small text-nowrap">Khớp đã trả</span>
                            }
                            else
                            {
                                <span class="badge bg-danger small text-nowrap">Lệch đã trả</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center h-100">
                        <small class="text-muted d-block mb-1 text-nowrap">Số dư nợ còn lại</small>
                        <span class="fw-bold fs-6 text-nowrap @(hoaDon.ConLai > 0 ? "text-danger" : "text-success")">
                            @hoaDon.ConLai.ToString("N0", viCulture) đ
                        </span>
                        <div class="mt-1">
                            @if (hoaDon.ConLai == (hoaDon.TongTien - hoaDon.DaThanhToan))
                            {
                                <span class="badge bg-success small text-nowrap">Số dư chính xác</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int HoaDonId { get; set; }

    private ChiTietHoaDonDto? hoaDon;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private readonly CultureInfo viCulture = new CultureInfo("vi-VN");

    protected override async Task OnParametersSetAsync()
    {
        await LoadChiTietHoaDonAsync();
    }

    private async Task LoadChiTietHoaDonAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            Logger.LogInformation("Bắt đầu tải chi tiết hóa đơn Id {HoaDonId}", HoaDonId);
            hoaDon = await XemChiTietHoaDonUseCase.ExecuteAsync(HoaDonId);

            if (hoaDon == null)
            {
                Logger.LogWarning("Không tìm thấy hóa đơn với Id {HoaDonId}", HoaDonId);
            }
            else
            {
                Logger.LogInformation("Tải thành công chi tiết hóa đơn {MaHoaDon} (Tổng {TongTien:N0} đ, Đã trả {DaThanhToan:N0} đ, Còn lại {ConLai:N0} đ)",
                    hoaDon.MaHoaDon, hoaDon.TongTien, hoaDon.DaThanhToan, hoaDon.ConLai);
            }
        }
        catch (UnauthorizedAccessException uex)
        {
            Logger.LogWarning(uex, "Người dùng không có quyền xem chi tiết hóa đơn Id {HoaDonId}", HoaDonId);
            hasError = true;
            errorMessage = uex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi bất ngờ khi tải chi tiết hóa đơn Id {HoaDonId}", HoaDonId);
            hasError = true;
            errorMessage = "Đã xảy ra lỗi khi kết nối cơ sở dữ liệu để tải chi tiết hóa đơn. Vui lòng thử lại sau.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
