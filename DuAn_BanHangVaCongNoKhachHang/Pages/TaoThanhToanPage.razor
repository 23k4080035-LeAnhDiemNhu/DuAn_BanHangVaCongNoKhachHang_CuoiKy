@page "/thanh-toan/tao"
@attribute [Authorize(Roles = VaiTroConstants.KeToanCongNo)]
@using System.Globalization
@using BanHang.CoreBusiness
@using BanHang.UseCases.KhachHangScreen
@using BanHang.UseCases.ThanhToanScreen
@using Microsoft.Extensions.Logging
@inject IXemDanhSachKhachHangUseCase XemDanhSachKhachHangUseCase
@inject IXemTruocPhanBoFifoUseCase XemTruocPhanBoFifoUseCase
@inject ITaoThanhToanUseCase TaoThanhToanUseCase
@inject IVietQrService VietQrService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<TaoThanhToanPage> Logger
@implements IDisposable

<PageTitle>Lập phiếu thu tiền & Phân bổ FIFO</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="mb-1 text-slate-900 fw-bold">Lập Phiếu Thu Tiền & Phân Bổ FIFO</h3>
            <p class="text-muted mb-0 small">
                Ghi nhận chứng từ thu tiền và tự động cấn trừ công nợ theo thứ tự hóa đơn (FIFO).
            </p>
        </div>
        <a href="/thanh-toan" class="btn btn-outline-secondary rounded-pill px-3 py-2 text-nowrap d-inline-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (isLoadingData)
    {
        <div class="d-flex align-items-center justify-content-center p-5 bg-white rounded-3 shadow-sm border my-4">
            <div class="spinner-border text-primary me-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span class="fw-semibold text-muted">Đang tải danh sách khách hàng & dữ liệu cấu hình...</span>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-octagon-fill fs-5 text-danger me-2"></i>
                    <div>
                        <strong class="d-block">Không thể lưu phiếu thu!</strong>
                        <span>@errorMessage</span>
                    </div>
                </div>
                <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty" aria-label="Close"></button>
            </div>
        }

        @if (duLieuThayDoiSoVoiXemTruoc)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-3" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-warning me-2"></i>
                    <div>
                        <strong class="d-block">Cảnh báo: Dữ liệu công nợ đã thay đổi!</strong>
                        <span>@canhBaoThayDoiMessage</span>
                    </div>
                </div>
                <button type="button" class="btn-close" @onclick="() => duLieuThayDoiSoVoiXemTruoc = false" aria-label="Close"></button>
            </div>
        }

        @if (editContextThanhToan != null)
        {
            <EditForm EditContext="@editContextThanhToan" OnValidSubmit="LuuThanhToanAsync" novalidate>
                <DataAnnotationsValidator />
                <div class="row g-4">
                    <div class="col-xl-5 col-lg-5">
                        <div class="app-card mb-4">
                            <div class="app-card-header header-primary">
                                <span class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-text"></i> 1. Thông tin Chứng từ Thu tiền
                                </span>
                                <span class="badge bg-white text-primary font-mono fw-bold">@maPhieuThu</span>
                            </div>
                            <div class="p-3 p-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-slate-800">
                                        Khách hàng nộp tiền <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select @(CoLoi("KhachHangId") ? "is-invalid" : "") shadow-sm" 
                                            @onchange="OnKhachHangSelected" value="@formModel.KhachHangId">
                                        <option value="0">-- Chọn khách hàng nộp tiền --</option>
                                        @foreach (var kh in danhSachKhachHang)
                                        {
                                            <option value="@kh.KhachHangId">
                                                @kh.MaKhachHang - @kh.TenKhachHang @(!kh.TrangThai ? "(Tạm khóa bán hàng)" : "")
                                            </option>
                                        }
                                    </select>
                                    <ValidationMessage For="@(() => formModel.KhachHangId)" class="text-danger small mt-1 d-block" />
                                </div>

                                @if (khachHangHienTai != null)
                                {
                                    <div class="customer-summary-card mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom border-light-subtle">
                                            <span class="text-muted small">Khách hàng:</span>
                                            <span class="fw-bold text-slate-900 small">@khachHangHienTai.TenKhachHang (@khachHangHienTai.MaKhachHang)</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted small">Hạn mức tín dụng:</span>
                                            <span class="fw-semibold text-slate-700 small font-mono">@khachHangHienTai.HanMucCongNo.ToString("N0", viCulture) đ</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pt-1 border-top border-light-subtle">
                                            <span class="text-muted small fw-semibold">Tổng nợ cần thu:</span>
                                            <span class="fw-bold font-mono @(khachHangHienTai.SoDuCongNo > 0 ? "text-danger fs-6" : "text-success")">
                                                @khachHangHienTai.SoDuCongNo.ToString("N0", viCulture) đ
                                            </span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted fst-italic mb-3 small">Vui lòng chọn khách hàng để tra cứu số nợ hiện tại.</p>
                                }

                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6">
                                        <label class="form-label fw-bold small text-slate-800">
                                            Ngày thanh toán <span class="text-danger">*</span>
                                        </label>
                                        <input type="date" class="form-control @(CoLoi("NgayThanhToan") ? "is-invalid" : "") shadow-sm" 
                                               @bind="formModel.NgayThanhToan" @bind:after="OnNgayThanhToanChanged" />
                                        <ValidationMessage For="@(() => formModel.NgayThanhToan)" class="text-danger small mt-1 d-block" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label fw-bold small text-slate-800">
                                            Phương thức <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select @(CoLoi("PhuongThuc") ? "is-invalid" : "") shadow-sm" 
                                                @bind="formModel.PhuongThuc" @bind:after="OnPhuongThucChanged">
                                            <option value="ChuyenKhoan">Chuyển khoản (VietQR)</option>
                                            <option value="TienMat">Tiền mặt</option>
                                        </select>
                                        <ValidationMessage For="@(() => formModel.PhuongThuc)" class="text-danger small mt-1 d-block" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-slate-800 mb-1">
                                        Số tiền thanh toán (VNĐ) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group shadow-sm">
                                        <input type="text" inputmode="decimal" 
                                               class="form-control amount-highlight-input text-end @(CoLoi("SoTien") ? "is-invalid" : "")" 
                                               value="@soTienInput" 
                                               @onchange="OnSoTienInputChanged" 
                                               placeholder="0" />
                                        <span class="input-group-text bg-success bg-opacity-10 text-success fw-bold font-mono">VNĐ</span>
                                    </div>
                                    <ValidationMessage For="@(() => formModel.SoTien)" class="text-danger small mt-1 d-block" />
                                </div>

                                <div class="mb-0">
                                    <label class="form-label fw-semibold small text-slate-700">Nội dung ghi chú</label>
                                    <textarea class="form-control @(CoLoi("GhiChu") ? "is-invalid" : "") shadow-sm" 
                                              rows="2" @bind="formModel.GhiChu" @bind:after="OnGhiChuChanged" 
                                              maxlength="500" placeholder="Thông tin bổ sung phiếu thu (tùy chọn)"></textarea>
                                    <ValidationMessage For="@(() => formModel.GhiChu)" class="text-danger small mt-1 d-block" />
                                </div>
                            </div>
                        </div>

                        @if (formModel.PhuongThuc == "ChuyenKhoan")
                        {
                            <div class="vietqr-card mb-4" id="card-vietqr">
                                <div class="app-card-header header-vietinbank">
                                    <span class="d-flex align-items-center gap-2">
                                        <i class="bi bi-qr-code-scan"></i> Thanh toán qua VietQR
                                    </span>
                                    <span class="badge bg-white text-primary fw-bold font-mono">
                                        @VietQrService.Settings.BankId (@VietQrService.Settings.BankBin)
                                    </span>
                                </div>
                                <div class="p-3 p-md-4">
                                    @if (vietQrDto != null && vietQrDto.HopLe)
                                    {
                                        <div class="text-center mb-3">
                                            @if (!isQrImageError)
                                            {
                                                <div class="qr-box-wrapper">
                                                    <img src="@vietQrDto.QrUrl" 
                                                         alt="Mã VietQR thanh toán" 
                                                         class="qr-image" 
                                                         @onerror="() => isQrImageError = true" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="p-3 border rounded-3 bg-light text-center">
                                                    <div class="text-danger mb-2">
                                                        <i class="bi bi-wifi-off fs-3 d-block"></i>
                                                        <span class="small fw-semibold">Không thể tải ảnh QR từ máy chủ VietQR</span>
                                                    </div>
                                                    <p class="small text-muted mb-2">Vui lòng chuyển khoản theo thông tin số tài khoản bên dưới:</p>
                                                    <button type="button" class="btn btn-outline-primary btn-sm shadow-sm" @onclick="() => isQrImageError = false">
                                                        <i class="bi bi-arrow-clockwise me-1"></i>Thử tải lại ảnh QR
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        <div class="p-3 rounded-3 bg-light border mb-3">
                                            <div class="bank-detail-item">
                                                <span class="text-muted small">Ngân hàng thụ hưởng:</span>
                                                <span class="fw-bold text-slate-900 small">@vietQrDto.BankName (@vietQrDto.BankId)</span>
                                            </div>
                                            <div class="bank-detail-item">
                                                <span class="text-muted small">Số tài khoản:</span>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fw-bold text-primary font-mono fs-6">@vietQrDto.AccountNumber</span>
                                                    <button type="button" class="copy-chip-btn shadow-sm" 
                                                            title="Sao chép số tài khoản" 
                                                            @onclick="() => SaoChepAsync(vietQrDto.AccountNumber, true)">
                                                        @if (isCopiedSoTaiKhoan)
                                                        {
                                                            <i class="bi bi-check2 text-success me-1"></i><span class="text-success">Đã chép</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-clipboard me-1"></i><span>Chép</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="bank-detail-item">
                                                <span class="text-muted small">Chủ tài khoản:</span>
                                                <span class="fw-bold text-slate-900 small">@vietQrDto.AccountName</span>
                                            </div>
                                            <div class="bank-detail-item">
                                                <span class="text-muted small">Số tiền:</span>
                                                <span class="fw-bold text-success font-mono fs-6">@vietQrDto.SoTienDinhDang</span>
                                            </div>
                                            <div class="bank-detail-item">
                                                <span class="text-muted small">Nội dung chuyển khoản:</span>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fw-bold text-slate-900 font-mono small">@vietQrDto.NoiDungChuyenKhoan</span>
                                                    <button type="button" class="copy-chip-btn shadow-sm" 
                                                            title="Sao chép nội dung chuyển khoản" 
                                                            @onclick="() => SaoChepAsync(vietQrDto.NoiDungChuyenKhoan, false)">
                                                        @if (isCopiedNoiDung)
                                                        {
                                                            <i class="bi bi-check2 text-success me-1"></i><span class="text-success">Đã chép</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-clipboard me-1"></i><span>Chép</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="confirmation-card">
                                            <div class="form-check m-0">
                                                <input class="form-check-input ms-0 me-2 mt-1" type="checkbox" id="chkXacNhanTienVao" 
                                                       checked="@daXacNhanTienVao" @onchange="OnCheckboxXacNhanChanged" />
                                                <label class="form-check-label fw-bold text-primary" for="chkXacNhanTienVao">
                                                    Tôi đã kiểm tra ứng dụng ngân hàng và xác nhận tiền đã vào tài khoản
                                                </label>
                                            </div>
                                        </div>
                                    }
                                    else if (vietQrDto != null && !vietQrDto.HopLe)
                                    {
                                        <div class="alert alert-danger small mb-0 rounded-3">
                                            <i class="bi bi-x-circle me-1"></i>@vietQrDto.ThongBaoLoi
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-4 text-muted fst-italic small bg-light rounded-3 border">
                                            <i class="bi bi-arrow-up-circle fs-4 d-block mb-1 text-secondary"></i>
                                            Vui lòng chọn khách hàng và nhập số tiền nộp để hiển thị mã VietQR.
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-xl-7 col-lg-7">
                        <div class="app-card mb-4">
                            <div class="app-card-header header-success">
                                <span class="d-flex align-items-center gap-2">
                                    <i class="bi bi-arrow-left-right"></i> 2. Kết quả Phân bổ Cấn trừ Nợ (FIFO)
                                </span>
                                <button type="button" class="btn btn-light btn-sm text-success fw-bold shadow-sm d-inline-flex align-items-center gap-1" 
                                        @onclick="CapNhatXemTruocAsync">
                                    <i class="bi bi-arrow-clockwise"></i> Tải lại phân bổ
                                </button>
                            </div>
                            <div class="p-3 p-md-4">
                                @if (ketQuaXemTruoc != null)
                                {
                                    <div class="row g-2 mb-3">
                                        <div class="col-sm-3 col-6">
                                            <div class="stat-widget">
                                                <div class="stat-widget-title">Tổng nợ hiện tại</div>
                                                <div class="stat-widget-value text-danger font-mono">
                                                    @tongCongNoXemTruoc.ToString("N0", viCulture) đ
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-3 col-6">
                                            <div class="stat-widget">
                                                <div class="stat-widget-title">Số tiền nộp</div>
                                                <div class="stat-widget-value text-success font-mono">
                                                    @formModel.SoTien.ToString("N0", viCulture) đ
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-3 col-6">
                                            <div class="stat-widget">
                                                <div class="stat-widget-title">Đã cấn trừ</div>
                                                <div class="stat-widget-value text-primary font-mono">
                                                    @ketQuaXemTruoc.TongDaPhanBo.ToString("N0", viCulture) đ
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-3 col-6">
                                            <div class="stat-widget @(ketQuaXemTruoc.TienChuaPhanBo > 0 ? "border-warning bg-warning bg-opacity-10" : "")">
                                                <div class="stat-widget-title">Chưa phân bổ (dư)</div>
                                                <div class="stat-widget-value @(ketQuaXemTruoc.TienChuaPhanBo > 0 ? "text-dark" : "text-muted") font-mono">
                                                    @ketQuaXemTruoc.TienChuaPhanBo.ToString("N0", viCulture) đ
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (ketQuaXemTruoc.TienChuaPhanBo > 0)
                                    {
                                        <div class="alert alert-warning py-2 px-3 mb-3 small rounded-3 border-0">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Tiền thu vượt tổng nợ. Phần chênh lệch <strong>@ketQuaXemTruoc.TienChuaPhanBo.ToString("N0", viCulture) đ</strong> được ghi nhận là tiền chưa phân bổ của phiếu thu.
                                        </div>
                                    }

                                    @if (ketQuaXemTruoc.SoHoaDonBiLoaiBoDoLapSauNgayThu > 0)
                                    {
                                        <div class="alert alert-info py-2 px-3 mb-3 small rounded-3 border-0">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            Có @ketQuaXemTruoc.SoHoaDonBiLoaiBoDoLapSauNgayThu hóa đơn lập sau ngày thanh toán (@formModel.NgayThanhToan.ToString("dd/MM/yyyy")), không đủ điều kiện phân bổ theo quy tắc chứng từ.
                                        </div>
                                    }

                                    <div class="table-responsive rounded-3 border">
                                        <table class="table table-hover align-middle mb-0 fifo-table" style="min-width: 650px;">
                                            <thead class="text-center small">
                                                <tr>
                                                    <th style="width: 40px;">#</th>
                                                    <th>Mã hóa đơn</th>
                                                    <th style="width: 105px;">Ngày lập</th>
                                                    <th style="width: 125px;" class="text-end">Nợ ban đầu</th>
                                                    <th style="width: 135px;" class="text-end">Tiền cấn trừ</th>
                                                    <th style="width: 125px;" class="text-end">Nợ còn lại</th>
                                                    <th style="width: 140px;" class="text-center">Trạng thái sau thu</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (!ketQuaXemTruoc.DanhSachPhanBo.Any())
                                                {
                                                    <tr>
                                                        <td colspan="7" class="text-center py-5 text-muted fst-italic">
                                                            <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                                                            @(tongCongNoXemTruoc == 0 ? "Khách hàng hiện không còn hóa đơn nào còn nợ." : "Không có hóa đơn nào đủ điều kiện cấn trừ.")
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @for (int i = 0; i < ketQuaXemTruoc.DanhSachPhanBo.Count; i++)
                                                    {
                                                        var item = ketQuaXemTruoc.DanhSachPhanBo[i];
                                                        <tr>
                                                            <td class="text-center text-muted small">@(i + 1)</td>
                                                            <td class="fw-bold text-primary font-mono">@item.MaHoaDon</td>
                                                            <td class="text-center small text-muted font-mono">@item.NgayLap.ToString("dd/MM/yyyy")</td>
                                                            <td class="text-end text-muted font-mono">@item.SoNoTruocPhanBo.ToString("N0", viCulture) đ</td>
                                                            <td class="text-end fw-bold text-success font-mono">@item.SoTienPhanBo.ToString("N0", viCulture) đ</td>
                                                            <td class="text-end fw-semibold font-mono @(item.SoNoSauPhanBo > 0 ? "text-danger" : "text-muted")">
                                                                @item.SoNoSauPhanBo.ToString("N0", viCulture) đ
                                                            </td>
                                                            <td class="text-center">
                                                                @if (item.DaThanhToanXong)
                                                                {
                                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                                                        <i class="bi bi-check-circle me-1"></i>Hết nợ
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">
                                                                        <i class="bi bi-pie-chart me-1"></i>1 phần
                                                                    </span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                            <tfoot class="table-light fw-bold">
                                                <tr>
                                                    <td colspan="4" class="text-end text-slate-700">TỔNG CỘNG ĐÃ PHÂN BỔ:</td>
                                                    <td class="text-end text-success font-mono fs-6">@ketQuaXemTruoc.TongDaPhanBo.ToString("N0", viCulture) đ</td>
                                                    <td colspan="2"></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5 text-muted fst-italic bg-light rounded-3 border">
                                        <i class="bi bi-card-checklist fs-2 text-secondary d-block mb-2"></i>
                                        Vui lòng chọn khách hàng và nhập số tiền nộp để xem trước phân bổ cấn trừ theo hóa đơn.
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="action-bar-container d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                @if (formModel.PhuongThuc == "ChuyenKhoan" && (!daXacNhanTienVao || vietQrDto == null || !vietQrDto.HopLe))
                                {
                                    <span class="small text-warning d-flex align-items-center gap-1">
                                        <i class="bi bi-exclamation-circle-fill"></i>
                                        @(!daXacNhanTienVao ? "Vui lòng xác nhận tiền đã vào tài khoản trước khi lưu." : "Cần mã VietQR hợp lệ để lưu.")
                                    </span>
                                }
                                else if (ketQuaXemTruoc == null)
                                {
                                    <span class="small text-muted d-flex align-items-center gap-1">
                                        <i class="bi bi-info-circle"></i>
                                        Vui lòng chọn khách hàng và số tiền để xem trước phân bổ.
                                    </span>
                                }
                                else
                                {
                                    <span class="small text-success d-flex align-items-center gap-1">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Chứng từ và phân bổ công nợ đã sẵn sàng để ghi sổ.
                                    </span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a href="/thanh-toan" class="btn btn-outline-secondary px-3 shadow-sm">
                                    Hủy bỏ
                                </a>
                                <button type="submit" class="btn btn-success px-4 py-2 fw-bold shadow d-inline-flex align-items-center gap-2" 
                                        disabled="@KiemTraVoHieuHoaNutLuu()" 
                                        id="btn-luu-thanh-toan">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Đang ghi sổ...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check2-circle fs-5"></i>
                                        <span>Xác nhận & Lưu phiếu thu</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
    }
</div>

@code {
    public class FormTaoThanhToanModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Vui lòng chọn khách hàng nộp tiền.")]
        public int KhachHangId { get; set; } = 0;

        [Required(ErrorMessage = "Ngày thanh toán là bắt buộc.")]
        public DateTime NgayThanhToan { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "Vui lòng chọn phương thức thanh toán.")]
        [StringLength(50, ErrorMessage = "Phương thức tối đa 50 ký tự.")]
        public string PhuongThuc { get; set; } = "ChuyenKhoan";

        [SoTienThanhToan]
        public decimal SoTien { get; set; } = 0;

        public string? LoiDinhDangSoTien { get; set; }

        [StringLength(500, ErrorMessage = "Ghi chú tối đa 500 ký tự.")]
        public string? GhiChu { get; set; }
    }

    private FormTaoThanhToanModel formModel = new();
    private EditContext? editContextThanhToan;
    private ValidationMessageStore? messageStoreThanhToan;
    private string soTienInput = string.Empty;

    private List<KhachHang> danhSachKhachHang = new();
    private KhachHang? khachHangHienTai;

    private string maPhieuThu = string.Empty;

    private bool isLoadingData = true;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private bool duLieuThayDoiSoVoiXemTruoc = false;
    private string canhBaoThayDoiMessage = string.Empty;

    private decimal tongCongNoXemTruoc = 0;
    private KetQuaPhanBoFifo? ketQuaXemTruoc;
    private readonly CultureInfo viCulture = new CultureInfo("vi-VN");

    private bool daXacNhanTienVao = false;
    private VietQrThanhToanDto? vietQrDto;
    private bool isQrImageError = false;
    private bool isCopiedSoTaiKhoan = false;
    private bool isCopiedNoiDung = false;

    protected override async Task OnInitializedAsync()
    {
        KhoiTaoEditContext();
        await LoadDataAsync();
    }

    private EventHandler<FieldChangedEventArgs>? thanhToanFieldChangedHandler;

    private void KhoiTaoEditContext()
    {
        if (editContextThanhToan != null && thanhToanFieldChangedHandler != null)
        {
            editContextThanhToan.OnFieldChanged -= thanhToanFieldChangedHandler;
        }

        editContextThanhToan = new EditContext(formModel);
        messageStoreThanhToan = new ValidationMessageStore(editContextThanhToan);

        thanhToanFieldChangedHandler = (sender, args) =>
        {
            messageStoreThanhToan?.Clear(args.FieldIdentifier);
            if (args.FieldIdentifier.FieldName == nameof(FormTaoThanhToanModel.KhachHangId))
            {
                errorMessage = string.Empty;
            }
            editContextThanhToan?.NotifyValidationStateChanged();
        };

        editContextThanhToan.OnFieldChanged += thanhToanFieldChangedHandler;
    }

    private bool CoLoi(string fieldName)
    {
        if (editContextThanhToan == null) return false;
        var fieldIdentifier = editContextThanhToan.Field(fieldName);
        return editContextThanhToan.GetValidationMessages(fieldIdentifier).Any();
    }

    private async Task LoadDataAsync()
    {
        isLoadingData = true;
        errorMessage = string.Empty;

        try
        {
            danhSachKhachHang = (await XemDanhSachKhachHangUseCase.ExecuteAsync()).ToList();

            try
            {
                maPhieuThu = await TaoThanhToanUseCase.LayMaPhieuThuTiepTheoAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Không thể lấy mã phiếu thu tiếp theo");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải danh sách khách hàng. Vui lòng thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra trong TaoThanhToanPage.LoadDataAsync()");
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task OnKhachHangSelected(ChangeEventArgs e)
    {
        daXacNhanTienVao = false;
        vietQrDto = null;
        isQrImageError = false;
        ketQuaXemTruoc = null;

        if (int.TryParse(e.Value?.ToString(), out int id) && id > 0)
        {
            formModel.KhachHangId = id;
            khachHangHienTai = danhSachKhachHang.FirstOrDefault(k => k.KhachHangId == id);
            editContextThanhToan?.NotifyFieldChanged(new FieldIdentifier(formModel, nameof(formModel.KhachHangId)));
            await CapNhatXemTruocAsync();
        }
        else
        {
            formModel.KhachHangId = 0;
            khachHangHienTai = null;
            tongCongNoXemTruoc = 0;
            editContextThanhToan?.NotifyFieldChanged(new FieldIdentifier(formModel, nameof(formModel.KhachHangId)));
        }
    }

    private async Task CapNhatXemTruocAsync()
    {
        if (formModel.KhachHangId <= 0 || formModel.SoTien <= 0)
        {
            ketQuaXemTruoc = null;
            vietQrDto = null;
            return;
        }

        try
        {
            var res = await XemTruocPhanBoFifoUseCase.ExecuteAsync(new XemTruocPhanBoRequest
            {
                KhachHangId = formModel.KhachHangId,
                NgayThanhToan = formModel.NgayThanhToan,
                SoTien = formModel.SoTien
            });

            if (res.ThanhCong)
            {
                tongCongNoXemTruoc = res.TongCongNoHienTai;
                ketQuaXemTruoc = res.KetQuaFifo;
                CapNhatVietQr();
            }
            else
            {
                errorMessage = res.ThongBao;
                ketQuaXemTruoc = null;
                vietQrDto = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi xảy ra khi gọi XemTruocPhanBoFifoUseCase");
        }
    }

    private void CapNhatVietQr()
    {
        if (formModel.PhuongThuc == "ChuyenKhoan" 
            && formModel.KhachHangId > 0 
            && formModel.SoTien > 0 
            && khachHangHienTai != null 
            && ketQuaXemTruoc != null)
        {
            isQrImageError = false;
            vietQrDto = VietQrService.TaoVietQr(maPhieuThu, khachHangHienTai.MaKhachHang, formModel.SoTien);
        }
        else
        {
            vietQrDto = null;
        }
    }

    private void OnCheckboxXacNhanChanged(ChangeEventArgs e)
    {
        daXacNhanTienVao = e.Value is bool b && b;
    }

    private async Task SaoChepAsync(string text, bool laSoTaiKhoan)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            if (laSoTaiKhoan)
            {
                isCopiedSoTaiKhoan = true;
                StateHasChanged();
                await Task.Delay(2000);
                isCopiedSoTaiKhoan = false;
            }
            else
            {
                isCopiedNoiDung = true;
                StateHasChanged();
                await Task.Delay(2000);
                isCopiedNoiDung = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Không thể sao chép văn bản vào clipboard: {Text}", text);
        }
    }

    private bool KiemTraVoHieuHoaNutLuu()
    {
        if (isSubmitting || formModel.KhachHangId <= 0 || formModel.SoTien <= 0 || ketQuaXemTruoc == null)
        {
            return true;
        }

        if (formModel.PhuongThuc == "ChuyenKhoan")
        {
            return !daXacNhanTienVao || vietQrDto == null || !vietQrDto.HopLe;
        }

        return false;
    }

    private async Task LuuThanhToanAsync()
    {
        if (isSubmitting) return;

        errorMessage = string.Empty;
        duLieuThayDoiSoVoiXemTruoc = false;
        canhBaoThayDoiMessage = string.Empty;
        messageStoreThanhToan?.Clear();
        editContextThanhToan?.NotifyValidationStateChanged();

        if (decimal.Round(formModel.SoTien, 2) != formModel.SoTien)
        {
            messageStoreThanhToan?.Add(new FieldIdentifier(formModel, nameof(formModel.SoTien)), "Số tiền thanh toán chỉ được phép có tối đa 2 chữ số thập phân.");
            editContextThanhToan?.NotifyValidationStateChanged();
            return;
        }

        if (formModel.PhuongThuc == "ChuyenKhoan")
        {
            if (!daXacNhanTienVao)
            {
                errorMessage = "Kế toán phải kiểm tra tiền đã vào tài khoản và tích chọn xác nhận trước khi lưu phiếu thu chuyển khoản.";
                return;
            }

            if (vietQrDto == null || !vietQrDto.HopLe)
            {
                errorMessage = vietQrDto?.ThongBaoLoi ?? "Thông tin mã VietQR chuyển khoản chưa hợp lệ. Vui lòng kiểm tra lại.";
                return;
            }
        }

        isSubmitting = true;

        try
        {
            var request = new TaoThanhToanRequest
            {
                KhachHangId = formModel.KhachHangId,
                MaPhieuThu = maPhieuThu?.Trim() ?? string.Empty,
                NgayThanhToan = formModel.NgayThanhToan,
                SoTien = formModel.SoTien,
                PhuongThuc = formModel.PhuongThuc,
                GhiChu = formModel.GhiChu,
                DaXacNhanTienVao = formModel.PhuongThuc == "ChuyenKhoan" && daXacNhanTienVao,
                DanhSachXemTruoc = ketQuaXemTruoc?.DanhSachPhanBo
                    .Select(p => new ChiTietXemTruocDto
                    {
                        HoaDonId = p.HoaDonId,
                        SoTienPhanBo = p.SoTienPhanBo
                    })
                    .ToList()
            };

            var result = await TaoThanhToanUseCase.ExecuteAsync(request);

            if (result.ThanhCong)
            {
                NavigationManager.NavigateTo("/thanh-toan");
            }
            else if (result.DuLieuThayDoiSoVoiXemTruoc)
            {
                duLieuThayDoiSoVoiXemTruoc = true;
                canhBaoThayDoiMessage = result.ThongBao;
                await CapNhatXemTruocAsync();
            }
            else
            {
                if (!string.IsNullOrEmpty(result.ThongBao))
                {
                    if (result.ThongBao.Contains("khách hàng", StringComparison.OrdinalIgnoreCase))
                    {
                        messageStoreThanhToan?.Add(new FieldIdentifier(formModel, nameof(formModel.KhachHangId)), result.ThongBao);
                        editContextThanhToan?.NotifyValidationStateChanged();
                    }
                    else if (result.ThongBao.Contains("tiền", StringComparison.OrdinalIgnoreCase))
                    {
                        messageStoreThanhToan?.Add(new FieldIdentifier(formModel, nameof(formModel.SoTien)), result.ThongBao);
                        editContextThanhToan?.NotifyValidationStateChanged();
                    }
                    else if (result.ThongBao.Contains("phương thức", StringComparison.OrdinalIgnoreCase))
                    {
                        messageStoreThanhToan?.Add(new FieldIdentifier(formModel, nameof(formModel.PhuongThuc)), result.ThongBao);
                        editContextThanhToan?.NotifyValidationStateChanged();
                    }
                    else if (result.ThongBao.Contains("ngày", StringComparison.OrdinalIgnoreCase))
                    {
                        messageStoreThanhToan?.Add(new FieldIdentifier(formModel, nameof(formModel.NgayThanhToan)), result.ThongBao);
                        editContextThanhToan?.NotifyValidationStateChanged();
                    }
                    else if (result.ThongBao.Contains("ghi chú", StringComparison.OrdinalIgnoreCase))
                    {
                        messageStoreThanhToan?.Add(new FieldIdentifier(formModel, nameof(formModel.GhiChu)), result.ThongBao);
                        editContextThanhToan?.NotifyValidationStateChanged();
                    }
                    else
                    {
                        errorMessage = result.ThongBao;
                    }
                }
            }
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            Logger.LogWarning(ex, "Lỗi nghiệp vụ/cấu hình khi lưu phiếu thu {MaPhieuThu}: {Message}", maPhieuThu, ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = "Đã xảy ra lỗi hệ thống khi lưu phiếu thu. Vui lòng liên hệ quản trị viên hoặc thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra trong TaoThanhToanPage.LuuThanhToanAsync() cho phiếu {MaPhieuThu}", maPhieuThu);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OnNgayThanhToanChanged()
    {
        daXacNhanTienVao = false;
        vietQrDto = null;
        ketQuaXemTruoc = null;

        editContextThanhToan?.NotifyFieldChanged(new FieldIdentifier(formModel, nameof(formModel.NgayThanhToan)));
        await CapNhatXemTruocAsync();
    }

    private void OnPhuongThucChanged()
    {
        editContextThanhToan?.NotifyFieldChanged(new FieldIdentifier(formModel, nameof(formModel.PhuongThuc)));

        ketQuaXemTruoc = null;
        daXacNhanTienVao = false;
        vietQrDto = null;
        isQrImageError = false;

        if (formModel.PhuongThuc == "ChuyenKhoan")
        {
            if (formModel.KhachHangId > 0 && formModel.SoTien > 0)
            {
                _ = CapNhatXemTruocAsync();
            }
        }
    }

    public static (decimal SoTien, string? Loi) KiemTraSoTienThanhToan(string? rawVal)
    {
        var raw = rawVal?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return (0m, "Số tiền thanh toán phải lớn hơn 0.");
        }

        var normalized = raw.Replace(',', '.');
        if (!decimal.TryParse(normalized, NumberStyles.Float, CultureInfo.InvariantCulture, out var val))
        {
            return (0m, "Số tiền thanh toán không hợp lệ.");
        }

        if (val <= 0)
        {
            return (val, "Số tiền thanh toán phải lớn hơn 0.");
        }

        if (decimal.Round(val, 2) != val)
        {
            return (val, "Số tiền thanh toán chỉ được phép có tối đa 2 chữ số thập phân.");
        }

        return (val, null);
    }

    private async Task OnSoTienInputChanged(ChangeEventArgs e)
    {
        daXacNhanTienVao = false;
        vietQrDto = null;
        isQrImageError = false;
        ketQuaXemTruoc = null;

        var raw = e.Value?.ToString()?.Trim() ?? string.Empty;
        soTienInput = raw;

        var fieldId = new FieldIdentifier(formModel, nameof(formModel.SoTien));
        messageStoreThanhToan?.Clear(fieldId);

        var ketQua = KiemTraSoTienThanhToan(raw);
        formModel.SoTien = ketQua.SoTien;
        formModel.LoiDinhDangSoTien = ketQua.Loi == "Số tiền thanh toán không hợp lệ." ? ketQua.Loi : null;

        editContextThanhToan?.NotifyFieldChanged(fieldId);

        await CapNhatXemTruocAsync();
    }

    private void OnGhiChuChanged()
    {
        editContextThanhToan?.NotifyFieldChanged(new FieldIdentifier(formModel, nameof(formModel.GhiChu)));
    }

    [AttributeUsage(AttributeTargets.Property | AttributeTargets.Field, AllowMultiple = false)]
    public class SoTienThanhToanAttribute : ValidationAttribute
    {
        protected override ValidationResult? IsValid(object? value, ValidationContext validationContext)
        {
            var memberNames = !string.IsNullOrEmpty(validationContext?.MemberName) 
                ? new[] { validationContext.MemberName } 
                : new[] { "SoTien" };

            if (validationContext?.ObjectInstance is FormTaoThanhToanModel model && !string.IsNullOrEmpty(model.LoiDinhDangSoTien))
            {
                return new ValidationResult(model.LoiDinhDangSoTien, memberNames);
            }

            if (value is decimal val)
            {
                if (val <= 0)
                {
                    return new ValidationResult("Số tiền thanh toán phải lớn hơn 0.", memberNames);
                }
                if (decimal.Round(val, 2) != val)
                {
                    return new ValidationResult("Số tiền thanh toán chỉ được phép có tối đa 2 chữ số thập phân.", memberNames);
                }
            }
            return ValidationResult.Success;
        }
    }

    public void Dispose()
    {
        if (editContextThanhToan != null && thanhToanFieldChangedHandler != null)
        {
            editContextThanhToan.OnFieldChanged -= thanhToanFieldChangedHandler;
            thanhToanFieldChangedHandler = null;
        }
    }
}
