@page "/thanh-toan"
@attribute [Authorize(Roles = VaiTroConstants.KeToanCongNo)]
@using System.Globalization
@using BanHang.CoreBusiness
@using BanHang.UseCases.ThanhToanScreen
@using Microsoft.Extensions.Logging
@inject IXemDanhSachThanhToanUseCase XemDanhSachThanhToanUseCase
@inject ILogger<ThanhToanPage> Logger

<PageTitle>Danh sách phiếu thu tiền</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1 text-primary fw-bold">Quản lý Phiếu Thu & Cấn Trừ Công Nợ</h3>
        <p class="text-muted mb-0 small">Theo dõi lịch sử thu tiền của khách hàng và phân bổ cấn trừ theo hóa đơn (FIFO).</p>
    </div>
    <a href="/thanh-toan/tao" class="btn btn-success text-nowrap" id="btn-tao-phieu-thu">
        + Lập phiếu thu tiền
    </a>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border text-success me-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span>Đang tải danh sách phiếu thu từ SQL Server...</span>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <div>
            <h5 class="alert-heading">Đã xảy ra lỗi!</h5>
            <p class="mb-0">@errorMessage</p>
        </div>
    </div>
}
else if (danhSachThanhToan == null || !danhSachThanhToan.Any())
{
    <div class="alert alert-info" role="alert">
        Chưa có phiếu thu nào trong hệ thống.
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle border mb-0" style="min-width: 1050px;">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width: 130px;" class="text-nowrap">Mã phiếu</th>
                    <th scope="col" style="min-width: 240px;">Khách hàng</th>
                    <th scope="col" style="width: 120px;" class="text-center text-nowrap">Ngày thu</th>
                    <th scope="col" style="width: 140px;" class="text-center text-nowrap">Phương thức</th>
                    <th scope="col" class="text-end text-nowrap" style="width: 150px;">Số tiền thu</th>
                    <th scope="col" class="text-end text-nowrap" style="width: 150px;">Đã phân bổ</th>
                    <th scope="col" class="text-end text-nowrap" style="width: 150px;">Chưa phân bổ</th>
                    <th scope="col" style="min-width: 180px;">Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pt in danhSachThanhToan)
                {
                    <tr>
                        <td class="fw-bold text-success text-nowrap">@pt.MaPhieuThu</td>
                        <td>
                            <div class="fw-semibold">@pt.TenKhachHang</div>
                            <small class="text-muted text-nowrap">Mã: @pt.MaKhachHang</small>
                        </td>
                        <td class="text-center text-nowrap">@pt.NgayThanhToan.ToString("dd/MM/yyyy")</td>
                        <td class="text-center text-nowrap">
                            @if (pt.PhuongThuc == "TienMat" || pt.PhuongThuc == "Tiền mặt")
                            {
                                <span class="badge bg-secondary text-nowrap">Tiền mặt</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark text-nowrap">Chuyển khoản</span>
                            }
                        </td>
                        <td class="text-end fw-bold text-success text-nowrap">
                            @pt.SoTien.ToString("N0", viCulture) đ
                        </td>
                        <td class="text-end fw-semibold text-primary text-nowrap">
                            @pt.TongDaPhanBo.ToString("N0", viCulture) đ
                        </td>
                        <td class="text-end fw-semibold text-nowrap @(pt.TienChuaPhanBo > 0 ? "text-warning" : "text-muted")">
                            @pt.TienChuaPhanBo.ToString("N0", viCulture) đ
                        </td>
                        <td class="text-muted small">@pt.GhiChu</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold text-nowrap">
                <tr>
                    <td colspan="4" class="text-end text-nowrap">TỔNG CỘNG (@danhSachThanhToan.Count() phiếu):</td>
                    <td class="text-end text-success text-nowrap">@danhSachThanhToan.Sum(t => t.SoTien).ToString("N0", viCulture) đ</td>
                    <td class="text-end text-primary text-nowrap">@danhSachThanhToan.Sum(t => t.TongDaPhanBo).ToString("N0", viCulture) đ</td>
                    <td class="text-end text-warning text-nowrap">@danhSachThanhToan.Sum(t => t.TienChuaPhanBo).ToString("N0", viCulture) đ</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    private IEnumerable<ThanhToanListItemDto>? danhSachThanhToan;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private readonly CultureInfo viCulture = new CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSachThanhToanAsync();
    }

    private async Task TaiDanhSachThanhToanAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            danhSachThanhToan = await XemDanhSachThanhToanUseCase.ExecuteAsync();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "Không thể tải danh sách phiếu thu. Vui lòng kiểm tra kết nối hệ thống hoặc thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra khi gọi XemDanhSachThanhToanUseCase.ExecuteAsync()");
        }
        finally
        {
            isLoading = false;
        }
    }
}
