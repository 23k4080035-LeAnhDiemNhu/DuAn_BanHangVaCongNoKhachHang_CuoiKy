@page "/hoa-don/tao"
@attribute [Authorize(Roles = VaiTroConstants.NhanVienBanHang)]
@using System.Globalization
@using BanHang.CoreBusiness
@using BanHang.UseCases.HoaDonScreen
@using BanHang.UseCases.KhachHangScreen
@using BanHang.UseCases.SanPhamScreen
@using Microsoft.Extensions.Logging
@inject IXemDanhSachKhachHangUseCase XemDanhSachKhachHangUseCase
@inject IXemDanhSachSanPhamHoatDongUseCase XemDanhSachSanPhamHoatDongUseCase
@inject ITaoHoaDonBanChiuUseCase TaoHoaDonBanChiuUseCase
@inject IHoaDonNhapStateService HoaDonNhapStateService
@inject NavigationManager NavigationManager
@inject ILogger<TaoHoaDonPage> Logger
@implements IDisposable

<PageTitle>Lập hóa đơn bán chịu mới</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1 page-title">Lập Hóa Đơn Bán Chịu</h3>
            <p class="text-muted small mb-0">
                Ghi nhận doanh số bán chịu và công nợ khách hàng (Đã thanh toán = 0, Trạng thái = Chưa thanh toán).
            </p>
        </div>
        <a href="/hoa-don" class="btn btn-outline-secondary rounded-pill px-3 py-2 text-nowrap d-inline-flex align-items-center shadow-sm">
            <span class="oi oi-arrow-left me-1" aria-hidden="true"></span> Quay lại danh sách
        </a>
    </div>

    <div class="alert alert-secondary py-2 px-3 small border-0 bg-white shadow-sm rounded-3 mb-4">
        <strong>Lưu ý nghiệp vụ:</strong> Đây là luồng lập hóa đơn bán chịu, toàn bộ giá trị hóa đơn sẽ ghi nhận vào nợ phải thu của khách hàng (chưa hỗ trợ thu tiền ngay trong luồng này). Hệ thống sẽ tự động đối soát hạn mức công nợ trước khi lưu.
    </div>

    @if (isLoadingData)
    {
        <div class="d-flex align-items-center my-4">
            <div class="spinner-border text-primary me-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span>Đang tải danh mục khách hàng, mã hóa đơn tự động và bảng giá sản phẩm...</span>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3" role="alert">
                <h6 class="alert-heading fw-bold mb-1">Không thể lưu hóa đơn!</h6>
                <div>@errorMessage</div>
                <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(thongBaoThanhCong))
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3" role="alert">
                <h6 class="alert-heading fw-bold mb-1">Lưu hóa đơn thành công!</h6>
                <div>@thongBaoThanhCong</div>
                <div class="mt-2">
                    <a href="/hoa-don" class="btn btn-sm btn-success rounded-pill px-3">Xem danh sách hóa đơn</a>
                </div>
                <button type="button" class="btn-close" @onclick="() => thongBaoThanhCong = string.Empty" aria-label="Close"></button>
            </div>
        }

        @if (giaBiThayDoi)
        {
            <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-3" role="alert">
                <h6 class="alert-heading fw-bold mb-1">Cảnh báo chênh lệch đơn giá!</h6>
                <div>@canhBaoGiaMessage</div>
                <button type="button" class="btn-close" @onclick="() => giaBiThayDoi = false" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Cột trái: Thông tin hóa đơn & Khách hàng -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                    <div class="card-header card-header-enterprise">
                        <span class="fw-semibold">1. Thông tin Khách hàng & Hạn mức</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Chọn khách hàng <span class="text-danger">*</span></label>
                            <select class="form-select rounded-3" @onchange="OnKhachHangSelected" value="@selectedKhachHangId">
                                <option value="0">-- Chọn khách hàng nhận nợ --</option>
                                @foreach (var kh in danhSachKhachHang)
                                {
                                    <option value="@kh.KhachHangId">@kh.TenKhachHang</option>
                                }
                            </select>
                        </div>

                        @if (khachHangHienTai != null)
                        {
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Mã khách hàng:</span>
                                    <span class="fw-semibold text-dark">@khachHangHienTai.MaKhachHang</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Hạn mức tín dụng:</span>
                                    <span class="fw-bold text-primary">@khachHangHienTai.HanMucCongNo.ToString("N0", viCulture) đ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Công nợ hiện tại:</span>
                                    <span class="fw-bold @(khachHangHienTai.SoDuCongNo > 0 ? "text-danger" : "text-success")">
                                        @khachHangHienTai.SoDuCongNo.ToString("N0", viCulture) đ
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between pt-2 border-top">
                                    <span class="text-muted">Hạn mức còn lại:</span>
                                    <span class="fw-bold @(khachHangHienTai.ConDuocMuaNo > 0 ? "text-success" : "text-danger")">
                                        @khachHangHienTai.ConDuocMuaNo.ToString("N0", viCulture) đ
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-0 small">Vui lòng chọn khách hàng để tra cứu hạn mức tín dụng và số dư nợ hiện tại.</p>
                        }
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                    <div class="card-header card-header-enterprise">
                        <span class="fw-semibold">2. Thông tin Chứng từ</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Mã hóa đơn</label>
                            <input type="text" class="form-control bg-light rounded-3 fw-bold text-primary" value="@maHoaDon" readonly />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Ngày lập <span class="text-danger">*</span></label>
                                <input type="date" class="form-control rounded-3" @bind="ngayLap" @bind:after="DongBoVaoDraft" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Hạn thanh toán <span class="text-danger">*</span></label>
                                <input type="date" class="form-control rounded-3" @bind="hanThanhToan" min="@ngayLap.ToString("yyyy-MM-dd")" @bind:after="DongBoVaoDraft" />
                                @if (!hanThanhToan.HasValue)
                                {
                                    <small class="text-danger fst-italic">Vui lòng chọn hạn thanh toán</small>
                                }
                            </div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-semibold text-dark">Ghi chú</label>
                            <textarea class="form-control rounded-3" rows="2" @bind="ghiChu" @bind:after="DongBoVaoDraft" maxlength="500" placeholder="Ghi chú điều khoản mua nợ (tùy chọn)"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Chi tiết dòng hàng & Đối soát hạn mức -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                    <div class="card-header card-header-enterprise d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">3. Chi tiết Hàng hóa Xuất bán</span>
                        <button type="button" class="btn btn-light btn-sm rounded-pill text-primary fw-semibold px-3 shadow-sm" @onclick="ThemDongSanPham">
                            <span class="oi oi-plus me-1" aria-hidden="true"></span> Thêm sản phẩm
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive table-responsive-product">
                            <table class="table table-hover align-middle mb-0" style="min-width: 680px;">
                                <thead class="table-light">
                                    <tr class="text-secondary small fw-bold">
                                        <th style="width: 40px;" class="text-center text-nowrap">#</th>
                                        <th style="min-width: 250px;">Sản phẩm</th>
                                        <th style="width: 70px;" class="text-center text-nowrap">ĐVT</th>
                                        <th style="width: 130px;" class="text-end text-nowrap">Đơn giá niêm yết</th>
                                        <th style="width: 90px;" class="text-center text-nowrap">Số lượng</th>
                                        <th style="width: 140px;" class="text-end text-nowrap">Thành tiền</th>
                                        <th style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!danhSachChiTiet.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted fst-italic">
                                                Chưa có dòng sản phẩm nào. Bấm nút <strong>"+ Thêm sản phẩm"</strong> để chọn hàng.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < danhSachChiTiet.Count; i++)
                                        {
                                            var index = i;
                                            var item = danhSachChiTiet[index];
                                            <tr>
                                                <td class="text-center text-muted">@(index + 1)</td>
                                                <td>
                                                    <div class="product-selector position-relative" @onkeydown="(e) => OnDropdownKeyDown(index, e)">
                                                        <button type="button" 
                                                                class="product-select-btn d-flex align-items-center justify-content-between text-start w-100" 
                                                                id="@($"btn-select-sp-{index}")"
                                                                aria-haspopup="listbox" 
                                                                aria-expanded="@item.DropdownOpen"
                                                                @onclick="() => ToggleDropdown(index)">
                                                            <div class="d-flex align-items-center text-truncate me-2">
                                                                @if (item.SanPhamId > 0)
                                                                {
                                                                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                                                                    {
                                                                        <img src="@item.HinhAnh" alt="@item.TenSanPham" class="product-thumb me-2" 
                                                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
                                                                        <span class="product-thumb-fallback me-2" style="display:none;">📦</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="product-thumb-fallback me-2">📦</span>
                                                                    }
                                                                    <div class="d-flex flex-column text-truncate">
                                                                        <span class="text-truncate fw-medium text-dark">@item.TenSanPham</span>
                                                                        <span class="small text-muted">Tồn: <strong class="@(item.SoLuongTon >= item.SoLuong ? "text-success" : "text-danger")">@item.SoLuongTon</strong> @item.DonViTinh</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted fst-italic small">-- Chọn sản phẩm --</span>
                                                                }
                                                            </div>
                                                            <span class="small text-muted">▾</span>
                                                        </button>

                                                        @if (item.DropdownOpen)
                                                        {
                                                            <div class="product-dropdown-menu" role="listbox">
                                                                @foreach (var sp in danhSachSanPham)
                                                                {
                                                                    <div class="product-dropdown-item d-flex align-items-center justify-content-between @(sp.SanPhamId == item.SanPhamId ? "active-item" : "")"
                                                                         role="option"
                                                                         tabindex="0"
                                                                         @onclick="() => ChonSanPham(index, sp)"
                                                                         @onkeydown="(e) => HandleItemKeyDown(index, sp, e)">
                                                                        <div class="d-flex align-items-center text-truncate me-2">
                                                                            @if (!string.IsNullOrEmpty(sp.HinhAnh))
                                                                            {
                                                                                <img src="@sp.HinhAnh" alt="@sp.TenSanPham" class="product-thumb-menu me-2" 
                                                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
                                                                                <span class="product-thumb-fallback me-2" style="display:none;">📦</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="product-thumb-fallback me-2">📦</span>
                                                                            }
                                                                            <span class="fw-medium text-truncate text-dark">@sp.TenSanPham</span>
                                                                        </div>
                                                                        <div class="text-end text-nowrap small text-muted">
                                                                            <span class="badge @(sp.SoLuongTon > 0 ? "bg-light text-secondary border" : "bg-danger-subtle text-danger border") me-1">Tồn: @sp.SoLuongTon</span>
                                                                            <span class="fw-bold text-primary">@sp.DonGia.ToString("N0", viCulture) đ</span>
                                                                            <span> / @sp.DonViTinh</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-center text-muted small">@item.DonViTinh</td>
                                                <td class="text-end text-muted small">@item.DonGiaHienThi.ToString("N0", viCulture) đ</td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm text-center rounded-3" 
                                                           min="1" max="100000" 
                                                           value="@item.SoLuong" 
                                                           @onchange="(e) => OnSoLuongChanged(index, e)" />
                                                </td>
                                                <td class="text-end fw-semibold text-primary">
                                                    @((item.SoLuong * item.DonGiaHienThi).ToString("N0", viCulture)) đ
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill py-0 px-2" 
                                                            title="Xóa dòng" 
                                                            @onclick="() => XoaDongSanPham(index)">
                                                        &times;
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="5" class="text-end fw-bold">Tổng tiền hóa đơn mới:</td>
                                        <td class="text-end fw-bold fs-6 text-primary">
                                            @TongTienHoaDonMoi.ToString("N0", viCulture) đ
                                        </td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Card đối soát hạn mức tín dụng -->
                <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                    <div class="card-header card-header-enterprise-light py-2">
                        <span class="fw-semibold">4. Đối soát Hạn mức Tín dụng Khách hàng</span>
                    </div>
                    <div class="card-body p-4">
                        @if (khachHangHienTai != null)
                        {
                            var tongNoSauKhiMua = khachHangHienTai.SoDuCongNo + TongTienHoaDonMoi;
                            var vuotHanMuc = tongNoSauKhiMua > khachHangHienTai.HanMucCongNo;

                            <div class="row g-2 text-center mb-3">
                                <div class="col-sm-4">
                                    <div class="p-2 border rounded-3 bg-light">
                                        <small class="text-muted d-block">Công nợ hiện tại</small>
                                        <span class="fw-bold text-dark">@khachHangHienTai.SoDuCongNo.ToString("N0", viCulture) đ</span>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-2 border rounded-3 bg-light">
                                        <small class="text-muted d-block">+ Hóa đơn mới</small>
                                        <span class="fw-bold text-primary">@TongTienHoaDonMoi.ToString("N0", viCulture) đ</span>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-2 border rounded-3 @(vuotHanMuc ? "bg-danger text-white" : "bg-light")">
                                        <small class="@(vuotHanMuc ? "text-white" : "text-muted") d-block">= Tổng nợ dự kiến</small>
                                        <span class="fw-bold">@tongNoSauKhiMua.ToString("N0", viCulture) đ</span>
                                    </div>
                                </div>
                            </div>

                            @if (vuotHanMuc)
                            {
                                <div class="alert alert-danger py-2 mb-0 rounded-3 d-flex align-items-center">
                                    <div>
                                        <strong>CẢNH BÁO VƯỢT HẠN MỨC:</strong>
                                        Tổng nợ dự kiến (@tongNoSauKhiMua.ToString("N0", viCulture) đ) vượt quá hạn mức được cấp (@khachHangHienTai.HanMucCongNo.ToString("N0", viCulture) đ) là <strong>@((tongNoSauKhiMua - khachHangHienTai.HanMucCongNo).ToString("N0", viCulture)) đ</strong>. Hệ thống sẽ từ chối lưu hóa đơn này.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success py-2 mb-0 rounded-3 small">
                                    Hợp lệ: Tổng nợ dự kiến nằm trong hạn mức tín dụng cho phép của khách hàng (còn dư hạn mức: @((khachHangHienTai.HanMucCongNo - tongNoSauKhiMua).ToString("N0", viCulture)) đ).
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-0 small">Vui lòng chọn khách hàng để hệ thống hiển thị phân tích hạn mức.</p>
                        }
                    </div>
                </div>

                <!-- Nút thao tác lưu -->
                <div class="d-flex flex-column align-items-end mb-4">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="HuyBo">Hủy bỏ</button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" 
                                disabled="@(isSubmitting || VuotHanMucHienTai || selectedKhachHangId <= 0 || !danhSachChiTiet.Any(c => c.SanPhamId > 0) || !hanThanhToan.HasValue)" 
                                @onclick="LuuHoaDonAsync" id="btn-luu-hoa-don">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Đang kiểm tra & lưu...</span>
                            }
                            else
                            {
                                <span>Xác nhận & Lưu hóa đơn bán chịu</span>
                            }
                        </button>
                    </div>
                    @if (VuotHanMucHienTai)
                    {
                        <div class="text-danger small mt-2 fw-semibold">
                            Nút Lưu bị vô hiệu hóa do tổng nợ dự kiến vượt quá hạn mức công nợ của khách hàng.
                        </div>
                    }
                </div>
            </div>
        </div>
    }

@code {
    private List<KhachHang> danhSachKhachHang = new();
    private List<SanPham> danhSachSanPham = new();
    private int selectedKhachHangId = 0;
    private KhachHang? khachHangHienTai;

    private string maHoaDon = string.Empty;
    private DateTime ngayLap = DateTime.Today;
    private DateTime? hanThanhToan = null;
    private string? ghiChu;

    private class DongChiTietItem
    {
        public int SanPhamId { get; set; }
        public string TenSanPham { get; set; } = string.Empty;
        public string? HinhAnh { get; set; }
        public string DonViTinh { get; set; } = "-";
        public decimal DonGiaHienThi { get; set; }
        public int SoLuongTon { get; set; } = 0;
        public int SoLuong { get; set; } = 1;
        public bool DropdownOpen { get; set; } = false;
    }

    private List<DongChiTietItem> danhSachChiTiet = new();

    private bool isLoadingData = true;
    private bool isSubmitting = false;
    private bool daLuuThanhCong = false;
    private bool daHuyBo = false;
    private string errorMessage = string.Empty;
    private string thongBaoThanhCong = string.Empty;
    private bool giaBiThayDoi = false;
    private string canhBaoGiaMessage = string.Empty;
    private readonly CultureInfo viCulture = new CultureInfo("vi-VN");

    private decimal TongTienHoaDonMoi => danhSachChiTiet.Sum(c => c.SoLuong * c.DonGiaHienThi);
    private bool VuotHanMucHienTai => khachHangHienTai != null && khachHangHienTai.KiemTraVuotHanMucKhiMua(TongTienHoaDonMoi);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoadingData = true;
        errorMessage = string.Empty;

        try
        {
            var khTask = XemDanhSachKhachHangUseCase.ExecuteAsync();
            var spTask = XemDanhSachSanPhamHoatDongUseCase.ExecuteAsync();
            var maTask = TaoHoaDonBanChiuUseCase.LayMaHoaDonTiepTheoAsync();

            await Task.WhenAll(khTask, spTask, maTask);

            // Chỉ cho chọn khách hàng và sản phẩm đang hoạt động
            danhSachKhachHang = (await khTask).Where(k => k.TrangThai).ToList();
            danhSachSanPham = (await spTask).Where(s => s.TrangThai).ToList();
            maHoaDon = await maTask;

            // Khôi phục từ trạng thái hóa đơn nháp Scoped (nếu có)
            if (HoaDonNhapStateService.CoDuLieuNhap)
            {
                var draft = HoaDonNhapStateService.LayDuLieuNhap();
                selectedKhachHangId = draft.KhachHangId;
                if (selectedKhachHangId > 0)
                {
                    // Lấy entity khách hàng mới nhất từ CSDL để tải lại số dư công nợ và hạn mức thực tế
                    khachHangHienTai = danhSachKhachHang.FirstOrDefault(k => k.KhachHangId == selectedKhachHangId);
                }

                ngayLap = draft.NgayLap;
                hanThanhToan = draft.HanThanhToan;
                ghiChu = draft.GhiChu;

                danhSachChiTiet.Clear();
                if (draft.ChiTietDongs != null && draft.ChiTietDongs.Any())
                {
                    foreach (var d in draft.ChiTietDongs)
                    {
                        var line = new DongChiTietItem
                        {
                            SanPhamId = d.SanPhamId,
                            SoLuong = d.SoLuong > 0 ? d.SoLuong : 1
                        };

                        if (d.SanPhamId > 0)
                        {
                            // Tải lại đơn giá niêm yết và số lượng tồn mới nhất từ CSDL
                            var sp = danhSachSanPham.FirstOrDefault(s => s.SanPhamId == d.SanPhamId);
                            if (sp != null)
                            {
                                line.TenSanPham = sp.TenSanPham;
                                line.HinhAnh = sp.HinhAnh;
                                line.DonViTinh = sp.DonViTinh;
                                line.DonGiaHienThi = sp.DonGia;
                                line.SoLuongTon = sp.SoLuongTon;
                            }
                        }

                        danhSachChiTiet.Add(line);
                    }
                }
            }

            // Mặc định tạo sẵn 1 dòng sản phẩm trống nếu danh sách còn trống
            if (!danhSachChiTiet.Any())
            {
                ThemDongSanPham();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Không thể tải danh mục khách hàng, sản phẩm hoặc mã hóa đơn. Vui lòng thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra trong TaoHoaDonPage.LoadDataAsync()");
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private void OnKhachHangSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedKhachHangId = id;
            khachHangHienTai = danhSachKhachHang.FirstOrDefault(k => k.KhachHangId == id);
        }
        else
        {
            selectedKhachHangId = 0;
            khachHangHienTai = null;
        }
        DongBoVaoDraft();
    }

    private void ThemDongSanPham()
    {
        danhSachChiTiet.Add(new DongChiTietItem());
        DongBoVaoDraft();
    }

    private void XoaDongSanPham(int index)
    {
        if (index >= 0 && index < danhSachChiTiet.Count)
        {
            danhSachChiTiet.RemoveAt(index);
            DongBoVaoDraft();
        }
    }

    private void ToggleDropdown(int index)
    {
        if (index >= 0 && index < danhSachChiTiet.Count)
        {
            var currentState = danhSachChiTiet[index].DropdownOpen;
            foreach (var item in danhSachChiTiet)
            {
                item.DropdownOpen = false;
            }
            danhSachChiTiet[index].DropdownOpen = !currentState;
        }
    }

    private void DongDropdown(int index)
    {
        if (index >= 0 && index < danhSachChiTiet.Count)
        {
            danhSachChiTiet[index].DropdownOpen = false;
        }
    }

    private void ChonSanPham(int index, SanPham sp)
    {
        if (index >= 0 && index < danhSachChiTiet.Count && sp != null)
        {
            var item = danhSachChiTiet[index];
            item.SanPhamId = sp.SanPhamId;
            item.TenSanPham = sp.TenSanPham;
            item.HinhAnh = sp.HinhAnh;
            item.DonViTinh = sp.DonViTinh;
            item.DonGiaHienThi = sp.DonGia;
            item.SoLuongTon = sp.SoLuongTon;
            item.DropdownOpen = false;
            DongBoVaoDraft();
        }
    }

    private void OnDropdownKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            DongDropdown(index);
        }
    }

    private void HandleItemKeyDown(int index, SanPham sp, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            ChonSanPham(index, sp);
        }
        else if (e.Key == "Escape")
        {
            DongDropdown(index);
        }
    }

    private void OnSoLuongChanged(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < danhSachChiTiet.Count && int.TryParse(e.Value?.ToString(), out int sl))
        {
            danhSachChiTiet[index].SoLuong = sl > 0 ? sl : 1;
            DongBoVaoDraft();
        }
    }

    private void DongBoVaoDraft()
    {
        if (daLuuThanhCong || daHuyBo) return;

        var dongs = danhSachChiTiet.Select(c => new DongHangNhapDto
        {
            SanPhamId = c.SanPhamId,
            SoLuong = c.SoLuong
        });

        HoaDonNhapStateService.CapNhatNhap(
            selectedKhachHangId,
            ngayLap,
            hanThanhToan,
            ghiChu,
            dongs
        );
    }

    private void HuyBo()
    {
        daHuyBo = true;
        HoaDonNhapStateService.XoaNhap();
        NavigationManager.NavigateTo("/hoa-don");
    }

    public void Dispose()
    {
        if (!daLuuThanhCong && !daHuyBo)
        {
            DongBoVaoDraft();
        }
    }

    private async Task LuuHoaDonAsync()
    {
        if (isSubmitting) return;

        errorMessage = string.Empty;
        thongBaoThanhCong = string.Empty;
        giaBiThayDoi = false;
        canhBaoGiaMessage = string.Empty;

        // Kiểm tra sơ bộ phía client
        if (selectedKhachHangId <= 0)
        {
            errorMessage = "Vui lòng chọn khách hàng.";
            return;
        }

        if (!hanThanhToan.HasValue)
        {
            errorMessage = "Vui lòng chọn hạn thanh toán cho hóa đơn.";
            return;
        }

        if (hanThanhToan.Value.Date < ngayLap.Date)
        {
            errorMessage = "Hạn thanh toán không được trước ngày lập hóa đơn.";
            return;
        }

        if (VuotHanMucHienTai)
        {
            errorMessage = "Hóa đơn vượt quá hạn mức công nợ của khách hàng. Không thể lưu.";
            return;
        }

        if (!danhSachChiTiet.Any() || danhSachChiTiet.All(c => c.SanPhamId <= 0))
        {
            errorMessage = "Vui lòng chọn ít nhất một dòng sản phẩm hợp lệ.";
            return;
        }

        isSubmitting = true;

        try
        {
            var request = new TaoHoaDonRequest
            {
                KhachHangId = selectedKhachHangId,
                MaHoaDon = maHoaDon?.Trim() ?? string.Empty,
                NgayLap = ngayLap,
                HanThanhToan = hanThanhToan.Value,
                GhiChu = ghiChu,
                ChiTietHoaDons = danhSachChiTiet
                    .Where(c => c.SanPhamId > 0)
                    .Select(c => new TaoChiTietHoaDonDto
                    {
                        SanPhamId = c.SanPhamId,
                        SoLuong = c.SoLuong,
                        DonGiaHienThi = c.DonGiaHienThi
                    })
                    .ToList()
            };

            var result = await TaoHoaDonBanChiuUseCase.ExecuteAsync(request);

            if (result.ThanhCong)
            {
                daLuuThanhCong = true;
                HoaDonNhapStateService.XoaNhap();

                // Nếu mã hóa đơn thực tế khác mã dự kiến hiển thị ban đầu (do phiên khác đã lấy mã đó),
                // thông báo rõ mã thực tế cho người dùng
                if (!string.IsNullOrEmpty(result.MaHoaDonMoi) && 
                    !string.Equals(result.MaHoaDonMoi, maHoaDon, StringComparison.OrdinalIgnoreCase))
                {
                    thongBaoThanhCong = $"Hóa đơn đã được lưu thành công với mã thực tế là {result.MaHoaDonMoi} (mã dự kiến ban đầu {maHoaDon} đã được cấp cho phiên khác).";
                    maHoaDon = result.MaHoaDonMoi;
                }
                else
                {
                    NavigationManager.NavigateTo("/hoa-don");
                }
            }
            else if (result.GiaBiThayDoi)
            {
                giaBiThayDoi = true;
                canhBaoGiaMessage = result.ThongBao;
                // Cập nhật lại danh mục sản phẩm và giá mới nhất từ máy chủ
                await LoadDataAsync();
                foreach (var line in danhSachChiTiet)
                {
                    var sp = danhSachSanPham.FirstOrDefault(s => s.SanPhamId == line.SanPhamId);
                    if (sp != null)
                    {
                        line.DonGiaHienThi = sp.DonGia;
                    }
                }
                DongBoVaoDraft();
            }
            else
            {
                errorMessage = result.ThongBao;
                try
                {
                    await LoadDataAsync();
                    foreach (var line in danhSachChiTiet)
                    {
                        var sp = danhSachSanPham.FirstOrDefault(s => s.SanPhamId == line.SanPhamId);
                        if (sp != null)
                        {
                            line.SoLuongTon = sp.SoLuongTon;
                            line.DonGiaHienThi = sp.DonGia;
                        }
                    }
                }
                catch { }
                DongBoVaoDraft();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Đã xảy ra lỗi hệ thống khi lưu hóa đơn. Vui lòng liên hệ quản trị viên hoặc thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra trong TaoHoaDonPage.LuuHoaDonAsync() cho mã hóa đơn {MaHoaDon}", maHoaDon);
            DongBoVaoDraft();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
