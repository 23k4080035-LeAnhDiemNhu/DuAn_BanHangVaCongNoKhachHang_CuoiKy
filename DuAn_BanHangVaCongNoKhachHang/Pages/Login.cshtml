@page "/login"
@model DuAn_BanHangVaCongNoKhachHang.Pages.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = "_AuthLayout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">Bán Hàng & Công Nợ</h4>
                    <small class="opacity-75">Hệ thống quản lý bán hàng & công nợ khách hàng</small>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title text-center mb-4 fw-semibold text-secondary">Đăng nhập tài khoản</h5>

                    @if (!string.IsNullOrEmpty(Model.ThongBaoLoi))
                    {
                        <div class="alert alert-danger py-2 small" role="alert">
                            @Model.ThongBaoLoi
                        </div>
                    }

                    <form method="post" action="/login">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="Input.TenDangNhap" class="form-label fw-semibold">Tên đăng nhập</label>
                            <input asp-for="Input.TenDangNhap" name="Input.TenDangNhap" id="Input_TenDangNhap" type="text" class="form-control" autocomplete="username" autofocus placeholder="VD: nvbh hoặc ktcn" required />
                            <span asp-validation-for="Input.TenDangNhap" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.MatKhau" class="form-label fw-semibold">Mật khẩu</label>
                            <input asp-for="Input.MatKhau" name="Input.MatKhau" id="Input_MatKhau" type="password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu của bạn" required />
                            <span asp-validation-for="Input.MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="Input.RememberMe" name="Input.RememberMe" id="chkRememberMe" type="checkbox" class="form-check-input" />
                            <label asp-for="Input.RememberMe" class="form-check-label text-muted small" for="chkRememberMe">
                                Duy trì đăng nhập trên thiết bị này
                            </label>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" id="btn-login" class="btn btn-primary py-2 fw-semibold">Đăng nhập</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3 text-muted small">
                    <div>Hai vai trò trong hệ thống:</div>
                    <span class="badge bg-info text-dark me-1">Nhân viên bán hàng</span>
                    <span class="badge bg-secondary">Kế toán công nợ</span>
                </div>
            </div>
        </div>
    </div>
</div>
