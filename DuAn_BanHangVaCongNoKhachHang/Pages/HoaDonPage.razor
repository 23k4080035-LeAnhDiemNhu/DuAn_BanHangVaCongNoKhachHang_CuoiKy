@page "/hoa-don"
@using System.Globalization
@using Microsoft.Extensions.Logging
@inject IXemDanhSachHoaDonUseCase XemDanhSachHoaDonUseCase
@inject ILogger<HoaDonPage> Logger

<PageTitle>Danh sách hóa đơn</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Quản lý Hóa đơn & Công nợ theo đơn hàng</h3>
    <a href="/hoa-don/tao" class="btn btn-primary" id="btn-tao-hoa-don">
        + Tạo hóa đơn bán chịu
    </a>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border text-primary me-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span>Đang tải danh sách hóa đơn từ SQL Server...</span>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <div>
            <h5 class="alert-heading">Đã xảy ra lỗi!</h5>
            <p class="mb-0">@errorMessage</p>
        </div>
    </div>
}
else if (danhSachHoaDon == null || !danhSachHoaDon.Any())
{
    <div class="alert alert-info" role="alert">
        Chưa có hóa đơn nào trong hệ thống.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle border">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width: 130px;">Mã HĐ</th>
                    <th scope="col">Khách hàng</th>
                    <th scope="col" style="width: 120px;" class="text-center">Ngày lập</th>
                    <th scope="col" style="width: 120px;" class="text-center">Hạn trả</th>
                    <th scope="col" class="text-end" style="width: 150px;">Tổng tiền</th>
                    <th scope="col" class="text-end" style="width: 150px;">Đã trả</th>
                    <th scope="col" class="text-end" style="width: 150px;">Còn lại</th>
                    <th scope="col" class="text-center" style="width: 170px;">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hd in danhSachHoaDon)
                {
                    <tr>
                        <td class="fw-bold text-primary">@hd.MaHoaDon</td>
                        <td>
                            <div class="fw-semibold">@hd.TenKhachHang</div>
                            <small class="text-muted">Mã: @hd.MaKhachHang</small>
                        </td>
                        <td class="text-center">@hd.NgayLap.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@hd.HanThanhToan.ToString("dd/MM/yyyy")</td>
                        <td class="text-end fw-semibold">@hd.TongTien.ToString("N0", viCulture) đ</td>
                        <td class="text-end text-muted">@hd.DaThanhToan.ToString("N0", viCulture) đ</td>
                        <td class="text-end fw-bold @(hd.ConLai > 0 ? "text-danger" : "text-success")">
                            @hd.ConLai.ToString("N0", viCulture) đ
                        </td>
                        <td class="text-center">
                            @switch (hd.TrangThai)
                            {
                                case TrangThaiHoaDon.DaThanhToan:
                                    <span class="badge bg-success">Đã thanh toán</span>
                                    break;
                                case TrangThaiHoaDon.ThanhToanMotPhan:
                                    <span class="badge bg-warning text-dark">Thanh toán 1 phần</span>
                                    break;
                                case TrangThaiHoaDon.ChuaThanhToan:
                                default:
                                    <span class="badge bg-secondary">Chưa thanh toán</span>
                                    break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="4" class="text-end">TỔNG CỘNG (@danhSachHoaDon.Count() hóa đơn):</td>
                    <td class="text-end">@danhSachHoaDon.Sum(h => h.TongTien).ToString("N0", viCulture) đ</td>
                    <td class="text-end">@danhSachHoaDon.Sum(h => h.DaThanhToan).ToString("N0", viCulture) đ</td>
                    <td class="text-end text-danger">@danhSachHoaDon.Sum(h => h.ConLai).ToString("N0", viCulture) đ</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    private IEnumerable<HoaDonListItemDto>? danhSachHoaDon;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private readonly CultureInfo viCulture = new CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSachHoaDonAsync();
    }

    private async Task TaiDanhSachHoaDonAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            danhSachHoaDon = await XemDanhSachHoaDonUseCase.ExecuteAsync();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "Không thể tải danh sách hóa đơn. Vui lòng kiểm tra kết nối hệ thống hoặc thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra khi gọi XemDanhSachHoaDonUseCase.ExecuteAsync()");
        }
        finally
        {
            isLoading = false;
        }
    }
}
