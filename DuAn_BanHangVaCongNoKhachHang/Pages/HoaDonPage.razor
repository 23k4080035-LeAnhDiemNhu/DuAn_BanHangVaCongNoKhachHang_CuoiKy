@page "/hoa-don"
@attribute [Authorize(Roles = $"{VaiTroConstants.NhanVienBanHang},{VaiTroConstants.KeToanCongNo}")]
@using System.Globalization
@using BanHang.CoreBusiness
@using Microsoft.Extensions.Logging
@inject IXemDanhSachHoaDonUseCase XemDanhSachHoaDonUseCase
@inject ILogger<HoaDonPage> Logger

<PageTitle>Danh sách hóa đơn</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 page-title">Quản lý Hóa đơn & Công nợ theo đơn hàng</h3>
        <p class="text-muted small mb-0">Theo dõi danh sách hóa đơn, công nợ và trạng thái thanh toán</p>
    </div>
    <AuthorizeView Roles="@VaiTroConstants.NhanVienBanHang">
        <a href="/hoa-don/tao" class="btn btn-primary rounded-pill px-3 py-2 text-nowrap fw-semibold d-inline-flex align-items-center shadow-sm" id="btn-tao-hoa-don">
            <span class="oi oi-plus me-1" aria-hidden="true"></span> Tạo hóa đơn bán chịu
        </a>
    </AuthorizeView>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center my-4">
        <div class="spinner-border text-primary me-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span>Đang tải danh sách hóa đơn từ SQL Server...</span>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <div>
            <h5 class="alert-heading">Đã xảy ra lỗi!</h5>
            <p class="mb-0">@errorMessage</p>
        </div>
    </div>
}
else if (danhSachHoaDon == null || !danhSachHoaDon.Any())
{
    <div class="alert alert-info" role="alert">
        Chưa có hóa đơn nào trong hệ thống.
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-invoice-table" style="min-width: 1000px;" id="table-hoa-don">
                <thead>
                    <tr>
                        <th scope="col" style="width: 130px;" class="text-nowrap">MÃ HĐ</th>
                        <th scope="col" style="min-width: 240px;">KHÁCH HÀNG</th>
                        <th scope="col" style="width: 120px;" class="text-center text-nowrap">NGÀY LẬP</th>
                        <th scope="col" style="width: 120px;" class="text-center text-nowrap">HẠN TRẢ</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 150px;">TỔNG TIỀN</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 150px;">ĐÃ TRẢ</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 150px;">CÒN LẠI</th>
                        <th scope="col" class="text-center text-nowrap" style="width: 170px;">TRẠNG THÁI</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hd in danhSachHoaDon)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <a href="@($"/hoa-don/{hd.HoaDonId}")" 
                                   target="_top"
                                   class="fw-bold invoice-code-link" 
                                   title="Xem chi tiết hóa đơn @hd.MaHoaDon"
                                   id="@($"lnk-hoadon-{hd.HoaDonId}")">
                                    @hd.MaHoaDon
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold customer-name">@hd.TenKhachHang</div>
                                <small class="text-muted text-nowrap">Mã: @hd.MaKhachHang</small>
                            </td>
                            <td class="text-center text-nowrap text-secondary">@hd.NgayLap.ToString("dd/MM/yyyy")</td>
                            <td class="text-center text-nowrap text-secondary">@hd.HanThanhToan.ToString("dd/MM/yyyy")</td>
                            <td class="text-end fw-semibold text-nowrap text-slate-800">@hd.TongTien.ToString("N0", viCulture) đ</td>
                            <td class="text-end text-muted text-nowrap">@hd.DaThanhToan.ToString("N0", viCulture) đ</td>
                            <td class="text-end fw-bold text-nowrap @(hd.ConLai > 0 ? "text-danger" : "text-success")">
                                @hd.ConLai.ToString("N0", viCulture) đ
                            </td>
                            <td class="text-center text-nowrap">
                                @switch (hd.TrangThai)
                                {
                                    case TrangThaiHoaDon.DaThanhToan:
                                        <span class="status-badge badge-paid text-nowrap">Đã thanh toán</span>
                                        break;
                                    case TrangThaiHoaDon.ThanhToanMotPhan:
                                        <span class="status-badge badge-partial text-nowrap">Thanh toán 1 phần</span>
                                        break;
                                    case TrangThaiHoaDon.ChuaThanhToan:
                                    default:
                                        <span class="status-badge badge-unpaid text-nowrap">Chưa thanh toán</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="fw-bold text-nowrap">
                    <tr>
                        <td colspan="4" class="text-end text-nowrap">TỔNG CỘNG (@danhSachHoaDon.Count() hóa đơn):</td>
                        <td class="text-end text-nowrap">@danhSachHoaDon.Sum(h => h.TongTien).ToString("N0", viCulture) đ</td>
                        <td class="text-end text-nowrap text-muted">@danhSachHoaDon.Sum(h => h.DaThanhToan).ToString("N0", viCulture) đ</td>
                        <td class="text-end text-danger text-nowrap">@danhSachHoaDon.Sum(h => h.ConLai).ToString("N0", viCulture) đ</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code {
    private IEnumerable<HoaDonListItemDto>? danhSachHoaDon;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private readonly CultureInfo viCulture = new CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSachHoaDonAsync();
    }

    private async Task TaiDanhSachHoaDonAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            danhSachHoaDon = await XemDanhSachHoaDonUseCase.ExecuteAsync();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "Không thể tải danh sách hóa đơn. Vui lòng kiểm tra kết nối hệ thống hoặc thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra khi gọi XemDanhSachHoaDonUseCase.ExecuteAsync()");
        }
        finally
        {
            isLoading = false;
        }
    }
}
