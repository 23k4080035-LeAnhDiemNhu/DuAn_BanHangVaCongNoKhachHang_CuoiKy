@page "/san-pham"
@attribute [Authorize(Roles = VaiTroConstants.KeToanCongNo)]
@using System.Globalization
@using System.IO
@using BanHang.CoreBusiness
@using BanHang.UseCases.Common
@using BanHang.UseCases.PluginInterfaces.Security
@using BanHang.UseCases.SanPhamScreen
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@inject IXemDanhSachSanPhamUseCase XemDanhSachSanPhamUseCase
@inject IThemSanPhamUseCase ThemSanPhamUseCase
@inject ICapNhatSanPhamUseCase CapNhatSanPhamUseCase
@inject IDoiTrangThaiSanPhamUseCase DoiTrangThaiSanPhamUseCase
@inject ICurrentUserService CurrentUserService
@inject IWebHostEnvironment Environment
@inject ILogger<SanPhamPage> Logger
@implements IDisposable

<PageTitle>Danh sách sản phẩm</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 page-title">Quản lý Sản phẩm & Đơn giá</h3>
        <p class="text-muted small mb-0">Theo dõi danh mục hàng hóa, đơn giá bán niêm yết và trạng thái kinh doanh.</p>
    </div>
    <button class="btn btn-primary rounded-pill px-3 py-2 text-nowrap fw-semibold d-inline-flex align-items-center shadow-sm" id="btn-them-san-pham" @onclick="MoModalThemSanPham">
        <span class="bi bi-plus-circle me-1"></span> + Thêm sản phẩm
    </button>
</div>

@if (!string.IsNullOrEmpty(thongBaoThanhCong))
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <strong>Thành công!</strong> @thongBaoThanhCong
        <button type="button" class="btn-close" @onclick="() => thongBaoThanhCong = null" aria-label="Close"></button>
    </div>
}

<TrangThaiDuLieu DangTai="@isLoading"
                 ThongBaoDangTai="Đang tải dữ liệu sản phẩm từ SQL Server..."
                 CoLoi="@hasError"
                 ThongBaoLoi="@errorMessage"
                 KhongCoDuLieu="@(danhSachSanPham == null || !danhSachSanPham.Any())"
                 ThongBaoTrong="Chưa có sản phẩm nào trong hệ thống."
                 OnThuLai="TaiDanhSachSanPhamAsync">
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-page-table" style="min-width: 950px;" id="table-san-pham">
                <thead>
                    <tr>
                        <th scope="col" style="width: 110px;" class="text-nowrap">MÃ SP</th>
                        <th scope="col" style="width: 80px;" class="text-center text-nowrap">HÌNH ẢNH</th>
                        <th scope="col" style="min-width: 240px;">TÊN SẢN PHẨM</th>
                        <th scope="col" style="width: 100px;" class="text-center text-nowrap">ĐVT</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 160px;">ĐƠN GIÁ</th>
                        <th scope="col" class="text-end text-nowrap" style="width: 110px;">TỒN KHO</th>
                        <th scope="col" class="text-center text-nowrap" style="width: 140px;">TRẠNG THÁI</th>
                        <th scope="col" class="text-center text-nowrap" style="width: 180px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sp in danhSachSanPham!)
                    {
                        <tr>
                            <td class="fw-bold text-primary text-nowrap">@sp.MaSanPham</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(sp.HinhAnh))
                                {
                                    <img src="@sp.HinhAnh" alt="@sp.TenSanPham" 
                                         class="product-table-thumb"
                                         onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';" />
                                    <span class="product-table-fallback" style="display: none;">📦</span>
                                }
                                else
                                {
                                    <span class="product-table-fallback">📦</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold product-name">@sp.TenSanPham</div>
                                @if (!string.IsNullOrEmpty(sp.MoTa))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 320px;">
                                        @sp.MoTa
                                    </small>
                                }
                            </td>
                            <td class="text-center text-nowrap text-secondary">@sp.DonViTinh</td>
                            <td class="text-end text-nowrap fw-bold text-slate-800">
                                @sp.DonGia.ToString("N0", viCulture) đ
                            </td>
                            <td class="text-end text-nowrap text-secondary">
                                @sp.SoLuongTon.ToString("N0", viCulture)
                            </td>
                            <td class="text-center text-nowrap">
                                <BadgeTrangThai Loai="@(sp.TrangThai ? "selling" : "stopped")" 
                                                Text="@(sp.TrangThai ? "Đang bán" : "Ngừng bán")" />
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5" 
                                            @onclick="() => MoModalSuaSanPham(sp)" title="Sửa thông tin sản phẩm">
                                        Sửa
                                    </button>
                                    @if (sp.TrangThai)
                                    {
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-0.5" 
                                                @onclick="() => MoModalXacNhanTrangThai(sp, false)" title="Tạm ngừng kinh doanh sản phẩm này">
                                            Ngừng bán
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success rounded-pill px-2.5 py-0.5" 
                                                @onclick="() => MoModalXacNhanTrangThai(sp, true)" title="Mở bán lại sản phẩm này">
                                            Mở bán
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</TrangThaiDuLieu>

<!-- Modal Thêm / Sửa Sản Phẩm -->
@if (hienThiModalForm && editContextSanPham != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <EditForm EditContext="@editContextSanPham" OnValidSubmit="LuuSanPhamAsync" novalidate class="modal-form-scrollable">
                    <DataAnnotationsValidator />
                    <div class="modal-header modal-header-enterprise text-white">
                        <h5 class="modal-title fw-bold fs-5">
                            @(isEditing ? "Cập Nhật Thông Tin Sản Phẩm" : "Thêm Sản Phẩm Mới")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="DongModalForm" disabled="@isSaving" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(formErrorMessage))
                        {
                            <div class="alert alert-danger py-2 mb-3 rounded-3" role="alert">
                                @formErrorMessage
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-nowrap text-slate-800 small mb-1">Mã sản phẩm</label>
                                <input type="text" class="form-control rounded-3 bg-light @(CoLoi("MaSanPham") ? "is-invalid" : "")"
                                       @bind="formModel.MaSanPham" readonly disabled="@isEditing" maxlength="20" placeholder="Tự động tạo (VD: SP001)" />
                                <small class="text-muted d-block mt-1">Mã được cấp tự động bởi hệ thống</small>
                                <ValidationMessage For="@(() => formModel.MaSanPham)" class="text-danger small mt-1 d-block" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-semibold text-nowrap text-slate-800 small mb-1">Tên sản phẩm <span class="text-danger">*</span></label>
                                <input type="text" class="form-control rounded-3 @(CoLoi("TenSanPham") ? "is-invalid" : "")"
                                       @bind="formModel.TenSanPham" @bind:after="() => OnSanPhamFieldChanged(nameof(formModel.TenSanPham))" maxlength="200" placeholder="VD: Màn hình LG 27 inch 4K" />
                                <ValidationMessage For="@(() => formModel.TenSanPham)" class="text-danger small mt-1 d-block" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-nowrap text-slate-800 small mb-1">Đơn vị tính <span class="text-danger">*</span></label>
                                <input type="text" class="form-control rounded-3 @(CoLoi("DonViTinh") ? "is-invalid" : "")"
                                       @bind="formModel.DonViTinh" @bind:after="() => OnSanPhamFieldChanged(nameof(formModel.DonViTinh))" maxlength="50" placeholder="VD: Cái, Hộp, Bộ" />
                                <ValidationMessage For="@(() => formModel.DonViTinh)" class="text-danger small mt-1 d-block" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-nowrap text-slate-800 small mb-1">Đơn giá (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" step="any" min="0" class="form-control rounded-3 @(CoLoi("DonGia") ? "is-invalid" : "")"
                                       @bind="formModel.DonGia" @bind:after="() => OnSanPhamFieldChanged(nameof(formModel.DonGia))" />
                                <ValidationMessage For="@(() => formModel.DonGia)" class="text-danger small mt-1 d-block" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-nowrap text-slate-800 small mb-1" for="txtSoLuongTon">Số lượng tồn kho</label>
                                <input type="number" step="any" min="0" id="txtSoLuongTon" class="form-control rounded-3 @(CoLoi("SoLuongTon") ? "is-invalid" : "")"
                                       @bind="formModel.SoLuongTon" @bind:after="() => OnSanPhamFieldChanged(nameof(formModel.SoLuongTon))" placeholder="0" />
                                <ValidationMessage For="@(() => formModel.SoLuongTon)" class="text-danger small mt-1 d-block" />
                            </div>
                            <div class="col-12 d-flex align-items-center pt-1">
                                <div class="form-check form-switch fs-6">
                                    <input class="form-check-input" type="checkbox" id="chkTrangThaiSp" @bind="formModel.TrangThai" />
                                    <label class="form-check-label fw-semibold ms-1" for="chkTrangThaiSp">
                                        @(formModel.TrangThai ? "Đang bán" : "Ngừng bán")
                                    </label>
                                </div>
                            </div>

                            <!-- Trường Hình ảnh với tải tệp từ máy và ảnh xem trước -->
                            <div class="col-12">
                                <label class="form-label fw-semibold text-slate-800 small mb-1" for="file-anh-san-pham">Hình ảnh</label>
                                <InputFile id="file-anh-san-pham" OnChange="XuLyChonTepAnhAsync" accept=".jpg,.jpeg,.png,.webp"
                                           class="@(CoLoi("HinhAnh") ? "form-control rounded-3 is-invalid" : "form-control rounded-3")" disabled="@isSaving" />
                                <small class="text-muted d-block mt-1">Chấp nhận định dạng JPEG, PNG hoặc WebP. Dung lượng tối đa 5 MB.</small>
                                <ValidationMessage For="@(() => formModel.HinhAnh)" class="text-danger small mt-1 d-block" />

                                @if (!string.IsNullOrEmpty(anhXemTruocUrl) || !string.IsNullOrEmpty(formModel.HinhAnh))
                                {
                                    <div class="mt-2 d-flex align-items-center gap-3 p-2 border rounded-3 bg-light">
                                        <img src="@(anhXemTruocUrl ?? formModel.HinhAnh)" alt="Xem trước ảnh sản phẩm"
                                             class="rounded-2 border bg-white" style="width: 64px; height: 64px; object-fit: cover;"
                                             onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';" />
                                        <span class="product-table-fallback" style="display: none; width: 64px; height: 64px; font-size: 1.5rem;">📦</span>
                                        <div class="small flex-grow-1" style="min-width: 0;">
                                            <div class="fw-semibold text-slate-800">
                                                @(pendingImageBytes != null ? "Ảnh mới chọn (sẽ lưu khi bấm Lưu)" : "Ảnh hiện tại của sản phẩm")
                                            </div>
                                            <div class="text-muted text-truncate" style="max-width: 100%;">
                                                @(pendingImageBytes != null ? $"{pendingImageOriginalName} ({Math.Round(pendingImageBytes.Length / 1024.0, 1)} KB)" : formModel.HinhAnh)
                                            </div>
                                            @if (pendingImageBytes != null)
                                            {
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0 mt-1" @onclick="HuyChonAnhMoi" disabled="@isSaving">
                                                    ✕ Bỏ ảnh mới chọn (giữ ảnh cũ)
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-slate-800 small mb-1">Mô tả sản phẩm</label>
                                <textarea class="form-control rounded-3 @(CoLoi("MoTa") ? "is-invalid" : "")"
                                          @bind="formModel.MoTa" @bind:after="() => OnSanPhamFieldChanged(nameof(formModel.MoTa))" rows="3" maxlength="500" placeholder="Nhập tóm tắt tính năng, quy cách..."></textarea>
                                <ValidationMessage For="@(() => formModel.MoTa)" class="text-danger small mt-1 d-block" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light px-4 py-3 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 fw-semibold" @onclick="DongModalForm" disabled="@isSaving">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-1.5 fw-semibold shadow-sm" id="btn-luu-san-pham" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>@(isEditing ? "Lưu thay đổi" : "Thêm mới")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal Xác Nhận Ngừng Bán / Mở Bán Lại -->
<ModalXacNhan HienThi="@(hienThiModalXacNhanTrangThai && sanPhamDoiTrangThai != null)"
              TieuDe="@(trangThaiMoiDuKien ? "Xác nhận mở bán lại sản phẩm" : "Xác nhận ngừng bán sản phẩm")"
              HeaderClass="@(trangThaiMoiDuKien ? "modal-header-success" : "modal-header-warning")"
              KieuNutXacNhan="@(trangThaiMoiDuKien ? "btn-success" : "btn-warning text-dark")"
              NutXacNhanId="btn-xac-nhan-doi-trang-thai-sp"
              TextXacNhan="@(trangThaiMoiDuKien ? "Xác nhận mở bán" : "Xác nhận ngừng bán")"
              TextHuy="Đóng"
              DangXuLy="@isSaving"
              OnXacNhan="XacNhanDoiTrangThaiAsync"
              OnHuy="() => hienThiModalXacNhanTrangThai = false">
    @if (sanPhamDoiTrangThai != null)
    {
        @if (trangThaiMoiDuKien)
        {
            <p class="mb-0 text-slate-800">
                Bạn có chắc chắn muốn mở bán lại sản phẩm <strong>@sanPhamDoiTrangThai.TenSanPham</strong> (Mã: @sanPhamDoiTrangThai.MaSanPham)?
                Sản phẩm sẽ có thể được chọn khi lập các hóa đơn bán hàng mới.
            </p>
        }
        else
        {
            <p class="mb-0 text-slate-800">
                Bạn có chắc chắn muốn ngừng bán sản phẩm <strong>@sanPhamDoiTrangThai.TenSanPham</strong> (Mã: @sanPhamDoiTrangThai.MaSanPham)?
                Hệ thống sẽ <strong>chặn không cho thêm sản phẩm này vào các hóa đơn mới</strong> (hóa đơn cũ vẫn bảo toàn).
            </p>
        }
    }
</ModalXacNhan>

@code {
    private readonly CultureInfo viCulture = CultureInfo.GetCultureInfo("vi-VN");

    private IEnumerable<SanPham>? danhSachSanPham;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private string? thongBaoThanhCong;

    // Quản lý Modal Form Thêm/Sửa
    private bool hienThiModalForm = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private string? formErrorMessage;
    private Dictionary<string, string> loiTheoTruong = new();

    private FormSanPhamModel formModel = new();
    private EditContext? editContextSanPham;
    private ValidationMessageStore? messageStoreSanPham;

    // Quản lý tệp ảnh tải lên từ máy
    private byte[]? pendingImageBytes;
    private string? pendingImageExtension;
    private string? pendingImageOriginalName;
    private string? anhXemTruocUrl;

    // Quản lý Modal Đổi Trạng Thái
    private bool hienThiModalXacNhanTrangThai = false;
    private SanPham? sanPhamDoiTrangThai;
    private bool trangThaiMoiDuKien = false;

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSachSanPhamAsync();
    }

    private EventHandler<FieldChangedEventArgs>? sanPhamFieldChangedHandler;

    private void KhoiTaoEditContextSanPham()
    {
        if (editContextSanPham != null && sanPhamFieldChangedHandler != null)
        {
            editContextSanPham.OnFieldChanged -= sanPhamFieldChangedHandler;
        }

        editContextSanPham = new EditContext(formModel);
        messageStoreSanPham = new ValidationMessageStore(editContextSanPham);

        sanPhamFieldChangedHandler = (sender, args) =>
        {
            messageStoreSanPham?.Clear(args.FieldIdentifier);
            loiTheoTruong.Remove(args.FieldIdentifier.FieldName);
            editContextSanPham?.NotifyValidationStateChanged();
        };

        editContextSanPham.OnFieldChanged += sanPhamFieldChangedHandler;
    }

    private void OnSanPhamFieldChanged(string propertyName)
    {
        if (editContextSanPham != null)
        {
            var fieldId = editContextSanPham.Field(propertyName);
            editContextSanPham.NotifyFieldChanged(fieldId);
        }
    }

    public void Dispose()
    {
        if (editContextSanPham != null && sanPhamFieldChangedHandler != null)
        {
            editContextSanPham.OnFieldChanged -= sanPhamFieldChangedHandler;
            sanPhamFieldChangedHandler = null;
        }
    }

    private async Task TaiDanhSachSanPhamAsync()
    {
        isLoading = true;
        hasError = false;
        try
        {
            danhSachSanPham = await XemDanhSachSanPhamUseCase.ExecuteAsync();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "Không thể tải danh sách sản phẩm. Vui lòng thử lại sau.";
            Logger.LogError(ex, "Lỗi xảy ra khi gọi XemDanhSachSanPhamUseCase");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetTrangThaiAnh()
    {
        pendingImageBytes = null;
        pendingImageExtension = null;
        pendingImageOriginalName = null;
        anhXemTruocUrl = null;
    }

    private void HuyChonAnhMoi()
    {
        ResetTrangThaiAnh();
        loiTheoTruong.Remove("HinhAnh");
        if (editContextSanPham != null && messageStoreSanPham != null)
        {
            messageStoreSanPham.Clear(new FieldIdentifier(formModel, "HinhAnh"));
            editContextSanPham.NotifyValidationStateChanged();
        }
    }

    private async Task MoModalThemSanPham()
    {
        isEditing = false;
        string maSpMoi = string.Empty;
        try
        {
            maSpMoi = await ThemSanPhamUseCase.LayMaSanPhamTiepTheoAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Không lấy được mã sản phẩm tiếp theo");
        }

        ResetTrangThaiAnh();
        formModel = new FormSanPhamModel
        {
            MaSanPham = maSpMoi,
            TrangThai = true,
            DonViTinh = "Cái",
            DonGia = 0,
            SoLuongTon = 0
        };
        KhoiTaoEditContextSanPham();
        formErrorMessage = null;
        loiTheoTruong.Clear();
        hienThiModalForm = true;
    }

    private void MoModalSuaSanPham(SanPham sp)
    {
        isEditing = true;
        ResetTrangThaiAnh();
        formModel = new FormSanPhamModel
        {
            SanPhamId = sp.SanPhamId,
            MaSanPham = sp.MaSanPham,
            TenSanPham = sp.TenSanPham,
            DonViTinh = sp.DonViTinh,
            DonGia = sp.DonGia,
            SoLuongTon = sp.SoLuongTon,
            MoTa = sp.MoTa,
            HinhAnh = sp.HinhAnh,
            TrangThai = sp.TrangThai
        };
        KhoiTaoEditContextSanPham();
        formErrorMessage = null;
        loiTheoTruong.Clear();
        hienThiModalForm = true;
    }

    private void DongModalForm()
    {
        if (isSaving) return;
        ResetTrangThaiAnh();
        messageStoreSanPham?.Clear();
        loiTheoTruong.Clear();
        formErrorMessage = null;
        hienThiModalForm = false;
    }

    private bool CoLoi(string tenTruong)
    {
        if (editContextSanPham == null) return false;
        return editContextSanPham.GetValidationMessages(new FieldIdentifier(formModel, tenTruong)).Any();
    }

    private async Task XuLyChonTepAnhAsync(InputFileChangeEventArgs e)
    {
        loiTheoTruong.Remove("HinhAnh");
        var file = e.File;
        if (file == null) return;

        const long maxFileSize = 5 * 1024 * 1024; // 5 MB
        if (file.Size > maxFileSize)
        {
            loiTheoTruong["HinhAnh"] = "Kích thước hình ảnh vượt quá giới hạn 5 MB.";
            ResetTrangThaiAnh();
            return;
        }

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: maxFileSize).CopyToAsync(ms);
            var bytes = ms.ToArray();

            var (isValid, ext, mimeType) = KiemTraDinhDangAnh(bytes);
            if (!isValid)
            {
                loiTheoTruong["HinhAnh"] = "Định dạng tệp không hợp lệ. Chỉ chấp nhận tệp hình ảnh JPEG, PNG hoặc WebP.";
                ResetTrangThaiAnh();
                return;
            }

            pendingImageBytes = bytes;
            pendingImageExtension = ext;
            pendingImageOriginalName = file.Name;
            anhXemTruocUrl = $"data:{mimeType};base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi đọc tệp ảnh tải lên");
            loiTheoTruong["HinhAnh"] = "Không thể đọc tệp ảnh. Vui lòng thử lại.";
            ResetTrangThaiAnh();
        }
    }

    private async Task LuuSanPhamAsync()
    {
        if (isSaving) return;

        isSaving = true;
        formErrorMessage = null;
        loiTheoTruong.Clear();
        string? newlyCreatedFilePath = null;
        var oldHinhAnh = formModel.HinhAnh;

        try
        {
            // Nếu có ảnh mới chọn từ máy, lưu tệp an toàn lên thư mục máy chủ
            if (pendingImageBytes != null && !string.IsNullOrEmpty(pendingImageExtension))
            {
                // Kiểm tra phân quyền phía máy chủ
                await AuthorizeHelper.RequireRoleAsync(CurrentUserService, VaiTroConstants.KeToanCongNo);

                var webRoot = Environment.WebRootPath ?? Path.Combine(Directory.GetCurrentDirectory(), "wwwroot");
                var uploadsFolder = Path.Combine(webRoot, "images", "sanpham");
                if (!Directory.Exists(uploadsFolder))
                {
                    Directory.CreateDirectory(uploadsFolder);
                }

                var safeFileName = $"sp_{Guid.NewGuid():N}{pendingImageExtension}";
                newlyCreatedFilePath = Path.Combine(uploadsFolder, safeFileName);
                await File.WriteAllBytesAsync(newlyCreatedFilePath, pendingImageBytes);
                formModel.HinhAnh = $"/images/sanpham/{safeFileName}";
            }

            if (!isEditing)
            {
                // Thêm mới
                var request = new TaoSanPhamRequest
                {
                    MaSanPham = formModel.MaSanPham,
                    TenSanPham = formModel.TenSanPham,
                    DonViTinh = formModel.DonViTinh,
                    DonGia = formModel.DonGia,
                    SoLuongTon = formModel.SoLuongTon,
                    MoTa = formModel.MoTa,
                    HinhAnh = formModel.HinhAnh,
                    TrangThai = formModel.TrangThai
                };

                var ketQua = await ThemSanPhamUseCase.ExecuteAsync(request);
                if (ketQua.ThanhCong)
                {
                    newlyCreatedFilePath = null; // Giữ tệp mới thành công
                    ResetTrangThaiAnh();
                    hienThiModalForm = false;
                    thongBaoThanhCong = ketQua.ThongBao;
                    await TaiDanhSachSanPhamAsync();
                }
                else
                {
                    formErrorMessage = ketQua.ThongBao;
                    loiTheoTruong = ketQua.LoiTheoTruong ?? new();
                    if (ketQua.LoiTheoTruong != null && ketQua.LoiTheoTruong.Any())
                    {
                        messageStoreSanPham?.Clear();
                        foreach (var kvp in ketQua.LoiTheoTruong)
                        {
                            messageStoreSanPham?.Add(new FieldIdentifier(formModel, kvp.Key), kvp.Value);
                        }
                        editContextSanPham?.NotifyValidationStateChanged();
                    }
                    // Lưu thất bại: dọn tệp vừa tạo để tránh rác
                    if (!string.IsNullOrEmpty(newlyCreatedFilePath) && File.Exists(newlyCreatedFilePath))
                    {
                        try { File.Delete(newlyCreatedFilePath); } catch (Exception ex) { Logger.LogWarning(ex, "Lỗi dọn tệp ảnh mới sau khi lưu thất bại"); }
                        newlyCreatedFilePath = null;
                    }
                    formModel.HinhAnh = oldHinhAnh;
                }
            }
            else
            {
                // Cập nhật
                var request = new CapNhatSanPhamRequest
                {
                    SanPhamId = formModel.SanPhamId,
                    MaSanPham = formModel.MaSanPham,
                    TenSanPham = formModel.TenSanPham,
                    DonViTinh = formModel.DonViTinh,
                    DonGia = formModel.DonGia,
                    SoLuongTon = formModel.SoLuongTon,
                    MoTa = formModel.MoTa,
                    HinhAnh = formModel.HinhAnh,
                    TrangThai = formModel.TrangThai
                };

                var ketQua = await CapNhatSanPhamUseCase.ExecuteAsync(request);
                if (ketQua.ThanhCong)
                {
                    newlyCreatedFilePath = null; // Giữ tệp mới, không xóa ảnh cũ (có thể đang được hóa đơn cũ tham chiếu)
                    ResetTrangThaiAnh();
                    hienThiModalForm = false;
                    thongBaoThanhCong = ketQua.ThongBao;
                    await TaiDanhSachSanPhamAsync();
                }
                else
                {
                    formErrorMessage = ketQua.ThongBao;
                    loiTheoTruong = ketQua.LoiTheoTruong ?? new();
                    if (ketQua.LoiTheoTruong != null && ketQua.LoiTheoTruong.Any())
                    {
                        messageStoreSanPham?.Clear();
                        foreach (var kvp in ketQua.LoiTheoTruong)
                        {
                            messageStoreSanPham?.Add(new FieldIdentifier(formModel, kvp.Key), kvp.Value);
                        }
                        editContextSanPham?.NotifyValidationStateChanged();
                    }
                    // Lưu thất bại: dọn tệp vừa tạo
                    if (!string.IsNullOrEmpty(newlyCreatedFilePath) && File.Exists(newlyCreatedFilePath))
                    {
                        try { File.Delete(newlyCreatedFilePath); } catch (Exception ex) { Logger.LogWarning(ex, "Lỗi dọn tệp ảnh mới sau khi cập nhật thất bại"); }
                        newlyCreatedFilePath = null;
                    }
                    formModel.HinhAnh = oldHinhAnh;
                }
            }
        }
        catch (Exception ex)
        {
            if (!string.IsNullOrEmpty(newlyCreatedFilePath) && File.Exists(newlyCreatedFilePath))
            {
                try { File.Delete(newlyCreatedFilePath); } catch (Exception delEx) { Logger.LogWarning(delEx, "Lỗi dọn tệp ảnh mới sau ngoại lệ"); }
            }
            formModel.HinhAnh = oldHinhAnh;
            formErrorMessage = "Đã xảy ra lỗi không mong muốn khi lưu sản phẩm.";
            Logger.LogError(ex, "Lỗi xảy ra trong quá trình lưu sản phẩm");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void MoModalXacNhanTrangThai(SanPham sp, bool trangThaiMoi)
    {
        sanPhamDoiTrangThai = sp;
        trangThaiMoiDuKien = trangThaiMoi;
        hienThiModalXacNhanTrangThai = true;
    }

    private async Task XacNhanDoiTrangThaiAsync()
    {
        if (sanPhamDoiTrangThai == null || isSaving) return;

        isSaving = true;
        try
        {
            var ketQua = await DoiTrangThaiSanPhamUseCase.ExecuteAsync(sanPhamDoiTrangThai.SanPhamId, trangThaiMoiDuKien);
            if (ketQua.ThanhCong)
            {
                hienThiModalXacNhanTrangThai = false;
                thongBaoThanhCong = ketQua.ThongBao;
                await TaiDanhSachSanPhamAsync();
            }
            else
            {
                errorMessage = ketQua.ThongBao;
                hasError = true;
                hienThiModalXacNhanTrangThai = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Đã xảy ra lỗi khi đổi trạng thái sản phẩm.";
            hasError = true;
            hienThiModalXacNhanTrangThai = false;
            Logger.LogError(ex, "Lỗi xảy ra khi đổi trạng thái sản phẩm");
        }
        finally
        {
            isSaving = false;
        }
    }

    public static (bool IsValid, string Extension, string MimeType) KiemTraDinhDangAnh(byte[]? bytes)
        => SanPhamHelper.KiemTraDinhDangAnh(bytes);

    public static decimal ChuanHoaDonGia(decimal value)
        => SanPhamHelper.ChuanHoaDonGia(value);

    public class FormSanPhamModel
    {
        public int SanPhamId { get; set; }
        public string MaSanPham { get; set; } = string.Empty;

        [Required(ErrorMessage = "Tên sản phẩm là bắt buộc.")]
        [StringLength(200, ErrorMessage = "Tên sản phẩm tối đa 200 ký tự.")]
        public string TenSanPham { get; set; } = string.Empty;

        [Required(ErrorMessage = "Đơn vị tính là bắt buộc.")]
        [StringLength(50, ErrorMessage = "Đơn vị tính tối đa 50 ký tự.")]
        public string DonViTinh { get; set; } = "Cái";

        private decimal _donGia = 0;
        [Range(0, double.MaxValue, ErrorMessage = "Đơn giá không được âm.")]
        public decimal DonGia
        {
            get => _donGia;
            set => _donGia = ChuanHoaDonGia(value);
        }

        [Range(0, 2147483647, ErrorMessage = "Số lượng tồn kho phải là số không âm.")]
        public decimal SoLuongTon { get; set; } = 0;

        [StringLength(500, ErrorMessage = "Mô tả tối đa 500 ký tự.")]
        public string? MoTa { get; set; }

        [StringLength(300, ErrorMessage = "Đường dẫn hình ảnh tối đa 300 ký tự.")]
        public string? HinhAnh { get; set; }

        public bool TrangThai { get; set; } = true;
    }
}
