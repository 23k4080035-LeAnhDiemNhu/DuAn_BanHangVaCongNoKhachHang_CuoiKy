<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <div class="container py-5 text-center">
                            <div class="card shadow-sm mx-auto" style="max-width: 500px;">
                                <div class="card-body p-4">
                                    <h4 class="text-warning mb-3">Yêu cầu đăng nhập</h4>
                                    <p class="text-muted">Bạn cần đăng nhập tài khoản để truy cập chức năng này.</p>
                                    <a href="/login" class="btn btn-primary px-4">Đăng nhập ngay</a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="container py-5 text-center">
                            <div class="card shadow-sm mx-auto border-danger" style="max-width: 500px;">
                                <div class="card-body p-4">
                                    <h4 class="text-danger mb-3">Không có quyền truy cập</h4>
                                    <p class="text-muted">Tài khoản của bạn không được phân quyền để thao tác chức năng này.</p>
                                    <a href="/" class="btn btn-outline-secondary">Quay về trang chủ</a>
                                </div>
                            </div>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang xác thực...</span>
                        </div>
                        <div class="mt-2 text-muted">Đang kiểm tra quyền truy cập...</div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Không tìm thấy trang</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="container py-5 text-center">
                    <h3 class="text-danger">404 - Không tìm thấy trang</h3>
                    <p class="text-muted">Địa chỉ yêu cầu không tồn tại trong hệ thống.</p>
                    <a href="/" class="btn btn-primary">Quay về trang chủ</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
